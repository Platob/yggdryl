/target/
/rust/target/
/site/

# Native extension build products
*.node
*.pdb
*.so
*.dylib
*.dll
.venv
.venv/
rust/.pyhint-venv/
python/dist/
python/yggdryl/*.pyd
python/yggdryl/*.so
node/npm/

# Tool caches
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
node_modules/

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# The Spark interop suite's provisioned iceberg-spark-runtime jar
python/.spark-interop/
.claude/

# Local scratch space for check and validation logs
/.scratch/

# Generated by scripts/check_docs_examples.py
rust/tests/docs_examples.rs

# Staged by scripts/stage_cli.py into the wheel's scripts directory. The
# folder itself is committed: maturin refuses a `data` directory that is not
# there.
python/wheel-data/scripts/yggdryl
python/wheel-data/scripts/yggdryl.exe

# Merge-conflict leftovers: `.orig` and `.rej` are never sources.
*.orig
*.rej

# Credentials never belong in the tree: a live AWS check reads them from the
# developer's own ~/.aws through a profile, and CI from an OIDC role.
.aws/
.env
.env.*
*.pem
*.p12
*.pfx
