{
  "name": "yggdryl",
  "version": "0.1.1",
  "description": "Native Yggdryl schemas, fields, Arrow interop, URIs, and structured codecs for Node.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Platob/yggdryl.git"
  },
  "homepage": "https://platob.github.io/yggdryl/",
  "bugs": "https://github.com/Platob/yggdryl/issues",
  "main": "binding.js",
  "types": "binding.d.ts",
  "exports": {
    ".": {
      "types": "./binding.d.ts",
      "require": "./binding.js",
      "default": "./binding.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js",
    "binding.d.ts",
    "defaults.js",
    "fields.js",
    "*.node",
    "records.js",
    "values.js",
    "benchmarks"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "apache-arrow": "^21.1.0"
  },
  "scripts": {
    "bench:codec": "node benchmarks/codec.js",
    "bench:defaults": "node benchmarks/defaults.js",
    "bench:io": "node benchmarks/io.js",
    "bench:records": "node benchmarks/records.js",
    "bench:schema": "node benchmarks/schema.js",
    "build": "napi build --platform --release && node scripts/local-binding-only.js && node scripts/hide-private-types.js",
    "build:debug": "napi build --platform && node scripts/local-binding-only.js && node scripts/hide-private-types.js",
    "prepack": "npm run typecheck",
    "test": "node --test tests/*.test.js && tsc --noEmit",
    "test:package": "npm run build && node scripts/local-binding-only.js --check && node scripts/hide-private-types.js --check && node scripts/check-package-files.js",
    "typecheck": "tsc --noEmit"
  },
  "napi": {
    "binaryName": "yggdryl",
    "triples": {
      "additional": []
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2"
  }
}
