    boundary reads - a native ``Scalar``, a mapping of names, a sequence in
    the root's own order - and ``registry`` defaults to the process one. The
    message is immutable: it hashes, pickles, copies and compares by the
    schema and the value it carries, against that registry.
    """

    def __init__(
        self,
        field: FieldLike,
        value: Scalar | Mapping[str, Any] | Sequence[Any],
        registry: FixRegistry | None = None,
    ) -> None: ...
    @staticmethod
    def _from_pickle(field: str, value: str, registry: list[str]) -> FixMsg: ...
    @property
    def registry(self) -> FixRegistry: ...
    @property
    def field(self) -> Field: ...
    @property
    def value(self) -> Scalar: ...
    @property
    def branch(self) -> str: ...
    def get_by_id(self, id: str) -> Scalar | None: ...
    def by_id(self, id: str) -> Scalar: ...
    def get_by_tag(self, tag: int) -> Scalar | None: ...
    def by_tag(self, tag: int) -> Scalar: ...
    def get_by_name(self, name: str) -> Scalar | None: ...
    def by_name(self, name: str) -> Scalar: ...
    def get_by_path(self, path: str) -> Scalar | None: ...
    def by_path(self, path: str) -> Scalar: ...
    def get(self, key: int | str, default: object = None, /) -> object: ...
    def __getitem__(self, key: int | str, /) -> Scalar: ...
    def __iter__(self) -> FixMsgIterator: ...
    def __len__(self) -> int: ...
    def stable_hash(self) -> int: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __reduce__(self) -> tuple[object, tuple[str, str, list[str]]]: ...
    def __copy__(self) -> FixMsg: ...
    def __deepcopy__(self, memo: Any) -> FixMsg: ...
    def __repr__(self) -> str: ...

def global_registry() -> FixRegistry: ...
def install_global_registry(registry: FixRegistry) -> None: ...

STANDARD_BRANCH: str
STANDARD_TAG_LIMIT: int
