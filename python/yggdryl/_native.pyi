    def temporary(cls) -> LocalFolder: ...
    @classmethod
    def home(cls) -> LocalFolder: ...
    @classmethod
    def config(cls) -> LocalFolder: ...

class LocalPath(IOBase):
    """One local location that resolves to `LocalFile` or `LocalFolder` when asked."""

    def __init__(self, location: Url | Uri | str | PathLike[str]) -> None: ...
    def as_file(self) -> LocalFile: ...
    def as_directory(self) -> LocalFolder: ...

class FsFile(IOBase):
    """One file on a bridged filesystem, read and written through its streams;
    `LocalFile` or `S3File` comes back for a filesystem this build holds natively."""

    def __init__(
        self,
        filesystem: pyarrow.fs.FileSystem,
        path: str | PathLike[str],
        *,
        uri: str | PathLike[str] | None = None,
    ) -> None: ...

