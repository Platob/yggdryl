class UlPlugin:
    """One plugin a bridge configuration document answers for.

    A Jolokia read answers one MBean's attributes or a map of them keyed by
    ObjectName, and both are the same statement made once or many times. This
    is one of those statements - the ObjectName the bridge holds the plugin
    under, beside the attributes it stated. :class:`FixMsg` is the same facts
    typed against a dictionary, and the two cross both ways.

    A ``dict`` states a document as well as parsed bytes do: a mapping crossing
    the boundary is folded into the same record at every depth, so
    ``UlPlugin({"Name": "OrderRouting"})`` and the bytes spelling it are one
    value. ``attributes`` keeps the document's own spelling; ``get`` and ``in``
    fold a name the way every other name in this crate is folded.

    Immutable: it hashes, copies and pickles like every other value here.
    """

    def __init__(self, attributes: object, mbean: str | None = None) -> None: ...
    @staticmethod
    def _from_pickle(attributes: str, mbean: str | None = None) -> UlPlugin: ...
    @staticmethod
    def from_json_bytes(body: bytes | bytearray | memoryview) -> list[UlPlugin]: ...
    @staticmethod
    def from_json_scalar(document: object) -> list[UlPlugin]: ...
    @staticmethod
    def from_fixmsg(message: FixMsg) -> list[UlPlugin]: ...
    def into_fixmsg(self, codec: FixCodec, enrich: bool = False) -> FixMsg: ...
    @property
    def mbean(self) -> str | None: ...
    @property
    def mbean_type(self) -> str | None: ...
    @property
    def plugin_type(self) -> str | None: ...
    @property
    def name(self) -> str | None: ...
    @property
    def version(self) -> str | None: ...
    @property
    def category(self) -> str | None: ...
    @property
    def state(self) -> str | None: ...
    @property
    def attributes(self) -> dict[str, Scalar]: ...
