# Anything an Iceberg write takes: every Arrow holder the record surface reads,
# a foreign frame, and the plain rows `append_records` accepts.
IcebergRows = (
    pyarrow.RecordBatchReader
    | pyarrow.Table
    | pyarrow.RecordBatch
    | ArrowStreamReader
    | Iterable[Any]
)


