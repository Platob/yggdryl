# The graph vocabulary: the typed market leaves, `MarketData` over every one
# of them, and the typed values and walks around them.

# Anything `MarketData` wraps: itself, one of its nine leaves, or a FIX
# message it holds whole.
MarketLeaf = (
    Order
    | Quote
    | Execution
    | OrderEvent
    | QuoteEvent
    | ExecutionEvent
    | TradeEvent
    | BookEvent
    | SnapshotEvent
    | FixMsg
)
MarketItem = MarketData | MarketLeaf

