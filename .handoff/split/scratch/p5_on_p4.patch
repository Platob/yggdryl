+## Land a message and split it into leaves
+
+`MarketMessage` is the one message every protocol lands in: its facts through
+the four traits, what it states beyond them as entries under one root, the
+elements it states as children. `MarketData` holds it whole (kind `message`);
+the writer and the book fold take the leaves it splits into.
+
+```rust
+use std::sync::Arc;
+
+use yggdryl::graph::{BookRef, Element, Event, Market, MarketData, MarketKind, MarketMessage, MdUpdateAction, StatedFacts};
+use yggdryl::{DataType, Decimal, MarketDataKind, Scalar, Side, StructType};
+
+// A book message on ACME stating its two levels as children.
+let mut book = MarketMessage::new(MarketDataKind::Book);
+book.set_transunix(1_700_000_000_000_000_000);
+book.set_ticker(Some("ACME".into()), true);
+book.set_book(Some(BookRef { action: Some(MdUpdateAction::Snapshot), scope: Some("Symbol=ACME".into()), ..BookRef::default() }));
+for (side, price) in [(Side::Buy, 99), (Side::Sell, 101)] {
+    let mut level = MarketMessage::new(MarketDataKind::Quotation);
+    level.set_side(side, true);
+    level.set_price(Some(Decimal::from_int(price)), true);
+    assert!(level.stated().contains(StatedFacts::SIDE.union(StatedFacts::PRICE)));
+    book.push_child(level)?;
+}
+// What it states beyond its facts: one run under one root, read by exact name.
+let root = Arc::new(DataType::from(StructType::from_fields([DataType::utf8().nullable_field("feed")])?).required_field("entries"));
+let mut book = book.try_with_entries(root, Scalar::from_sequence([Scalar::from("MDP")]))?;
+book.finalize();
+assert_eq!(book.entry("feed").and_then(|cell| cell.as_str().map(str::to_owned)).as_deref(), Some("MDP"));
+
+// Held whole, then split: one quote leaf per level, the ticker the message's.
+let value = MarketData::from(book.clone());
+assert_eq!(value.kind(), MarketKind::Message);
+assert_eq!(value.as_message(), Some(&book));
+let leaves = book.into_market_data();
+assert_eq!(leaves.len(), 2);
+assert!(leaves.iter().all(|leaf| leaf.kind() == MarketKind::QuoteEvent && leaf.get_ticker() == Some("ACME")));
+```
