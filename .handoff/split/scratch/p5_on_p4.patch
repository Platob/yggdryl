+//! `rust/src/graph/message.rs`: the one message every protocol lands in -
+//! its facts, what its source stated, its entries under one root, the
+//! elements it states as children, its anomalies and its instrument
+//! statement - the leaves it splits into, its row form, and its identity.
+
+use std::collections::hash_map::DefaultHasher;
+use std::hash::{Hash, Hasher};
+use std::sync::Arc;
+
+use smol_str::SmolStr;
+use yggdryl::graph::{
+    Anomaly, BookRef, Element, ElementColumn, Event, EventColumn, InstrumentStatement, Market,
+    MarketColumn, MarketData, MarketKind, MarketMessage, MdUpdateAction, MessageIterator,
+    Operation, OperationColumn, StatedFacts,
