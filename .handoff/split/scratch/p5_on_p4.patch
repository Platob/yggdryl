+    /// settle restates off the fields; until the next settle the message's
+    /// [`stated`](MarketMessage::stated) word holds that and the codec's
+    /// word, and no reading of a field.
+    ///
+    /// ```
+    /// # fn main() -> yggdryl::Result<()> {
+    /// # use std::sync::Arc;
+    /// # use yggdryl::local::LocalFolder;
+    /// use yggdryl::graph::Market;
+    /// use yggdryl::{FixCodec, Side};
+    /// # use yggdryl::FixRegistry;
+    /// # let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../config/fix");
+    /// # let registry = Arc::new(FixRegistry::from_handle(&LocalFolder::new(root)?)?);
+    /// let codec = FixCodec::new(registry);
+    /// let mut order = codec.parse_fix_line(b"8=FIX.4.4|35=D|11=A1|55=AAPL|54=1|10=0|")?;
+    /// order.message_mut().set_side(Side::Sell, true);
+    /// let wire = String::from_utf8(order.into_bytes(b'|')).expect("text");
+    /// assert!(wire.contains("|54=2|"), "{wire}");
+    /// # Ok(())
+    /// # }
+    /// ```
+    pub fn message_mut(&mut self) -> &mut MarketMessage {
+        if self.indexes.lent.is_none() {
+            // Lent, the message states what the codec and the caller stated
+            // and no reading of a field, so a fact the caller states is told
+            // apart from one the message read; the next settle states the
+            // readings again.
+            let instant = self.message.stated().bits() & StatedFacts::TRANSUNIX.bits();
+            let word = u64::from(self.indexes.stated) | self.indexes.row_stated | instant;
+            let stated = StatedFacts::from_bits(word).unwrap_or_default();
+            self.message.set_stated(stated);
+            let message = &self.message;
+            self.indexes.lent = Some(Box::new(Lent {
+                readings: std::array::from_fn(|at| {
+                    identity::fact_reading(message, identity::FACT_TAGS[at])
+                }),
+                stated,
+                securityids: message.get_securityids().clone(),
+            }));
+        }
+        self.indexes.entries = OnceLock::new();
+        &mut self.message
+    }
+
+    /// Runs `state` over the market message, every fact it states through
+    /// the market doors taken as the codec's word - which no settle
+    /// restates off the fields - as a fold of another statement of the
+    /// message states it: the message's stated word holds the codec's word
+    /// alone while `state` runs, so what it marks is told apart from what
+    /// the message read.
+    pub(super) fn stating<R>(&mut self, state: impl FnOnce(&mut MarketMessage) -> R) -> R {
+        let instant = self.message.stated().bits() & StatedFacts::TRANSUNIX.bits();
+        let word = u64::from(self.indexes.stated) | self.indexes.row_stated | instant;
+        let held = StatedFacts::from_bits(word).unwrap_or_default();
+        self.message.set_stated(held);
+        let answer = state(&mut self.message);
+        let marked = self
+            .message
+            .stated()
+            .difference(held)
+            .intersection(StatedFacts::ALL);
+        #[allow(clippy::cast_possible_truncation)]
+        let marked = marked.bits() as u32;
+        self.indexes.stated |= marked;
+        self.indexes.stale &= !marked;
+        self.publish_stated();
+        answer
+    }
+
+    /// The market message this is, for the codec's own passes: what they
+    /// state is the codec's word or a reading of its fields, never a
+    /// caller's, so nothing is lent.
+    pub(super) fn facts_mut(&mut self) -> &mut MarketMessage {
+        &mut self.message
+    }
+
+    /// The facts a caller stated through [`Self::message_mut`] since it was
+    /// lent, taken into the fields that state them: each of the
+    /// [`identity::FACT_TAGS`] reading otherwise than it did is written as
+    /// the field a fact took, in place or after everything the message
+    /// states - a fact the caller cleared states no field - so the next
+    /// reading of the fields reads what the caller stated.
+    fn absorb_lent(&mut self) {
+        let Some(lent) = self.indexes.lent.take() else {
+            return;
+        };
+        // A fact no field states that the caller stated through it is the
+        // caller's word, which no settle restates off the fields - the
+        // security identifiers among them, whose derived overlay follows
+        // the set as a removal through the handle leaves it: the pair the
+        // symbol names stands where no ISIN is held any more.
+        let fields = identity::FACT_TAGS
+            .into_iter()
+            .fold(StatedFacts::EMPTY, |held, tag| {
+                held.union(identity::fact_of_tag(tag))
+            });
+        let stated = self
+            .message
+            .stated()
+            .difference(lent.stated)
+            .intersection(StatedFacts::ALL)
+            .difference(fields);
+        #[allow(clippy::cast_possible_truncation)]
+        let word = stated.bits() as u32;
+        if word != 0 {
+            self.indexes.stated |= word;
+            self.indexes.stale &= !word;
+        }
+        if stated.contains(StatedFacts::SECURITYIDS)
+            || self.message.get_securityids() != &lent.securityids
+        {
+            // The set the caller left is its word, derivations included -
+            // but every derivation hangs on the ISIN except the pair, which
+            // hangs on the symbol and stands where the caller took the ISIN
+            // away.
+            let unlisted = lent.securityids.get(&IdType::Isin).is_some()
+                && self.message.get_securityids().get(&IdType::Isin).is_none();
+            let pair = unlisted
+                .then(|| {
+                    self.indexes
+                        .derived
+                        .iter()
+                        .find(|(kind, _)| *kind == IdType::Forex)
+                        .cloned()
+                })
+                .flatten();
+            if let Some((kind, code)) = &pair {
+                self.message.derive_securityid(kind, code);
+            }
+            self.sync_derived();
+        }
+        for (at, tag) in identity::FACT_TAGS.into_iter().enumerate() {
+            let now = identity::fact_reading(&self.message, tag);
+            if now == lent.readings[at] || !self.takes(tag) {
+                continue;
+            }
+            let value = now.map_or(Scalar::Null, |reading| {
+                self.registry
+                    .get_field_by_tag(tag)
+                    .and_then(|field| field.scalar(reading.clone()).ok())
+                    .unwrap_or(reading)
+            });
+            // The field states the fact now, as a field the message read.
+            #[allow(clippy::cast_possible_truncation)]
+            let bit = identity::fact_of_tag(tag).bits() as u32;
+            if value.is_null() {
+                self.indexes.read &= !bit;
+            } else {
+                self.indexes.read |= bit;
+            }
+            self.write_slot(tag, &value);
+        }
+        self.publish_stated();
+    }
+
+    /// Moves the market message out, the FIX handle around it let go of:
+    /// the facts, the record, the anomalies and the instrument statement
+    /// move as they stand, and the codec's word on what the source stated
+    /// is the message's [`StatedFacts`]. A message whose fields every typed
+    /// column reads - an order stating its ticker and its side - moves
+    /// without allocating.
+    ///
+    /// What FIX alone can read off the message is read here, once, into
+    /// what the message holds, so the market side splits it by its facts
+    /// alone ([`MarketMessage::into_market_data`]) into the leaves
+    /// [`Self::into_market_data`] has always answered:
+    ///
+    /// - A direct order, quote or execution states on its `metadata` fact
+    ///   what no typed column reads - the bridge's namespaced keys, then
+    ///   every other field under its name - and lifts the identifiers among
+    ///   them into the set their type belongs to.
+    /// - A `W` or `X` book message states one child per `NoMDEntries(268)`
+    ///   occurrence, each its own record - the occurrence, under the
+    ///   group's one item root - its entry's operation and book control,
+    ///   and its own members no typed column reads; an entry that cannot
+    ///   stand is a child of no category, with the warning saying why. The
+    ///   record's `NoMDEntries(268)` cell is null where the children hold
+    ///   its occurrences: one statement of each entry, never two. An empty
+    ///   `W` holds no child and the scoped snapshot control it is.
+    /// - An acknowledgement of an execution, and an execution report filed
+    ///   under `EXEC` that reports no execution, acknowledge another
+    ///   element's step ([`MarketMessage::is_acknowledgement`]).
+    ///
+    /// [`Self::from_message`] is the way back.
+    ///
+    /// ```
+    /// # fn main() -> yggdryl::Result<()> {
+    /// # use std::sync::Arc;
+    /// # use yggdryl::local::LocalFolder;
+    /// use yggdryl::graph::Market;
+    /// use yggdryl::{FixCodec, FixMsg};
+    /// # use yggdryl::FixRegistry;
+    /// # let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../config/fix");
+    /// # let registry = Arc::new(FixRegistry::from_handle(&LocalFolder::new(root)?)?);
+    /// let codec = FixCodec::new(Arc::clone(&registry));
+    /// let order = codec.parse_fix_line(b"8=FIX.4.4|35=D|11=A1|55=AAPL|54=1|10=0|")?;
+    /// let message = order.clone().into_message();
+    /// assert_eq!(message.get_ticker(), Some("AAPL"));
+    /// let back = FixMsg::from_message(registry, message)?;
+    /// assert_eq!(back.by_tag(55)?, order.by_tag(55)?);
+    /// # Ok(())
+    /// # }
+    /// ```
+    #[must_use]
+    pub fn into_message(self) -> MarketMessage {
+        super::market::into_leaf_message(self)
+    }
+
+    /// The FIX message `message` is under `registry`: the way back from
+    /// [`Self::into_message`], and the door a message no FIX parse built
+    /// takes into the codec ([`FixCodec::render`](super::FixCodec::render)).
+    ///
+    /// - **The codec's own record** - a root holding the `BeginString(8)`
+    ///   every parse writes - is adopted as it is: its root is shared, its
+    ///   indexes are read once over its children, the header and the
+    ///   capture caches off its cells, and no text is parsed. The children
+    ///   a book message states go back into its `NoMDEntries(268)` cell,
+    ///   each occurrence a child's record, in their order; the metadata
+    ///   loses what [`Self::into_message`] rendered off the record, so what
+    ///   it keeps is what no dictionary resolved.
+    /// - **Any other record** - another dictionary's, or none - is laid out
+    ///   anew: `BeginString(8)` at the default version, `MsgType(35)` from
+    ///   the category where no entry states it - `8` an order or an
+    ///   execution, `S` a quote, `W` a book, `AE` a trade, the state riding
+    ///   its crate tag - every stated fact under the one standard tag
+    ///   the enrichment reads it from, else under its crate tag, then each
+    ///   entry under the field the registry resolves its name to, typed
+    ///   through that field, and an entry it resolves none for into the
+    ///   metadata as the text it spells; each child an occurrence of the
+    ///   message's `NoMDEntries(268)` group, its stated facts under their
+    ///   tags.
+    ///
+    /// The facts are the message's, untouched: no settle runs, so a fact
+    /// set on a held message reaches the record only through a field the
+    /// codec writes ([`Self::set`]).
+    ///
+    /// # Errors
+    ///
+    /// Returns the refusal of an entry or a fact the registry's field
+    /// types will not take, or of a record that does not make a root.
+    pub fn from_message(registry: Arc<FixRegistry>, message: MarketMessage) -> Result<Self> {
+        super::market::from_leaf_message(registry, message)
+    }
+
+    /// The message around a market message and its parts, its indexes read
+    /// off the record once and nothing settled: the one constructor the
+    /// codec's doors back from a [`MarketMessage`] share.
+    pub(super) fn adopted(
+        registry: Arc<FixRegistry>,
+        message: MarketMessage,
+        header: FixHeader,
+        capture: FixCapture,
+    ) -> Result<Self> {
+        let plan = super::schema::column_plan_of(message.root(), &registry)?;
+        let indexes = FixIndexes {
+            tags: tag_positions(&plan),
+            groups: group_positions(message.root(), &registry),
+            derived: message
+                .get_securityids()
+                .iter()
+                .filter(|id| id.src() == &IdSource::Derived)
+                .map(|id| (id.kind().clone(), SmolStr::new(id.value())))
+                .collect(),
+            arrival_anomalies: message.anomalies().len(),
+            ..FixIndexes::default()
+        };
+        let mut adopted = Self {
+            registry,
+            message,
+            header: Box::new(header),
+            indexes,
+            capture: Box::new(capture),
+        };
+        adopted.adopt_stated();
+        Ok(adopted)
+    }
+
+    /// The market message this handle holds, let go of: the codec's word
+    /// on what the source stated published on it first, whatever a write
+    /// through [`Self::message_mut`] marked since.
+    pub(super) fn into_released(mut self) -> MarketMessage {
+        self.absorb_lent();
+        self.publish_stated();
+        self.message
+    }
+
+    /// The facts whose word moves from the codec to the fields: what a
+    /// message the codec lays out states under a standard tag, which the
+    /// fields now state - read again by the next settle, and the message's
+    /// stated facts unchanged.
+    pub(super) fn state_in_fields(&mut self, facts: u32) {
+        self.indexes.stated &= !facts;
+        self.indexes.read |= facts;
+        self.publish_stated();
+    }
+
+    /// The fields the facts took placed among the record's children in tag
+    /// order: what a merge laying its content out by tag does, each field
+    /// in front of the first child its tag sorts before.
+    pub(super) fn place_slots_by_tag(&mut self) {
+        if self.indexes.slots.is_empty() {
+            return;
+        }
+        let keys: SmallVec<[Option<i32>; 16]> = self
+            .message
+            .root()
+            .fields()
+            .iter()
+            .map(|child| {
+                let (tag, counter) = super::schema::tag_and_counter(&self.registry, child);
+                counter.or(tag)
+            })
+            .collect();
+        for slot in &mut self.indexes.slots {
+            slot.before = keys
+                .iter()
+                .position(|key| key.is_none_or(|key| key > slot.tag))
+                .unwrap_or(keys.len());
+        }
+        self.indexes
+            .slots
+            .sort_by_key(|slot| (slot.before, slot.tag));
+        self.indexes.entries = OnceLock::new();
+    }
+
+    /// The fields the facts took, let go of: what a layout moves from the
+    /// handle it wrote them on to the one it answers.
+    pub(super) fn take_slots(&mut self) -> SmallVec<[Consumed; 4]> {
+        self.indexes.entries = OnceLock::new();
+        std::mem::take(&mut self.indexes.slots)
+    }
+
+    /// States `slots` as the fields the facts took, over the record this
+    /// handle holds.
+    pub(super) fn set_slots(&mut self, slots: SmallVec<[Consumed; 4]>) {
+        self.indexes.slots = slots;
+        self.indexes.entries = OnceLock::new();
+    }
+
+    /// The header and capture caches, typed again off the record's cells:
+    /// each header and capture cell stated once fills its cache, over the
+    /// cache as `self` holds it. A record stating no `SendingTime(52)` is
+    /// sent when the message says it was, else when it happened - settled,
+    /// never stated, so the wire writes none.
+    pub(super) fn recache(&mut self) {
+        if !self.header.stated_sendingtime() {
+            let unix = self
+                .message
+                .get_sendunix()
+                .unwrap_or_else(|| self.message.get_transunix());
+            self.header.set_sendingtime(unix);
+        }
+        let Some(cells) = self.message.row().as_sequence() else {
+            return;
+        };
+        // The cells are read first, since recording one writes the message
+        // that holds them.
+        let stated: SmallVec<[(i32, Scalar); 16]> = self
+            .indexes
+            .tags
+            .iter()
+            .filter(|(tag, at)| {
+                identity::is_cell_tag(*tag) && self.unique_index_of_tag(*tag) == Some(*at)
+            })
+            .filter_map(|(tag, at)| {
+                cells
+                    .get(*at)
+                    .filter(|cell| !cell.is_null())
+                    .map(|cell| (*tag, cell.clone()))
+            })
+            .collect();
+        for (tag, cell) in &stated {
+            identity::record(
+                &mut self.message,
+                &mut self.header,
+                &mut self.capture,
+                *tag,
+                cell,
+            );
+        }
+    }
+
+    /// The record with the group cell at `at` stated null - its occurrences
+    /// held as the message's children ([`Self::into_message`]) - the
+    /// column made nullable so the record reads under its root. Positions
+    /// do not move, so no index does.
+    pub(super) fn null_group(&mut self, at: usize) {
+        let root = self.message.root();
+        let Some(mut values) = self.message.row().as_sequence().map(<[Scalar]>::to_vec) else {
+            return;
+        };
+        if at >= values.len() || at >= root.field_len() {
+            return;
+        }
+        let mut members = root.fields().to_vec();
+        members[at].set_nullable(true);
+        values[at] = Scalar::Null;
+        let field = crate::implementer::field_new_with_metadata(
+            root.name(),
+            DataType::from(crate::implementer::struct_type_from_unique_fields(members)),
+            root.is_nullable(),
+            root.as_metadata().clone(),
+        );
+        self.set_record(field, Scalar::from_sequence(values));
+        self.indexes.entries = OnceLock::new();
+    }
+
+    /// The group `counter` counts stated again from `rows`, each an
+    /// occurrence under `item`: the way back from [`Self::null_group`],
+    /// where the record holds that group's column null under the same
+    /// item. Answers whether it did; a record holding the group's
+    /// occurrences, or no column of it, is left as it is.
+    pub(super) fn fill_group(&mut self, counter: i32, item: &Field, rows: Vec<Scalar>) -> bool {
+        let Some(at) = self.index_of_group(counter) else {
+            return false;
+        };
+        let root = self.message.root();
+        let Some(mut values) = self.message.row().as_sequence().map(<[Scalar]>::to_vec) else {
+            return false;
+        };
+        let held = &root.fields()[at];
+        let same_item = held
+            .dtype()
+            .as_serie_type()
+            .is_some_and(|serie| serie.item() == item);
+        if !values[at].is_null() || !same_item {
+            return false;
+        }
+        let mut members = root.fields().to_vec();
+        members[at].set_nullable(false);
+        values[at] = Scalar::from_sequence(rows);
+        let field = crate::implementer::field_new_with_metadata(
+            root.name(),
+            DataType::from(crate::implementer::struct_type_from_unique_fields(members)),
+            root.is_nullable(),
+            root.as_metadata().clone(),
+        );
+        self.set_record(field, Scalar::from_sequence(values));
+        self.indexes.entries = OnceLock::new();
+        true
+    }
+
+    /// The record as the message holds it, replaced: `value` is the run
+    /// the codec laid out under `field` itself - every write and every
+    /// parse canonicalizes the cells it moves - so the message stores it
+    /// as it stands and reads nothing again.
+    fn set_record(&mut self, field: Field, value: Scalar) {
+        self.message.set_entries_unchecked(Arc::new(field), value);
+    }
+
+    /// The market facts the message stated, as [`fact`] bits.
+    pub(super) const fn stated_bits(&self) -> u32 {
+        self.indexes.stated
+    }
+
+    /// States the market facts the message stated, as [`fact`] bits.
+    fn set_stated_bits(&mut self, stated: u32) {
+        self.indexes.stated = stated;
+        self.publish_stated();
+    }
+
+    /// Marks `facts` as the message's word: what no settle restates.
+    pub(super) fn mark_stated(&mut self, facts: u32) {
+        self.set_stated_bits(self.indexes.stated | facts);
+    }
+
+    /// Hands `facts` back to the fields.
+    pub(super) fn unmark_stated(&mut self, facts: u32) {
+        self.set_stated_bits(self.indexes.stated & !facts);
+    }
+
+    /// The row bits the codec holds.
+    const fn row_bits(&self) -> u64 {
+        self.indexes.row_stated
+    }
+
+    /// States the row bits.
+    fn set_row_bits(&mut self, row: u64) {
+        self.indexes.row_stated = row & ROW_STATED;
+        self.publish_stated();
+    }
+
+    /// Publishes the codec's word on the message's [`StatedFacts`]: the
+    /// [`fact`] bits and the held clocks, beside the instant the message's
+    /// own setter marked.
+    fn publish_stated(&mut self) {
+        let instant = self.message.stated().bits() & StatedFacts::TRANSUNIX.bits();
+        let word =
+            u64::from(self.indexes.stated | self.indexes.read) | self.indexes.row_stated | instant;
+        self.message
+            .set_stated(StatedFacts::from_bits(word).unwrap_or_default());
+    }
+
+    /// Takes the word a message states as the codec's own: what a message
+    /// coming back into the codec stated.
+    fn adopt_stated(&mut self) {
+        let bits = self.message.stated().bits();
+        self.indexes.stated = u32::try_from(bits & u64::from(fact::ALL)).unwrap_or(0);
+        self.indexes.row_stated = bits & ROW_STATED;
+    }
+
+    /// Marks the wire clock as the row's or the caller's word, or hands it
+    /// back where `stated` is false.
+    pub(super) fn state_sendunix(&mut self, stated: bool) {
+        let row = self.row_bits();
+        self.set_row_bits(if stated {
+            row | ROW_STATED_SENDUNIX
+        } else {
+            row & !ROW_STATED_SENDUNIX
+        });
+    }
+
+    /// Marks the execution clock as the row's or the caller's word where
+    /// the message now holds one, or hands it back.
+    pub(super) fn state_execution(&mut self) {
+        let row = self.row_bits();
+        self.set_row_bits(if self.message.get_execunix().is_some() {
+            row | ROW_STATED_EXECUTION
+        } else {
+            row & !ROW_STATED_EXECUTION
+        });
+    }
+
+    /// Whether this message is an execution, as FIX reads one: the market
+    /// data category `EXEC` and a report of an execution. The execution a
+    /// parse splits off an order's, a quote's or a trade's report is one;
+    /// the report it was split from is its order's or its quote's, and is
+    /// not.
+    #[must_use]
+    pub fn is_execution(&self) -> bool {
+        self.message.marketdatakind() == MarketDataKind::Execution && self.reports_execution()
+    }
+
+    /// The caller's word: the security identifiers become the message's,
+    /// which no settle restates from the fields, and the wire stays as the
+    /// source sent it. The derived overlay becomes what the set now holds
+    /// under [`IdSource::Derived`], so a whole set handed over - a merge's -
+    /// keeps its derivations across the next settle.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`Market::set_securityids`]'s refusal.
+    pub(super) fn set_securityids(&mut self, ids: Identifiers, overwrite: bool) -> Result<()> {
+        self.mark_stated(fact::SECURITYIDS);
+        self.message.set_securityids(ids, overwrite)?;
+        self.sync_derived();
+        Ok(())
+    }
+
+    /// The derived overlay restated as what the message's set holds under
+    /// [`IdSource::Derived`]: what a fill or a merge of the facts derived
+    /// directly, which the next settle re-applies.
+    pub(super) fn sync_derived(&mut self) {
+        self.indexes.derived = self
+            .message
+            .get_securityids()
+            .iter()
+            .filter(|id| id.src() == &IdSource::Derived)
+            .map(|id| (id.kind().clone(), SmolStr::new(id.value())))
+            .collect();
+    }
+
+    /// One security identifier stated: a statement the message's set takes
+    /// back the derivation of its type for, in the overlay as in the set;
+    /// a derived one is [`Self::derive_securityid`].
+    ///
+    /// # Errors
+    ///
