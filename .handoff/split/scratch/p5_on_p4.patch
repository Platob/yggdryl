+            );
+        }
+        let book = codec
+            .sole_line(b"8=FIX.4.4|35=W|52=20260921-10:00:02|55=AAPL|268=2|269=0|270=99|271=5|269=1|270=101|271=7|10=0|")
+            .unwrap()
+            .into_message();
+        assert_eq!(book.children().len(), 2, "one child per occurrence");
+    }
+
+    /// A message a caller built restates its facts - all but its identity,
+    /// which digests the frame's own entries, and what the parse derives
+    /// beside them: an `8` states a day order where it says nothing of how
+    /// long it stands - and what it stated; an entry the registry resolves
+    /// is that field's, one it does not is metadata.
+    #[test]
+    fn a_native_message_rendered_and_parsed_again_restates_its_facts() {
+        let codec = super::codec();
+        let root = Arc::new(
+            DataType::from(
+                StructType::from_fields([
+                    DataType::utf8().nullable_field("Text"),
+                    DataType::utf8().nullable_field("desknote"),
+                ])
+                .unwrap(),
+            )
+            .required_field("entries"),
+        );
+        let unix = 1_790_000_000_000_000_000;
+        let mut order = MarketMessage::new(MarketDataKind::Order)
+            .try_with_entries(
+                root,
+                Scalar::from_sequence([Scalar::from("hold"), Scalar::from("desk4")]),
+            )
+            .unwrap();
+        order.set_transunix(unix);
+        order.set_creaunix(Some(unix));
+        order.set_sendunix(Some(unix));
+        order.set_state(State::New);
+        order.set_crosscode("ORD-1".to_owned());
+        order.set_ticker(Some("AAPL".into()), true);
+        order.set_side(Side::Sell, true);
+        order.set_price(Some(Decimal::parse("101.5").unwrap()), true);
+        order.set_ordqty(Some(Decimal::from_int(10)), true);
+        order.finalize();
+
+        let back = again(&codec, order.clone());
+        assert_eq!(back.get_timeinforce(), Some(&TimeInForce::Day));
+        let derived = |message: &MarketMessage| {
+            let mut facts = facts_of(message, false);
+            facts.retain(|(name, _)| *name != "timeinforce");
+            facts
+        };
+        assert_eq!(derived(&back), derived(&order));
+        // The day order the parse derived states nothing the source stated.
+        assert_eq!(back.stated(), order.stated());
+        eprintln!(
+            "SCRATCH wire {} meta {:?}",
+            String::from_utf8_lossy(&codec.render(order.clone()).unwrap()).replace('\u{1}', "|"),
+            back.get_metadata()
+        );
+        // The entry comes back under the registry's own name for it.
+        assert_eq!(
+            back.entry("text")
+                .and_then(|cell| cell.as_str().map(str::to_owned)),
+            Some("hold".to_owned())
+        );
+        assert_eq!(
+            back.get_metadata()
+                .get("desknote")
+                .map(|held| held.as_str()),
+            Some("desk4")
+        );
+        assert!(back.entry("desknote").is_none());
+    }
+
+    /// A book message a caller built writes its children as the
+    /// occurrences of `NoMDEntries(268)`, and they come back its children.
+    #[test]
+    fn a_native_book_message_renders_its_children_as_its_entries() {
+        let codec = super::codec();
+        let unix = 1_790_000_000_000_000_000;
+        let mut book = MarketMessage::new(MarketDataKind::Book);
+        book.set_transunix(unix);
+        book.set_sendunix(Some(unix));
+        book.set_ticker(Some("AAPL".into()), true);
+        book.set_book(Some(BookRef {
+            action: Some(MdUpdateAction::Snapshot),
+            scope: Some("Symbol=AAPL".into()),
+            ..BookRef::default()
+        }));
+        for (side, price, size) in [(Side::Buy, 99, 5), (Side::Sell, 101, 7)] {
+            let mut level = MarketMessage::new(MarketDataKind::Quotation);
+            level.set_side(side, true);
+            level.set_price(Some(Decimal::from_int(price)), true);
+            level.set_quantity(Some(Decimal::from_int(size)), true);
+            book.push_child(level).unwrap();
+        }
+        book.finalize();
+
+        let back = again(&codec, book.clone());
+        assert_eq!(back.marketdatakind(), MarketDataKind::Book);
+        let levels: Vec<(Side, Option<Decimal>, Option<Decimal>)> = back
+            .children()
+            .iter()
+            .map(|child| (child.get_side(), child.get_price(), child.get_quantity()))
+            .collect();
+        assert_eq!(
+            levels,
+            [
+                (
+                    Side::Buy,
+                    Some(Decimal::from_int(99)),
+                    Some(Decimal::from_int(5))
+                ),
+                (
+                    Side::Sell,
+                    Some(Decimal::from_int(101)),
+                    Some(Decimal::from_int(7))
+                ),
+            ]
+        );
+        assert_eq!(back.get_ticker(), Some("AAPL"));
+        assert_eq!(back.get_transunix(), unix);
+    }
+}
