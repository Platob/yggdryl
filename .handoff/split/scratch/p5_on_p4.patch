diff --git a/node/src/graph/message.rs b/node/src/graph/message.rs
new file mode 100644
index 000000000..fcc6e0cd3
--- /dev/null
+++ b/node/src/graph/message.rs
@@ -0,0 +1,86 @@
+//! Native Node.js view of [`CoreMarketMessage`], the one message every
+//! protocol lands in, as the class `MarketData.asMessage()` answers.
+//!
+//! The class is read-only and carries no verb of its own: its facts are the
+//! ones every leaf answers, through the same getter macros, and the rest is
+//! the message's own state - the entry root and row, the children it
+//! states, what its reading could not take. A message is built by a codec
+//! (`FixCodec`) and split into the leaves it states by
+//! `MarketData.arrowReader`; it is never constructed or followed here.
+
+use napi_derive::napi;
+use yggdryl::graph::{Market, MarketMessage as CoreMarketMessage};
+
+use crate::field::JsField;
+use crate::fix::AnomalyView;
+use crate::text::codec::JsScalar;
+
+/// A market message: the element, event, market and operation facts one
+/// source statement states, the entries it states beyond them, and the
+/// children it states - a book message's levels, each a message. Immutable.
+#[napi(js_name = "MarketMessage")]
+#[derive(Clone)]
+pub struct JsMarketMessage {
+    pub(crate) inner: CoreMarketMessage,
+}
+
+impl JsMarketMessage {
+    /// Wrap a message the core built.
+    pub(crate) const fn from_core(inner: CoreMarketMessage) -> Self {
+        Self { inner }
+    }
+}
+
+#[napi]
+impl JsMarketMessage {
+    /// The market data category of this message, as the `marketdatakind`
+    /// member's stored name: `ORDR`, `QUOT`, `EXEC`, `TRAD` or `BOOK`, the
+    /// category its source files it under.
+    #[napi(getter)]
+    pub fn marketdatakind(&self) -> &'static str {
+        Market::marketdatakind(&self.inner).as_str()
+    }
+
+    /// The root the entries sit under: the one field of its source's
+    /// dictionary, shared by every message of it.
+    #[napi(getter)]
+    pub fn root(&self) -> JsField {
+        JsField::from_core((**self.inner.root()).clone())
+    }
+
+    /// The entries the message states beyond its facts: the ordered run
+    /// under `root`, one cell per child of the root.
+    #[napi(getter)]
+    pub fn row(&self) -> JsScalar {
+        JsScalar::from_core(self.inner.row().clone())
+    }
+
+    /// The elements the message states, in order: a book message's levels,
+    /// each a message under one root. Empty for a message stating none.
+    #[napi(getter)]
+    pub fn children(&self) -> Vec<JsMarketMessage> {
+        self.inner
+            .children()
+            .iter()
+            .cloned()
+            .map(Self::from_core)
+            .collect()
+    }
+
+    /// What the reading of the message could not take as it stands, in
+    /// arrival order: a value that would not type, an alias stating another
+    /// value than the field it lost to, what a walk found citing two chains.
+    #[napi(getter)]
+    pub fn anomalies(&self) -> Vec<AnomalyView> {
+        self.inner
+            .anomalies()
+            .iter()
+            .map(AnomalyView::from_core)
+            .collect()
+    }
+}
+
+element_getters!(JsMarketMessage);
+event_getters!(JsMarketMessage);
+market_getters!(JsMarketMessage);
+operation_getters!(JsMarketMessage);
