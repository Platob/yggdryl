+    assert!(message.entry("text").is_none());
+    assert!(message.children().is_empty());
+    assert!(message.anomalies().is_empty());
+    assert!(message.instrument().is_empty());
+    assert!(message.book().is_none());
+    assert!(!message.is_acknowledgement());
+    assert_eq!(message.get_transunix(), 0, "at the epoch");
+
+    // Every message stating no entry shares one root.
+    let other = MarketMessage::new(MarketDataKind::Order);
+    assert!(Arc::ptr_eq(message.root(), other.root()));
+
+    let mut refiled = message;
+    refiled.set_stated(StatedFacts::EMPTY);
+    refiled.set_marketdatakind(MarketDataKind::Execution);
+    assert_eq!(refiled.marketdatakind(), MarketDataKind::Execution);
+    assert_eq!(refiled.stated(), StatedFacts::KIND, "refiling states it");
