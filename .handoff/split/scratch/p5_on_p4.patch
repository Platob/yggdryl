new file mode 100644
index 000000000..b1ce3a607
--- /dev/null
+++ b/python/tests/graph/test_message.py
@@ -0,0 +1,182 @@
+"""``graph.MarketMessage``, the message every protocol lands in: `python/src/graph/message.rs`."""
+
+from __future__ import annotations
+
+import copy
+import decimal
+import pickle
+
+import pytest
+
+from yggdryl import DataType, Field, MarketDataKind, Side, graph
+
+CLOCK = 1_700_000_000_000_000_000
+D = decimal.Decimal
+
+
+def entries_root() -> Field:
+    """An entry root of two nullable children."""
+    return Field(
+        "entries",
+        DataType.from_fields([Field("text", "utf8"), Field("count", "int64")]),
+        nullable=False,
+    )
+
+
+def order() -> graph.MarketMessage:
+    """A native order message stating its facts and two entries."""
+    return graph.MarketMessage(
+        CLOCK,
+        "ORDR",
+        root=entries_root(),
+        row={"text": "hello"},
+        crosscode="O-1",
+        side="BUYS",
+        price=D("101.5"),
+        quantity=100,
+        ticker="ACME",
+    )
+
+
+def book() -> graph.MarketMessage:
+    """A full-refresh book message stating its two levels as children."""
+    control = graph.BookRef(action="snapshot", scope="Symbol=ACME")
+    levels = [
+        graph.MarketMessage(CLOCK, MarketDataKind.QUOT, side=side, price=price, book=control)
+        for side, price in (("BUYS", 99), ("SELL", 101))
+    ]
+    return graph.MarketMessage(CLOCK, "BOOK", children=levels, ticker="ACME", book=control)
+
+
+def test_the_constructor_states_the_category_the_facts_and_the_entries() -> None:
+    message = order()
+    assert message.kind == "message"
+    assert message.marketdatakind is MarketDataKind.ORDR
+    assert message.transunix == CLOCK
+    assert message.side is Side.BUYS
+    assert message.price is not None and message.price.as_py() == D("101.5")
+    assert message.ticker == "ACME"
+    # A sided kind states its side in its stored cross code.
+    assert message.crosscode == "10:1:O-1"
+    assert message.hashcode != 0
+    # The category reads through its datatype's own value door.
+    assert graph.MarketMessage(CLOCK, MarketDataKind.ORDR).marketdatakind is MarketDataKind.ORDR
+    # Nothing else stated, nothing answered.
+    assert message.children == [] and message.anomalies == []
+    assert message.book is None and not message.is_acknowledgement
+    assert message.instrument == {"countrycode": None, "underlyingisin": None, "eusipacode": None}
+
+
+def test_the_entries_are_one_row_read_by_exact_name() -> None:
+    message = order()
+    assert message.root == entries_root()
+    entry = message.entry("text")
+    assert entry is not None and entry.as_py() == "hello"
+    # An entry the row leaves out is its field's default: a stated null.
+    count = message.entry("count")
+    assert count is not None and count.as_py() is None
+    # A name reaches an entry exactly, as the root's own lookup does.
+    assert message.entry("TEXT") is None
+    assert [name for name, _ in message.record()] == ["text", "count"]
+    assert [cell.as_py() for _, cell in message.record()] == ["hello", None]
+    # The row is what the constructor takes back.
+    again = graph.MarketMessage(
+        CLOCK,
+        "ORDR",
+        root=message.root,
+        row=message.row,
+        crosscode="O-1",
+        side="BUYS",
+        price=D("101.5"),
+        quantity=100,
+        ticker="ACME",
+    )
+    assert again == message
+    # A message stating no entry stands under the empty root.
+    bare = graph.MarketMessage(CLOCK, "ORDR")
+    assert bare.root.name == "entries" and bare.record() == []
+
+
+def test_a_fact_the_message_does_not_take_is_refused_by_name() -> None:
+    with pytest.raises(ValueError, match="an identity is derived"):
+        graph.MarketMessage(CLOCK, "ORDR", uuid="0190f8e2-0000-7000-8000-000000000000")
+    with pytest.raises(ValueError, match="MarketMessage states transunix once, as its first argument"):
+        graph.MarketMessage(CLOCK, "ORDR", transunix=1)  # type: ignore[misc]
+    with pytest.raises(ValueError, match="the category"):
+        graph.MarketMessage(CLOCK, "ORDR", marketdatakind="QUOT")
+    with pytest.raises(ValueError, match="states no fact"):
+        graph.MarketMessage(CLOCK, "ORDR", nope=1)
+    with pytest.raises(ValueError):
+        graph.MarketMessage(CLOCK, "NOPE")
+    # An entry named as a fact would give the fact a second owner.
+    shadow = Field("entries", DataType.from_fields([Field("price", "utf8")]), nullable=False)
+    with pytest.raises(ValueError, match="a column the message states itself"):
+        graph.MarketMessage(CLOCK, "ORDR", root=shadow, row={"price": "1"})
+    with pytest.raises(TypeError, match="name the root too"):
+        graph.MarketMessage(CLOCK, "ORDR", row={"text": "hello"})
+    with pytest.raises(TypeError, match="expected a BookRef"):
+        graph.MarketMessage(CLOCK, "BOOK", book=1)  # type: ignore[arg-type]
+    # A fact given as `...` is skipped.
+    assert graph.MarketMessage(CLOCK, "ORDR", price=...).price is None
+
+
+def test_children_are_messages_one_level_deep() -> None:
+    message = book()
+    assert [child.side for child in message.children] == [Side.BUYS, Side.SELL]
+    assert all(isinstance(child, graph.MarketMessage) for child in message.children)
+    with pytest.raises(ValueError, match="one level deep"):
+        graph.MarketMessage(CLOCK, "BOOK", children=[message])
+
+
+def test_the_message_splits_into_the_leaves_it_states() -> None:
+    [leaf] = order().into_market_data()
+    assert leaf.kind == "order_event"
+    assert (leaf.price, leaf.side, leaf.crosscode) == (order().price, Side.BUYS, "10:1:O-1")
+    assert order().into_market_leaf() == leaf
+    # One leaf per level, each carrying what the book states and it does not.
+    levels = book().into_market_data()
+    assert len(levels) == 2
+    assert all(level.ticker == "ACME" for level in levels)
+    assert levels[1].side is Side.SELL
+    with pytest.raises(ValueError, match="exactly one market data element"):
+        book().into_market_leaf()
+
+
+def test_the_row_form_restates_the_message_whole() -> None:
+    message = order()
+    form = graph.MarketMessage.field(message.root)
+    assert form.name == "message"
+    names = [child.name for child in form]
+    assert names[:2] == ["uuid", "crossuuid"]
+    assert names[-4:] == ["text", "count", "children", "anomalies"]
+    row = message.into_scalar()
+    assert graph.MarketMessage.from_scalar(message.root, None, row) == message
+    # A message stating children carries them under their own root.
+    whole = book()
+    child_root = whole.children[0].root
+    assert graph.MarketMessage.from_scalar(whole.root, child_root, whole.into_scalar()) == whole
+
+
+def test_the_protocol_copies_hashes_and_pickles_by_the_row_form() -> None:
+    for message in (order(), book(), graph.MarketMessage(CLOCK, "EXEC")):
+        assert pickle.loads(pickle.dumps(message)) == message
+        assert copy.copy(message) == message and copy.deepcopy(message) == message
+        assert hash(message) == hash(copy.copy(message))
+        assert message.stable_hash() == pickle.loads(pickle.dumps(message)).stable_hash()
+    assert order() != book()
+    assert order() != object()
+    assert repr(order()).startswith("MarketMessage(")
+
+
+def test_the_walk_verbs_are_the_operations_own() -> None:
+    first = graph.MarketMessage(CLOCK, "ORDR", crosscode="O-1", side="BUYS", price=1, ticker="ACME")
+    second = graph.MarketMessage(CLOCK + 1, "ORDR", crosscode="O-1", side="BUYS", price=2)
+    assert second.is_after(first) and first.is_before(second)
+    followed = second.with_previous(first)
+    assert followed is not None
+    assert followed.prevuuid == first.uuid and followed.prevunix == first.transunix
+    assert second.prevuuid is None  # immutable: the verb answered a new message
+    assert first.with_previous(second) is None
+    assert first.merge_with(first) is None
+    assert followed.restating(followed) == followed
+    assert isinstance(graph.MarketData(second).as_message(), graph.MarketMessage)
