+/// `FixMsg` is the codec's handle over a market message: the message moves
+/// out and back without a text parse, a message under another root is laid
+/// out under the registry's fields, and a tag the dictionary maps onto a
+/// fact is that fact - read into it at parse and written from it on the
+/// wire.
+mod message_handle {
+    use std::sync::Arc;
+
+    use super::SoleMessage;
+
+    use smol_str::SmolStr;
+    use yggdryl::graph::{Element, Event, Market, MarketMessage};
+    use yggdryl::{DataType, Decimal, FixMsg, MarketDataKind, Scalar, Side, StructType};
+
+    const ORDER: &[u8] =
+        b"8=FIX.4.4|35=D|52=20240102-10:00:00.000|11=C1|55=AAPL|54=1|40=2|44=101.5|38=10|59=0|10=0|";
+
+    /// A message no codec reads by its entries alone - one it resolves and
+    /// one it does not - under a root of its own.
+    fn native() -> MarketMessage {
+        let root = Arc::new(
+            DataType::from(
+                StructType::from_fields([
+                    DataType::utf8().nullable_field("Text"),
+                    DataType::utf8().nullable_field("DeskNote"),
+                ])
+                .expect("two entries"),
+            )
+            .required_field("entries"),
+        );
+        let mut message = MarketMessage::new(MarketDataKind::Order)
+            .try_with_entries(
+                root,
+                Scalar::from_sequence([Scalar::from("hold"), Scalar::from("desk 4")]),
+            )
+            .expect("entries the root accepts");
+        message.set_transunix(1_700_000_000_000_000_000);
+        message.set_crosscode("ORD-9".to_owned());
+        message.set_side(Side::Sell, true);
+        message.set_price(Some(Decimal::parse("99.25").unwrap()), true);
+        message.finalize();
+        message
+    }
+
+    /// The way out moves the message as it stands, and the way back adopts
+    /// the codec's own record as it is: its root shared, nothing parsed, the
+    /// wire the same pairs. The order they arrived in is the handle's and
+    /// does not cross: the way back lays the fields its facts took out by
+    /// the native rule.
+    #[test]
+    fn a_fix_message_moves_into_its_market_message_and_back() {
+        let (registry, reader) = super::reader();
+        let order = reader.sole_line(ORDER).expect("an order");
+        let message = order.clone().into_message();
+        assert_eq!(message.marketdatakind(), MarketDataKind::Order);
+        assert_eq!(message.get_ticker(), Some("AAPL"));
+        assert_eq!(message.get_side(), Side::Buy);
+        assert_eq!(message.get_uuid(), order.message().get_uuid());
+        assert_eq!(message.anomalies(), order.anomalies());
+
+        let back = FixMsg::from_message(Arc::clone(&registry), message.clone())
+            .expect("the codec's own record");
+        assert!(
+            Arc::ptr_eq(back.message().root(), message.root()),
+            "the record's root is adopted, not rebuilt"
+        );
+        assert_eq!(back.message().get_uuid(), order.message().get_uuid());
+        let pairs = |wire: Vec<u8>| {
+            let mut pairs: Vec<String> = String::from_utf8(wire)
+                .expect("a text wire")
+                .split('|')
+                .filter(|pair| !pair.is_empty())
+                .map(str::to_owned)
+                .collect();
+            pairs.sort_unstable();
+            pairs
+        };
+        assert_eq!(pairs(back.into_bytes(b'|')), pairs(order.into_bytes(b'|')));
+        assert_eq!(back.clone().into_message(), message, "and out again");
+    }
+
+    /// A message under another root is laid out under the registry: an
+    /// entry whose name the registry resolves lands under that field, one
+    /// it does not in the metadata, and the facts are the message's,
+    /// untouched - identity included.
+    #[test]
+    fn a_message_under_another_root_is_laid_out_under_the_registry() {
+        let (registry, reader) = super::reader();
+        let native = native();
+        let fix = FixMsg::from_message(Arc::clone(&registry), native.clone())
+            .expect("a message the registry lays out");
+        assert_eq!(fix.text(), Some("hold"), "Text(58) resolved");
+        assert_eq!(
+            fix.metadata().get("DeskNote").map(SmolStr::as_str),
+            Some("desk 4"),
+            "no field is named DeskNote"
+        );
+        assert!(fix.get_by_name("DeskNote").is_none());
+        let facts = fix.message();
+        assert_eq!(facts.marketdatakind(), MarketDataKind::Order);
+        assert_eq!(facts.get_side(), Side::Sell);
+        assert_eq!(facts.get_price(), native.get_price());
+        assert_eq!(facts.get_transunix(), native.get_transunix());
+        assert_eq!(facts.get_uuid(), native.get_uuid(), "nothing settled");
+        assert_eq!(facts.get_hashcode(), native.get_hashcode());
+
+        // The record is the registry's now: re-rooted, never shared.
+        assert!(!Arc::ptr_eq(fix.message().root(), native.root()));
+        // The frame the codec renders states the text and the side.
+        let wire = String::from_utf8(reader.render(native).expect("a frame"))
+            .expect("a text wire")
+            .replace('\u{1}', "|");
+        assert!(wire.starts_with("8=FIX."), "{wire}");
+        assert!(wire.contains("|58=hold|"), "{wire}");
+        assert!(
+            wire.contains("|54=2|"),
+            "the side under its own tag: {wire}"
+        );
+    }
+
+    /// The idmap rule: `Side(54)` is the side fact. A parse reads it into
+    /// the fact and keeps no entry of it, and the wire writes it from the
+    /// fact - so a side stated on the message is the side the wire says.
+    #[test]
+    fn a_stated_side_is_read_into_the_fact_and_written_from_it() {
+        let (_, reader) = super::reader();
+        let mut order = reader.sole_line(ORDER).expect("an order");
+        assert_eq!(order.message().get_side(), Side::Buy, "read into the fact");
+        let message = order.clone().into_message();
+        assert!(
+            message
+                .entry("Side")
+                .is_none_or(|cell| cell.as_ref().is_null()),
+            "no entry states the side: {:?}",
+            message.record()
+        );
+
+        order.message_mut().set_side(Side::Sell, true);
+        let wire = String::from_utf8(order.into_bytes(b'|')).expect("a text wire");
+        assert!(
+            wire.contains("|54=2|") && !wire.contains("|54=1|"),
+            "written from the fact: {wire}"
+        );
+    }
+}
