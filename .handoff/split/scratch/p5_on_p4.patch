+        message.uuid,
+        message.crosscode,
+        message.price,
+        message.side,
+    )
+    # A message is a dated operation: it roots a trade and a snapshot control.
+    assert graph.SnapshotEvent.snapshot(data, "S").transunix == CLOCK
+    trade = graph.TradeEvent.from_parts(
