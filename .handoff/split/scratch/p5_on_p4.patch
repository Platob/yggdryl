+/// The entries are one run under the root, read by exact name; a cell read
+/// is the cell as stored, null where nothing is stated there.
+#[test]
+fn the_entries_are_read_by_exact_name_and_whole() {
+    let message = MarketMessage::new(MarketDataKind::Order)
+        .try_with_entries(
+            root(),
+            Scalar::from_sequence([Scalar::from("hello"), Scalar::Null]),
+        )
+        .unwrap();
+    let text = message.entry("text").expect("a child of the root");
+    assert_eq!(text.as_str(), Some("hello"));
+    assert_eq!(text.name(), "text");
+    assert!(
+        message
+            .entry("venueseq")
+            .expect("a child")
+            .as_ref()
+            .is_null()
+    );
+    assert!(message.entry("TEXT").is_none(), "a name is exact");
+    assert!(message.entry("price").is_none(), "a fact is no entry");
+
+    let record = message.record();
+    assert_eq!(record.names().collect::<Vec<_>>(), ["text", "venueseq"]);
+    assert_eq!(record.as_str("text"), Some("hello"));
+    assert_eq!(message.row(), &record.into_scalar());
+
+    // One entry replaced, the others kept.
+    let mut message = message;
+    message.set_entry("venueseq", Scalar::from(9_i64)).unwrap();
+    assert_eq!(
+        message.entry("venueseq").map(|cell| cell.into_value()),
+        Some(Scalar::from(9_i64))
+    );
