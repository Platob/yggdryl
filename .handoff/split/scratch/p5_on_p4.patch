+        writes
+            .iter()
+            .map(|(name, value)| (FixKey::Name(name.as_str()), value.clone())),
+    );
+    keyed.extend(
+        standard
+            .into_iter()
+            .map(|(tag, value)| (FixKey::Tag(tag), value)),
+    );
