+        Element::merge_with(self.inner.clone(), &other.inner)
+            .map(Self::from_core)
+    }
+
+    /// This message stated as another statement of `live`, taking live's
+    /// predecessor, place and snapshot.
+    fn restating(&self, live: &Self) -> Self {
+        Self::from_core(Event::restating(self.inner.clone(), &live.inner))
+    }
+
+    /// Whether this message comes after `other`: by its instant.
+    fn is_after(&self, other: &Self) -> bool {
+        Element::is_after(&self.inner, &other.inner)
+    }
+
+    /// Whether this message comes before `other`: by its instant.
+    fn is_before(&self, other: &Self) -> bool {
+        Element::is_before(&self.inner, &other.inner)
+    }
+
+    /// The market data leaves the message states, read off its facts
+    /// alone: one per child filed as an order, a quote or an execution,
+    /// each carrying what the message states and the child does not; with
+    /// no children an order, a quote or an execution is one leaf and a full
+    /// refresh one snapshot control; an acknowledgement, a trade, a batch
+    /// and any other category none.
+    #[allow(clippy::wrong_self_convention)] // The core's own name, over `&self`: frozen, never moved.
