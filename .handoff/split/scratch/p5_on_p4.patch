+/// The standard tag each stated fact is written under - the one tag the
+/// enrichment reads it from first - beside the text it spells there. A
+/// stated fact absent here, or holding none, is written under its crate
+/// tag by [`FixMsg::into_rendered_bytes`].
+///
+/// | Fact | Tag |
+/// | --- | --- |
+/// | `side` | `Side(54)`, its wire character |
+/// | `price` | `Price(44)` |
+/// | `quantity` | `Quantity(53)` |
+/// | `ordqty` | `OrderQty(38)` |
+/// | `currency` | `Currency(15)` |
+/// | `cficode` | `CFICode(461)` |
+/// | `timeinforce` | `TimeInForce(59)`, its wire value |
+/// | `stoppx` | `StopPx(99)` |
+/// | `strikepx` | `StrikePrice(202)` |
+/// | `displayqty` | `DisplayQty(1138)` |
+/// | `cxlqty` | `CxlQty(84)` |
+/// | `prevpx` | `PrevClosePx(140)` |
+/// | `lastpx`, `spotrate`, `forwardpoints` | `LastPx(31)`, `LastSpotRate(194)`, `LastForwardPoints(195)` |
+/// | `lastqty`, `avgpx`, `cumqty`, `leavesqty` | `LastQty(32)`, `AvgPx(6)`, `CumQty(14)`, `LeavesQty(151)` |
+/// | `bidpx`, `bidqty`, `askpx`, `askqty` | `BidPx(132)`, `BidSize(134)`, `OfferPx(133)`, `OfferSize(135)` |
+/// | `ticker` | `Symbol(55)` |
+/// | `miccode` | `LastMkt(30)` |
+/// | `exprunix` | `ExpireTime(126)` |
+/// | `execunix` | `TrdRegTimestamp`'s crate column - no standard tag dates an execution alone |
+/// | `unit` | `UnitOfMeasure(996)` |
+pub(super) fn standard_writes(message: &MarketMessage) -> (Vec<(i32, Scalar)>, StatedFacts) {
+    let stated = message.stated();
+    let mut writes = Vec::new();
+    let mut written = StatedFacts::EMPTY;
+    for tag in super::identity::FACT_TAGS {
+        let fact = super::identity::fact_of_tag(tag);
+        if stated.contains(fact)
+            && let Some(value) = super::identity::fact_reading(message, tag)
+        {
+            writes.push((tag, value));
+            written.insert(fact);
+        }
+    }
+    // A bid's or an ask's currency has no tag of its own here: the pair
+    // goes under the crate tags with them.
+    if stated.contains(StatedFacts::BIDASK)
+        && (message.get_bidccy().is_some() || message.get_askccy().is_some())
+    {
+        written.remove(StatedFacts::BIDASK);
+    }
+    // The FX parts complete one another: a part held alone is no statement
+    // the fields restate, so it stays the crate's word.
+    if stated.contains(StatedFacts::LASTPX) && message.get_lastpx().is_none() {
+        written.remove(StatedFacts::LASTPX);
+    }
+    (writes, written)
+}
