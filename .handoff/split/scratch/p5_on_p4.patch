+impl MarketMessage {
+    /// The code the message digests to: its facts as an operation event
+    /// digests them, then its category, its acknowledgement, its book
+    /// control and its instrument statement under their names, its entries
+    /// under theirs, and each child's code in order. Never its anomalies,
+    /// never what its source stated.
+    fn digest_content(&self) -> u64 {
+        let mut state = self.facts.digest_operation_event();
+        self.feed_content(&mut state);
+        state.as_u64()
+    }
+
+    fn feed_content(&self, state: &mut Xxh3) {
+        let kind = Scalar::from(self.marketdatakind());
+        let acknowledgement = Scalar::from(self.acknowledgement);
+        let book = book_cell(self.book.as_deref());
+        let instrument = self.instrument.cell();
+        crate::implementer::write_named_bytes(
+            state,
+            [
+                (ACKNOWLEDGEMENT, &acknowledgement),
+                (BOOK, &book),
+                (INSTRUMENT, &instrument),
+                ("marketdatakind", &kind),
+            ]
+            .into_iter(),
+            0,
+        );
+        let entries = self.row.sequence_rows().unwrap_or_default();
+        crate::implementer::write_named_bytes(
+            state,
+            self.root
+                .fields()
+                .iter()
+                .map(Field::name)
+                .zip(entries.iter()),
+            0,
+        );
+        state.write(&(self.children.len() as u64).to_le_bytes());
+        for child in &self.children {
+            state.write(&child.digest_content().to_le_bytes());
+        }
+    }
+}
