+// ------------------------------------------------------------------------
+// Refusals
+// ------------------------------------------------------------------------
+
+/// The entries are one non-null struct root no child of which is named as a
+/// column the message states itself, so no fact has a second owner; a row
+/// the root does not accept is refused; and every refusal leaves the
+/// message as it was.
+#[test]
+fn entries_are_refused_where_they_would_be_a_second_owner_or_no_row() {
+    let mut message = MarketMessage::new(MarketDataKind::Order);
+    let before = message.clone();
+
+    let nullable = Arc::new(
+        DataType::from(StructType::from_fields([DataType::utf8().nullable_field("text")]).unwrap())
+            .nullable_field("entries"),
+    );
+    let error = message
+        .set_entries(nullable, Scalar::from_sequence([Scalar::from("x")]))
+        .unwrap_err();
+    assert_eq!(refused_at(&error), "$", "{error}");
+
+    let flat = Arc::new(DataType::utf8().required_field("entries"));
+    let error = message.set_entries(flat, Scalar::from("x")).unwrap_err();
+    assert_eq!(refused_at(&error), "$", "{error}");
+
+    for owned in [
+        "price",
+        "transunix",
+        "uuid",
+        "stated",
+        "CHILDREN",
+        "anomalies",
+    ] {
+        let named = Arc::new(
+            DataType::from(
+                StructType::from_fields([DataType::utf8().nullable_field(owned)]).unwrap(),
+            )
+            .required_field("entries"),
+        );
+        let error = message
+            .set_entries(named, Scalar::from_sequence([Scalar::Null]))
+            .unwrap_err();
+        assert_eq!(refused_at(&error), format!("$.{owned}"), "{error}");
+    }
+
+    let required = Arc::new(
+        DataType::from(
+            StructType::from_fields([DataType::Int64.required_field("venueseq")]).unwrap(),
+        )
+        .required_field("entries"),
+    );
+    assert!(
+        message
+            .set_entries(required, Scalar::from_sequence([Scalar::Null]))
+            .is_err(),
+        "a required entry stating nothing"
+    );
+    assert!(
+        message.set_entries(root(), Scalar::from("x")).is_err(),
+        "no run of the root's arity"
+    );
+    assert_eq!(
+        message, before,
+        "every refusal leaves the message unchanged"
+    );
+}
