+    // parse of the frame states it again.
+    let mut native = MarketMessage::new(MarketDataKind::Order);
+    native.set_transunix(1_790_000_000_000_000_000);
+    native.set_state(State::New);
+    native.set_crosscode("ORD-1".to_owned());
+    native.set_side(Side::Sell, true);
+    native.set_price(Some(Decimal::parse("99.25")?), true);
+    native.finalize();
+    let wire = codec.render(native.clone())?;
+    assert!(wire.windows(5).any(|pair| pair == b"\x0154=2"), "the side under Side(54)");
+    let again = codec.parse_fix_line(&wire)?.into_message();
+    assert_eq!(again.marketdatakind(), MarketDataKind::Order);
+    assert_eq!((again.get_side(), again.get_price()), (Side::Sell, native.get_price()));
+    assert_eq!(again.get_crosscode(), native.get_crosscode());
+    assert_eq!(again.stated(), native.stated());
