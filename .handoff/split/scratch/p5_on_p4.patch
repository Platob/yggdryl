+    assert_eq!(refused_at(&error), "$.Text", "a name is exact: {error}");
+    assert!(
+        message
+            .set_entry("venueseq", Scalar::from("seven"))
+            .is_err(),
+        "an integer child refuses text"
+    );
+    assert_eq!(message, before);
+}
