+#[test]
+fn a_row_that_is_no_message_is_refused_naming_where() {
+    let message = order(1, "O-1");
+    let form = MarketMessage::field(message.root(), None).unwrap();
+    let row = message.into_scalar();
+
+    let error = MarketMessage::from_scalar(Arc::clone(message.root()), None, &Scalar::from("x"))
+        .unwrap_err();
+    assert_eq!(refused_at(&error), "$", "{error}");
+
+    let cells = row.sequence_rows().unwrap().into_owned();
+    let short = Scalar::from_sequence(cells[..cells.len() - 1].iter().cloned());
+    let error = MarketMessage::from_scalar(Arc::clone(message.root()), None, &short).unwrap_err();
+    assert_eq!(refused_at(&error), "$", "one cell short: {error}");
+
+    let stated = form.index_of("stated").expect("a stated column");
+    let mut unknown = cells.clone();
+    unknown[stated] = Scalar::from(1_u64 << 40);
+    let error = MarketMessage::from_scalar(
+        Arc::clone(message.root()),
+        None,
+        &Scalar::from_sequence(unknown),
+    )
+    .unwrap_err();
+    assert_eq!(refused_at(&error), "$.stated", "{error}");
+
+    let book_at = form.index_of("book").expect("a book column");
+    let mut action = cells;
+    action[book_at] = Scalar::from_sequence([
+        Scalar::from("sideways"),
+        Scalar::Null,
+        Scalar::Null,
+        Scalar::Null,
+        Scalar::Null,
+    ]);
+    let error = MarketMessage::from_scalar(
+        Arc::clone(message.root()),
+        None,
+        &Scalar::from_sequence(action),
+    )
+    .unwrap_err();
+    assert_eq!(refused_at(&error), "$.book.action", "{error}");
+}
