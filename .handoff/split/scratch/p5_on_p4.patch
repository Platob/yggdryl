+/// `NoMDEntries(268)`'s counter tag.
+const MD_ENTRIES: i32 = 268;
+
+/// The message type a message's record states under `MsgType(35)`, else
+/// the one its kind is written as ([`msgtype_for_kind`]).
+pub(super) fn msgtype_of_message(registry: &FixRegistry, message: &MarketMessage) -> Option<SmolStr> {
+    message
+        .root()
+        .fields()
+        .iter()
+        .zip(message.row().as_sequence().unwrap_or_default())
+        .find(|(child, _)| super::schema::tag_and_counter(registry, child).0 == Some(35))
+        .and_then(|(_, cell)| cell.as_str().map(SmolStr::new))
+        .or_else(|| msgtype_for_kind(message.marketdatakind()).map(SmolStr::new_static))
+}
+
+/// The group a book message of `msgtype` writes its entries under: the
+/// one its message type's definition holds under `NoMDEntries(268)` -
+/// `MDFullGrp` for a snapshot, `MDIncGrp` for an incremental refresh -
+/// else the dictionary's one group that counter heads.
+///
+/// # Errors
+///
+/// Returns an error where the registry defines no such group.
+pub(super) fn book_group<'r>(registry: &'r FixRegistry, msgtype: Option<&str>) -> Result<&'r Field> {
+    msgtype
+        .and_then(|msgtype| registry.get_msgtype(msgtype))
+        .and_then(|definition| definition.get_group_by_tag(MD_ENTRIES))
+        .or_else(|| registry.get_field_by_counter(MD_ENTRIES))
+        .ok_or_else(|| Error::InvalidRecord {
+            path: SmolStr::new_static("$.children"),
+            reason: SmolStr::new_static(
+                "the registry defines no NoMDEntries(268) group to write a book's entries under",
+            ),
+        })
+}
+
+/// The children of a book message as the occurrences of its
+/// `NoMDEntries(268)` group under `registry`: one per child, each the
+/// members its facts state - `MDUpdateAction(279)` for an incremental
+/// action, `MDEntryType(269)` (`2` an execution, else `0` a bid and `1` an
+/// offer by its side), `MDEntryPx(270)` and `MDEntrySize(271)` - the
+/// entry's own where its book control states them, else its price and its
+/// quantity - `MDEntrySpotRate(1026)` and `MDEntryForwardPoints(1027)`,
+/// `MDEntryID(278)`, `MDEntryRefID(280)` and `OrderID(37)` from its
+/// identifiers, `MDEntryPositionNo(290)`, `Symbol(55)` and, for an
+/// execution, `Side(54)`. An entry's clock is not written: it reads as its
+/// message's.
+///
+/// # Errors
+///
+/// Returns an error where `group` ([`book_group`]) holds no occurrences.
+pub(super) fn occurrences_of(
+    registry: &FixRegistry,
+    group: &Field,
+    children: &[MarketMessage],
+) -> Result<Scalar> {
+    use crate::graph::MdUpdateAction;
+    use crate::graph::book::{ENTRY_ID, ENTRY_REF_ID};
+
+    let item = group
+        .dtype()
+        .as_serie_type()
+        .map(|serie| serie.item().clone())
+        .ok_or_else(|| Error::InvalidRecord {
+            path: SmolStr::new_static("$.children"),
+            reason: SmolStr::new(format!(
+                "the {} group holds no occurrences to write a book's entries under",
+                group.name()
+            )),
+        })?;
+    let member = |tag: i32| {
+        item.fields()
+            .iter()
+            .find(|field| {
+                registry
+                    .identity_of(field)
+                    .is_some_and(|(held, _)| held == tag)
+            })
+            .map(|field| SmolStr::new(field.name()))
+    };
+    let names: Vec<(i32, Option<SmolStr>)> =
+        [279, 269, 270, 271, 1026, 1027, 278, 280, 37, 290, 55, 54]
+            .into_iter()
+            .map(|tag| (tag, member(tag)))
+            .collect();
+    let mut occurrences = Vec::with_capacity(children.len());
+    for child in children {
+        let book = child.book();
+        let side = child.get_side();
+        let identifier = |kind: &crate::IdType| {
+            child
+                .get_identifiers()
+                .get(kind)
+                .map(|held| Scalar::from(held.to_owned()))
+        };
+        let value = |tag: i32| -> Option<Scalar> {
+            let text = |value: Decimal| Scalar::from(value.to_string());
+            match tag {
+                279 => book
+                    .and_then(|book| book.action)
+                    .filter(|action| *action != MdUpdateAction::Snapshot)
+                    .map(|action| Scalar::from(action.as_str())),
+                269 => match child.marketdatakind() {
+                    MarketDataKind::Execution => Some(Scalar::from("2")),
+                    _ if side.is_bid() => Some(Scalar::from("0")),
+                    _ if side.is_ask() => Some(Scalar::from("1")),
+                    _ => None,
+                },
+                270 => book
+                    .and_then(|book| book.entry_px)
+                    .or_else(|| child.get_price())
+                    .map(text),
+                271 => book
+                    .and_then(|book| book.entry_size)
+                    .or_else(|| child.get_quantity())
+                    .map(text),
+                1026 => child.get_spotrate().map(text),
+                1027 => child.get_forwardpoints().map(text),
+                278 => identifier(&ENTRY_ID),
+                280 => identifier(&ENTRY_REF_ID),
+                37 => identifier(&crate::IdType::OrderId),
+                290 => book
+                    .and_then(|book| book.position)
+                    .map(|position| Scalar::from(position.to_string())),
+                55 => child.get_ticker().map(Scalar::from),
+                54 if child.marketdatakind() == MarketDataKind::Execution => {
+                    side.fix_code().map(|code| Scalar::from(code.to_string()))
+                }
+                _ => None,
+            }
+        };
+        let members: Vec<(SmolStr, Scalar)> = names
+            .iter()
+            .filter_map(|(tag, name)| Some((name.clone()?, value(*tag)?)))
+            .collect();
+        occurrences.push(Scalar::from_struct(members)?);
+    }
+    Ok(Scalar::from_sequence(occurrences))
+}
