+## Land a message and split it into leaves
+
+`graph.MarketMessage` is the one message every protocol lands in: its facts by
+column name, what it states beyond them as entries under one root, the
+elements it states as children; it pickles through its own row form.
+
+```python
+import pickle
+
+from yggdryl import DataType, Field, MarketDataKind, graph
+
+root = Field("entries", DataType.from_fields([Field("feed", "utf8")]), nullable=False)
+control = graph.BookRef(action="snapshot", scope="Symbol=ACME")
+levels = [
+    graph.MarketMessage(1_700_000_000_000_000_000, "QUOT", side=side, price=price)
+    for side, price in (("BUYS", 99), ("SELL", 101))
+]
+book = graph.MarketMessage(
+    1_700_000_000_000_000_000, "BOOK", root=root, row={"feed": "MDP"}, children=levels, ticker="ACME", book=control
+)
+assert book.entry("feed").as_py() == "MDP"
+assert pickle.loads(pickle.dumps(book)) == book
+
+value = graph.MarketData(book)
+assert value.kind == "message" and value.as_message() == book
+leaves = book.into_market_data()
+assert [leaf.kind for leaf in leaves] == ["quote_event", "quote_event"]
+assert all(leaf.ticker == "ACME" for leaf in leaves)
+assert book.marketdatakind is MarketDataKind.BOOK
+```
