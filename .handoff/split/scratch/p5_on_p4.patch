+/// The entry root the tests state entries under: two nullable children.
+fn root() -> Arc<Field> {
+    Arc::new(
+        DataType::from(
+            StructType::from_fields([
+                DataType::utf8().nullable_field("text"),
+                DataType::Int64.nullable_field("venueseq"),
+            ])
+            .expect("two children"),
+        )
+        .required_field("entries"),
+    )
+}
+
+/// A run under [`root`].
+fn entries(text: &str, venueseq: i64) -> Scalar {
+    Scalar::from_sequence([Scalar::from(text), Scalar::from(venueseq)])
+}
+
+/// A finalized order message on `ACME`: a buy of two at a hundred.
+fn order(unix: i64, code: &str) -> MarketMessage {
+    let mut order = MarketMessage::new(MarketDataKind::Order);
+    order.set_transunix(unix);
+    order.set_crosscode(code.to_owned());
+    order.set_ticker(Some(SmolStr::new("ACME")), true);
+    order.set_side(Side::Buy, true);
+    order.set_price(Some(Decimal::from_int(100)), true);
+    order.set_quantity(Some(Decimal::from_int(2)), true);
+    order.finalize();
+    order
+}
+
+/// A level of a book message: one quote on `side` at `price`, dated `unix`.
+fn level(unix: i64, side: Side, price: i64) -> MarketMessage {
+    let mut level = MarketMessage::new(MarketDataKind::Quotation);
+    level.set_transunix(unix);
+    level.set_side(side, true);
+    level.set_price(Some(Decimal::from_int(price)), true);
+    level.set_book(Some(BookRef {
+        action: Some(MdUpdateAction::New),
+        ..BookRef::default()
+    }));
+    level
+}
+
+/// A book message on `ACME` dated `unix`, stating no level yet.
+fn book(unix: i64) -> MarketMessage {
+    let mut book = MarketMessage::new(MarketDataKind::Book);
+    book.set_transunix(unix);
+    book.set_ticker(Some(SmolStr::new("ACME")), true);
+    book.set_currency(yggdryl::Ccy::new("USD").expect("a currency"), true);
+    book.set_book(Some(BookRef {
+        action: Some(MdUpdateAction::Snapshot),
+        scope: Some(SmolStr::new("Symbol=ACME")),
+        ..BookRef::default()
+    }));
+    book
+}
+
+fn refused_at(error: &Error) -> &str {
+    match error {
+        Error::InvalidRecord { path, .. } => path,
+        other => panic!("expected a located refusal, got {other}"),
+    }
+}
+
+fn hash_of<T: Hash>(value: &T) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    value.hash(&mut hasher);
+    hasher.finish()
+}
