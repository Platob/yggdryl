+/// A message's elements are one level deep and stand under one root.
+#[test]
+fn a_child_is_refused_where_it_has_children_or_another_root() {
+    let mut parent = book(1);
+    let mut nested = level(1, Side::Buy, 99);
+    nested.push_child(level(1, Side::Buy, 98)).unwrap();
+    let error = parent.push_child(nested).unwrap_err();
+    assert_eq!(refused_at(&error), "$.children", "{error}");
