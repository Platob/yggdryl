+/// The codec reading the three capture names a session event's identity
+/// joins.
+fn session_codec() -> FixCodec {
+    codec().with_capture_names(["msgsessionid", "msgctxid", "msgseqnum"])
+}
+
+/// One observation of the delivery `SESSION-A`, sequence 7, under
+/// `context`: `body` captured at `sendunix`, executed at `execunix`.
+fn session_observation(
+    codec: &FixCodec,
+    context: &[u8],
+    body: &[u8],
+    sendunix: i64,
+    execunix: i64,
+) -> FixMsg {
+    let line = TextLine::from_bytes(
+        sendunix as u64,
+        TextBytes::from_bytes(body).unwrap(),
+        Arc::new(yggdryl::text::TextOptions::new()),
+    )
+    .unwrap()
+    .with_captures(vec![
+        Some(TextBytes::from_bytes(b"SESSION-A").unwrap()),
+        Some(TextBytes::from_bytes(context).unwrap()),
+        Some(TextBytes::from_bytes(b"7").unwrap()),
+    ])
+    .unwrap()
+    .with_handle_mtime(sendunix);
+    let mut message = codec
+        .parse_text_line(&line)
+        .unwrap()
+        .next()
+        .unwrap()
+        .unwrap();
+    message.message_mut().set_execunix(Some(execunix), true);
+    message
+}
