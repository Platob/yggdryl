diff --git a/rust/benchmarks/graph/message.rs b/rust/benchmarks/graph/message.rs
new file mode 100644
index 000000000..c15706cfd
--- /dev/null
+++ b/rust/benchmarks/graph/message.rs
@@ -0,0 +1,140 @@
+//! The market message: what a message costs to split into the market data
+//! it states - one direct leaf, its facts moved, or a book message's levels,
+//! each a leaf of its own - to read one entry by its name, and to cross its
+//! own row form both ways.
+
+use std::hint::black_box;
+use std::sync::Arc;
+
+use criterion::{BatchSize, Criterion, Throughput};
+use yggdryl::graph::{BookRef, Element, Event, Market, MarketMessage, MdUpdateAction};
+use yggdryl::{DataType, Decimal, MarketDataKind, Scalar, Side, StructType};
+
+/// How many entries the widest message states beyond its facts.
+const ENTRIES: usize = 128;
+
+/// An order stating its facts alone and no entry.
+fn order() -> MarketMessage {
+    let mut message = MarketMessage::new(MarketDataKind::Order);
+    message.set_transunix(1);
+    message.set_crosscode("ORDER-1".to_owned());
+    message.set_ticker(Some("BENCH".into()), true);
+    message.set_side(Side::Buy, true);
+    message.set_price(Some(Decimal::from_int(100)), true);
+    message.set_quantity(Some(Decimal::from_int(5)), true);
+    message.finalize();
+    message
+}
+
+/// The order of [`order`] stating [`ENTRIES`] text entries under one
+/// shared root, as a codec states what it read beyond the facts.
+fn with_entries() -> MarketMessage {
+    let root = Arc::new(
+        DataType::from(
+            StructType::from_fields(
+                (0..ENTRIES).map(|at| DataType::utf8().nullable_field(format!("entry{at:03}"))),
+            )
+            .expect("unique entry names"),
+        )
+        .required_field("entries"),
+    );
+    let row = Scalar::from_sequence((0..ENTRIES).map(|at| Scalar::from(format!("value{at}"))));
+    let mut message = order()
+        .try_with_entries(root, row)
+        .expect("the entries fit their root");
+    message.finalize();
+    message
+}
+
+/// A full refresh of `levels` levels a side, each a child quote under the
+/// book control the message states, the ticker the message's alone.
+fn book(levels: usize) -> MarketMessage {
+    let control = BookRef {
+        action: Some(MdUpdateAction::Snapshot),
+        scope: Some("Symbol=BENCH".into()),
+        ..BookRef::default()
+    };
+    let mut message = MarketMessage::new(MarketDataKind::Book);
+    message.set_transunix(1);
+    message.set_ticker(Some("BENCH".into()), true);
+    message.set_book(Some(control.clone()));
+    for level in 0..levels {
+        let offset = i64::try_from(level).expect("a bench corpus");
+        for (side, price) in [
+            (Side::Buy, 100_000 - offset),
+            (Side::Sell, 100_001 + offset),
+        ] {
+            let mut child = MarketMessage::new(MarketDataKind::Quotation);
+            child.set_side(side, true);
+            child.set_price(Some(Decimal::from_int(price)), true);
+            child.set_quantity(Some(Decimal::from_int(1)), true);
+            child.set_book(Some(control.clone()));
+            message.push_child(child).expect("one level deep, one root");
+        }
+    }
+    message.finalize();
+    message
+}
+
+pub fn benchmarks(criterion: &mut Criterion) {
+    let mut group = criterion.benchmark_group("graph/message");
+    group.throughput(Throughput::Elements(1));
+
+    // A direct leaf: the facts box moved into the order, nothing built.
+    let direct = order();
+    group.bench_function("into_market_leaf", |bencher| {
+        bencher.iter_batched(
+            || direct.clone(),
+            |message| {
+                black_box(message)
+                    .into_market_leaf()
+                    .expect("one order leaf")
+            },
+            BatchSize::SmallInput,
+        );
+    });
+
+    // One entry by its exact name: an index of the root and one cell read.
+    let wide = with_entries();
+    let last = format!("entry{:03}", ENTRIES - 1);
+    assert!(wide.entry(&last).is_some(), "the root holds the entry");
+    group.bench_function(format!("entry_of_{ENTRIES}"), |bencher| {
+        bencher.iter(|| black_box(&wide).entry(black_box(&last)).is_some());
+    });
+
+    // The row form both ways: every fact column, the entries and the rest
+    // as one row, and the message that row states again.
+    let row = wide.into_scalar();
+    let root = Arc::clone(wide.root());
+    assert_eq!(
+        MarketMessage::from_scalar(Arc::clone(&root), None, &row).expect("the row form"),
+        wide,
+        "the row form restates the message"
+    );
+    group.bench_function(format!("into_scalar_{ENTRIES}"), |bencher| {
+        bencher.iter(|| black_box(&wide).into_scalar());
+    });
+    group.bench_function(format!("from_scalar_{ENTRIES}"), |bencher| {
+        bencher.iter(|| {
+            MarketMessage::from_scalar(Arc::clone(&root), None, black_box(&row))
+                .expect("the row form")
+        });
+    });
+
+    // A book message's levels, each a leaf: the message's facts carried
+    // into what a level states nothing of, the last level moving them.
+    for levels in [16, crate::bench_profile::corpus(512, 4)] {
+        let refresh = book(levels);
+        group.throughput(Throughput::Elements(
+            2 * u64::try_from(levels).expect("a bench corpus"),
+        ));
+        group.bench_function(format!("into_market_data_children_{levels}"), |bencher| {
+            bencher.iter_batched(
+                || refresh.clone(),
+                |message| black_box(message).into_market_data().len(),
+                BatchSize::LargeInput,
+            );
+        });
+    }
+    group.finish();
+}
