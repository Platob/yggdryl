+#[test]
+fn a_new_message_states_its_category_alone() {
+    let message = MarketMessage::new(MarketDataKind::Quotation);
+    assert_eq!(message.marketdatakind(), MarketDataKind::Quotation);
+    assert_eq!(message.stated(), StatedFacts::KIND);
+    assert_eq!(message.root().name(), "entries");
