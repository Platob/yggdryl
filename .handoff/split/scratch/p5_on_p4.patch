+        let mut fields: Vec<String> = String::from_utf8(wire)
+            .expect("a text wire")
+            .split('|')
+            .map(str::to_owned)
+            .collect();
+        fields.sort_unstable();
+        fields
+    };
+    assert_eq!(fields(back.into_bytes(b'|')), fields(order.into_bytes(b'|')));
