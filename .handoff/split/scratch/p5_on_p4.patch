+// ------------------------------------------------------------------------
+// The leaves a message states
+// ------------------------------------------------------------------------
+
+/// A message stating no children is one leaf of its category, its facts
+/// moved: an order, a quote, an execution - which reads `FILLED` unless it
+/// was canceled - or a full refresh's snapshot control.
+#[test]
+fn a_message_stating_no_children_is_the_one_leaf_of_its_category() {
+    let leaf = order(1, "O-1").into_market_leaf().unwrap();
+    assert_eq!(leaf.kind(), MarketKind::OrderEvent);
+    assert_eq!(leaf.get_price(), Some(Decimal::from_int(100)));
+    assert_eq!(leaf.get_side(), Side::Buy);
+
+    let mut quote = order(1, "Q-1");
+    quote.set_marketdatakind(MarketDataKind::Quotation);
+    assert_eq!(
+        quote.into_market_leaf().unwrap().kind(),
+        MarketKind::QuoteEvent
+    );
+
+    let mut fill = order(1, "O-1");
+    fill.set_marketdatakind(MarketDataKind::Execution);
+    fill.set_state(State::New);
+    let leaf = fill.into_market_leaf().unwrap();
+    assert_eq!(leaf.kind(), MarketKind::ExecutionEvent);
+    assert_eq!(
+        *leaf.as_execution_event().unwrap().get_state(),
+        State::Filled
+    );
+
+    let mut canceled = order(1, "O-1");
+    canceled.set_marketdatakind(MarketDataKind::Execution);
+    canceled.set_state(State::Canceled);
+    let leaf = canceled.into_market_leaf().unwrap();
+    assert_eq!(
+        *leaf.as_execution_event().unwrap().get_state(),
+        State::Canceled
+    );
+
+    // An empty full refresh is its scoped snapshot control.
+    let snapshot = book(7).into_market_leaf().unwrap();
+    assert_eq!(snapshot.kind(), MarketKind::SnapshotEvent);
+    assert_eq!(
+        snapshot.book().and_then(|control| control.action),
+        Some(MdUpdateAction::Snapshot)
+    );
+    assert_eq!(
+        snapshot.get_crosscode(),
+        "3:0:Symbol=ACME|BookSnapshot=empty",
+        "stored under the book's category"
+    );
+    assert_eq!(
+        *snapshot.as_snapshot_event().unwrap().get_state(),
+        State::New
+    );
+}
