+            .clone()
+            .into_market_data()
+            .into_iter()
+            .map(PyMarketData::from_core)
+            .collect()
+    }
+
+    /// The one market data leaf the message is; a message stating none, or
+    /// more than one, is a `ValueError` naming what it states.
+    #[allow(clippy::wrong_self_convention)] // The core's own name, over `&self`: frozen, never moved.
+    fn into_market_leaf(&self) -> PyResult<PyMarketData> {
+        self.inner
+            .clone()
+            .into_market_leaf()
+            .map(PyMarketData::from_core)
+            .map_err(value_error)
+    }
+
+    /// The message's own row form under the entry root `root`, its
+    /// children's entries under `child_root` - the empty root where `None`:
+    /// the fact columns in `marketdata` order, then `stated`,
+    /// `acknowledgement`, `book` and `instrument`, then the root's children,
+    /// then `children` and `anomalies`. No protocol's row: what pickle
+    /// carries a message by.
+    #[staticmethod]
+    #[pyo3(signature = (root, child_root=None))]
+    fn field(root: &Bound<'_, PyAny>, child_root: Option<&Bound<'_, PyAny>>) -> PyResult<PyField> {
+        let root = core_field_from_value(root)?;
+        let child_root = child_root.map(core_field_from_value).transpose()?;
+        CoreMarketMessage::field(&root, child_root.as_ref())
+            .map(PyField::from_inner)
+            .map_err(value_error)
+    }
+
+    /// The message as one row of `MarketMessage.field(root, child_root)`
+    /// under its own roots, as the ordered cells `from_scalar` reads back.
+    #[allow(clippy::wrong_self_convention)] // The core's own name, over `&self`: frozen, never moved.
+    fn into_scalar(&self) -> PyScalar {
+        PyScalar::from_inner(self.inner.into_scalar())
+    }
+
+    /// The message one row of the row form states - the ordered cells
+    /// `into_scalar` answers, as a `Scalar` or anything the boundary reads
+    /// as one - its entries canonicalized under `root` and each child's
+    /// under `child_root`, the empty root where `None`: the facts recorded
+    /// exactly, nothing settled again.
+    #[staticmethod]
+    #[pyo3(signature = (root, child_root, row))]
+    fn from_scalar(
+        root: &Bound<'_, PyAny>,
+        child_root: Option<&Bound<'_, PyAny>>,
+        row: &Bound<'_, PyAny>,
+    ) -> PyResult<Self> {
+        let root = root_of(root)?;
+        let child_root = child_root.map(root_of).transpose()?;
