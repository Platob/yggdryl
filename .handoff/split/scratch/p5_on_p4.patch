+/// The `MsgType(35)` a message no FIX parse built is written under: an
+/// order or an execution is an `ExecutionReport` (`8`) - the one type that
+/// reports any step of either - a quote a `Quote` (`S`), a book a
+/// `MarketDataSnapshotFullRefresh` (`W`), a trade a `TradeCaptureReport`
+/// (`AE`); any other category has no type that states it alone, and its
+/// crate tag says what it is. The inverse, for these, of the category a
+/// type files under and of the state [`super::state::from_msgtype`] reads
+/// off one.
+pub(super) fn msgtype_for_kind(kind: MarketDataKind) -> Option<&'static str> {
+    match kind {
+        MarketDataKind::Order | MarketDataKind::Execution => Some("8"),
+        MarketDataKind::Quotation => Some("S"),
+        MarketDataKind::Book => Some("W"),
+        MarketDataKind::Trade => Some("AE"),
+        _ => None,
+    }
+}
