+impl Eq for MarketMessage {}
+
+impl Hash for MarketMessage {
+    /// Hashes the settled code, the root's name and arity - never the whole
+    /// schema, which equal messages hold alike - the entries, the children,
+    /// the anomalies, the instrument statement, the book control and the
+    /// acknowledgement: equal messages hash alike.
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.facts.get_hashcode().hash(state);
+        self.root.name().hash(state);
+        self.root.field_len().hash(state);
+        self.row.hash(state);
+        self.children.hash(state);
+        self.anomalies.hash(state);
+        self.instrument.hash(state);
+        self.acknowledgement.hash(state);
+        if let Some(book) = self.book.as_deref() {
+            book.action.hash(state);
+            book.scope.hash(state);
+            book.position.hash(state);
+            book.entry_px.hash(state);
+            book.entry_size.hash(state);
+        }
+    }
+}
