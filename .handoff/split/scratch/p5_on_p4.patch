+
+    let mut bare = book(1);
+    bare.set_book(None);
+    assert!(bare.into_market_data().is_empty());
+
+    for kind in [
+        MarketDataKind::Trade,
+        MarketDataKind::OrderBatch,
+        MarketDataKind::Unknown,
+    ] {
