diff --git a/rust/tests/graph/anomaly.rs b/rust/tests/graph/anomaly.rs
new file mode 100644
index 000000000..35d6f9fb5
--- /dev/null
+++ b/rust/tests/graph/anomaly.rs
@@ -0,0 +1,68 @@
+//! `rust/src/graph/anomaly.rs`: what a message states that its reading
+//! could not take as it stands - the field it was stated under and why -
+//! kept beside the message's facts and never one of them.
+
+use std::collections::BTreeSet;
+
+use yggdryl::MarketDataKind;
+use yggdryl::graph::{Anomaly, MarketMessage};
+
+#[test]
+fn an_anomaly_is_its_field_and_its_reason_and_displays_as_both() {
+    let anomaly = Anomaly::new("stoppx", "\"abc\" is no decimal");
+    assert_eq!(anomaly.field(), "stoppx");
+    assert_eq!(anomaly.reason(), "\"abc\" is no decimal");
+    assert_eq!(anomaly.to_string(), "stoppx: \"abc\" is no decimal");
+    // An empty reason is still a reason: the display keeps the separator.
+    assert_eq!(Anomaly::new("crosscode", "").to_string(), "crosscode: ");
+}
+
+#[test]
+fn two_anomalies_are_one_where_field_and_reason_both_agree() {
+    let one = Anomaly::new("crosscode", "cites 10:1:A and 10:1:B");
+    assert_eq!(one, one.clone());
+    assert_ne!(one, Anomaly::new("crosscode", "cites 10:1:A and 10:1:C"));
+    assert_ne!(one, Anomaly::new("securityid", one.reason()));
+    // Ordered by field, then by reason: a set of them is deterministic.
+    let ordered: BTreeSet<Anomaly> = [
+        Anomaly::new("stoppx", "b"),
+        Anomaly::new("crosscode", "z"),
+        Anomaly::new("stoppx", "a"),
+    ]
+    .into_iter()
+    .collect();
+    let spelled: Vec<String> = ordered.iter().map(Anomaly::to_string).collect();
+    assert_eq!(spelled, ["crosscode: z", "stoppx: a", "stoppx: b"]);
+}
+
+/// A message keeps each anomaly once, in the order noted: a second note of
+/// the same field and reason adds nothing, and the anomalies are never a
+/// fact - the identity a message settles is the same with and without them.
+#[test]
+fn a_message_keeps_each_anomaly_once_beside_its_facts() {
+    use yggdryl::graph::Element;
+
+    let mut message = MarketMessage::new(MarketDataKind::Order);
+    message.finalize();
+    let settled = message.get_hashcode();
+
+    message.note_anomaly(Anomaly::new("stoppx", "abc"));
+    message.note_anomaly(Anomaly::new("crosscode", "cites two chains"));
+    message.note_anomaly(Anomaly::new("stoppx", "abc"));
+    assert_eq!(
+        message.anomalies(),
+        [
+            Anomaly::new("stoppx", "abc"),
+            Anomaly::new("crosscode", "cites two chains"),
+        ]
+    );
+    message.finalize();
+    assert_eq!(
+        message.get_hashcode(),
+        settled,
+        "no anomaly is a digest input"
+    );
+
+    message.set_anomalies(Vec::new());
+    assert!(message.anomalies().is_empty());
+}
