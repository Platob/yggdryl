+impl PartialEq for MarketMessage {
+    /// Two messages are equal when they state the same facts, the same
+    /// stated bits, the same entries under the same root - one `Arc`, or
+    /// roots that are equal - the same children, anomalies, instrument
+    /// statement, book control and acknowledgement.
+    fn eq(&self, other: &Self) -> bool {
+        self.facts == other.facts
+            && self.stated == other.stated
+            && (Arc::ptr_eq(&self.root, &other.root) || self.root == other.root)
+            && self.row == other.row
+            && self.children == other.children
+            && self.anomalies == other.anomalies
+            && self.instrument == other.instrument
+            && self.book == other.book
+            && self.acknowledgement == other.acknowledgement
+    }
+}
