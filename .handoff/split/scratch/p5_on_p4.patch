+/// The projection reads messages sorted by time into the leaves they state:
+/// a refused message is passed over, and the source's own failure ends it
+/// after every leaf before it.
+#[test]
+fn the_projection_passes_over_a_refusal_and_ends_at_a_source_failure() {
+    let source: Vec<yggdryl::Result<MarketMessage>> = vec![
+        Ok(order(1, "O-1")),
+        Err(Error::absent("a message", "$.side")),
+        Ok(order(2, "O-2")),
+        Err(Error::Io(std::io::Error::other("cut"))),
+        Ok(order(3, "O-3")),
+    ];
+    let mut leaves = MessageIterator::new(source.into_iter());
+    let codes: Vec<String> = leaves
+        .by_ref()
+        .take(2)
+        .map(|leaf| leaf.unwrap().get_crosscode().to_owned())
+        .collect();
+    assert_eq!(codes.len(), 2);
+    assert!(
+        codes[0].ends_with("O-1") && codes[1].ends_with("O-2"),
+        "{codes:?}"
+    );
+    let failure = leaves.next().expect("the failure").unwrap_err();
+    assert!(failure.is_source_failure(), "{failure}");
+    assert!(leaves.next().is_none(), "fused");
+    assert!(leaves.next().is_none());
+}
+
+// ------------------------------------------------------------------------
+// Walk and merge
+// ------------------------------------------------------------------------
+
+/// A message follows and merges as the operation it is, over its facts:
+/// its entries and children stay its own, and a merge folds the other
+/// statement's anomalies in, each once.
+#[test]
+fn a_message_follows_and_merges_as_its_facts() {
+    let first = order(1_000_000, "O-1");
+    let second = order(2_000_000, "O-1")
+        .try_with_entries(root(), entries("second", 2))
+        .unwrap();
+    let followed = second
+        .clone()
+        .with_previous(&first)
+        .expect("a later step of one chain follows");
+    assert_eq!(followed.get_prevuuid(), Some(first.get_uuid()));
+    assert_eq!(followed.row(), second.row(), "its entries are its own");
+    assert!(followed.is_after(&first));
+
+    let mut restated = first.clone();
+    restated.set_srcuuids(vec![Uuid::from_v8(9)]);
+    restated.note_anomaly(Anomaly::new("stoppx", "abc"));
+    let mut noted = first.clone();
+    noted.note_anomaly(Anomaly::new("stoppx", "abc"));
+    let merged = noted
+        .merge_with(&restated)
+        .expect("another statement of the same order adds its source");
+    assert_eq!(merged.get_srcuuids(), [Uuid::from_v8(9)]);
+    assert_eq!(merged.anomalies(), [Anomaly::new("stoppx", "abc")], "once");
+    assert!(
+        first.clone().merge_with(&second).is_none(),
+        "another identity merges nothing"
+    );
+}
+
+/// The walk's conflict is kept beside the message, under `crosscode`.
+#[test]
+fn a_conflict_is_an_anomaly_under_crosscode() {
+    let mut message = order(1, "O-1");
+    message.note_conflict("10:1:A, 10:1:B");
+    message.note_conflict("10:1:A, 10:1:B");
+    assert_eq!(
+        message.anomalies(),
+        [Anomaly::new("crosscode", "10:1:A, 10:1:B")]
+    );
+}
+
+// ------------------------------------------------------------------------
+// The row form
+// ------------------------------------------------------------------------
+
+/// The row form: the fact columns in `marketdata` order, the message's own
+/// four, the root's children, `children` and `anomalies`.
+#[test]
+fn the_row_form_is_the_facts_then_the_messages_own_then_the_entries() {
+    let entry_root = root();
+    let form = MarketMessage::field(&entry_root, None).unwrap();
+    assert_eq!(form.name(), "message");
+    assert!(!form.is_nullable());
+    let names: Vec<&str> = form.fields().iter().map(Field::name).collect();
+    let facts = ElementColumn::ALL.len()
+        + EventColumn::ALL.len()
+        + MarketColumn::ALL.len()
+        + OperationColumn::ALL.len();
+    assert_eq!(facts, 6 + 9 + 36 + 5);
+    let expected_facts: Vec<&str> = ElementColumn::ALL
+        .into_iter()
+        .map(ElementColumn::name)
+        .chain(EventColumn::ALL.into_iter().map(EventColumn::name))
+        .chain(MarketColumn::ALL.into_iter().map(MarketColumn::name))
+        .chain(OperationColumn::ALL.into_iter().map(OperationColumn::name))
+        .collect();
+    assert_eq!(names[..facts], expected_facts[..]);
+    assert_eq!(
+        names[facts..],
+        [
+            "stated",
+            "acknowledgement",
+            "book",
+            "instrument",
+            "text",
+            "venueseq",
+            "children",
+            "anomalies",
+        ]
+    );
+    // A child's form states no children of its own.
+    let children = &form.fields()[form.index_of("children").unwrap()];
+    assert!(children.is_nullable());
+    let serie = children.dtype().as_serie_type().expect("a serie");
+    let child = serie.item();
+    assert_eq!(child.name(), "child");
+    assert!(child.index_of("children").is_none());
+    assert!(child.index_of("anomalies").is_some());
+}
+
+/// `into_scalar` and `from_scalar` restate a message whole: its facts as
+/// recorded - identity included, nothing settled again - its stated facts,
+/// entries, children, anomalies, instrument statement, book control and
+/// acknowledgement.
+#[test]
+fn the_row_form_restates_a_message_whole() {
+    let mut message = book(10)
+        .try_with_entries(root(), entries("book", 1))
+        .unwrap();
+    message.push_child(level(10, Side::Buy, 99)).unwrap();
+    message.push_child(level(11, Side::Sell, 101)).unwrap();
+    message.note_anomaly(Anomaly::new("stoppx", "abc"));
+    message.set_instrument(InstrumentStatement {
+        eusipacode: Some(Eusipa::new(1300).unwrap()),
+        ..InstrumentStatement::default()
+    });
+    message.finalize();
+
+    let row = message.into_scalar();
+    let child_root = Arc::clone(message.children()[0].root());
+    let back =
+        MarketMessage::from_scalar(Arc::clone(message.root()), Some(child_root), &row).unwrap();
+    assert_eq!(back, message);
+    assert_eq!(back.get_uuid(), message.get_uuid(), "nothing settled again");
+    assert_eq!(back.stated(), message.stated());
+    assert_eq!(back.children().len(), 2);
+    assert_eq!(back.children()[1].get_side(), Side::Sell);
+    assert_eq!(back.anomalies(), message.anomalies());
+    assert_eq!(back.instrument(), message.instrument());
+    assert_eq!(back.book(), message.book());
+
+    // The row is a value of the form.
+    let form = MarketMessage::field(message.root(), Some(&**message.children()[0].root())).unwrap();
+    assert!(form.scalar(row.clone()).is_ok());
+
+    let mut ack = order(1, "O-1");
+    ack.set_acknowledgement(true);
+    let back =
+        MarketMessage::from_scalar(Arc::clone(ack.root()), None, &ack.into_scalar()).unwrap();
+    assert!(back.is_acknowledgement());
+    assert_eq!(back, ack);
+}
+
+// ------------------------------------------------------------------------
+// Identity
+// ------------------------------------------------------------------------
+
+/// The identity digests the facts, the category, the entries, the book
+/// control, the instrument statement and the children - never the
+/// anomalies; equality and the hash read every part, and equal messages
+/// hash alike.
+#[test]
+fn equal_messages_hash_alike_and_every_part_takes_part() {
+    let mut message = order(1, "O-1")
+        .try_with_entries(root(), entries("hello", 7))
+        .unwrap();
+    message.finalize();
+    let mut twin = order(1, "O-1")
+        .try_with_entries(root(), entries("hello", 7))
+        .unwrap();
+    twin.finalize();
+    assert!(!Arc::ptr_eq(message.root(), twin.root()));
+    assert_eq!(message, twin, "two equal roots are one root");
+    assert_eq!(hash_of(&message), hash_of(&twin));
+    assert_eq!(message.stable_hash(), twin.stable_hash());
+
+    // An entry is content: it moves the settled code - once the held code
+    // is let go of, since a finalize keeps the code a message holds.
+    let mut other = message.clone();
+    other.set_entry("text", Scalar::from("bye")).unwrap();
+    other.set_hashcode(0);
+    other.finalize();
+    assert_ne!(other, message);
+    assert_ne!(other.get_hashcode(), message.get_hashcode());
+    assert_ne!(other.stable_hash(), message.stable_hash());
+
+    // An anomaly is no content: the code stands, equality does not.
+    let mut noted = message.clone();
+    noted.note_anomaly(Anomaly::new("stoppx", "abc"));
+    noted.finalize();
+    assert_eq!(noted.get_hashcode(), message.get_hashcode());
+    assert_ne!(noted, message);
+
+    // A child is content.
+    let mut parent = book(1);
+    parent.finalize();
+    let bare = parent.get_hashcode();
+    parent.push_child(level(1, Side::Buy, 99)).unwrap();
+    parent.set_hashcode(0);
+    parent.finalize();
+    assert_ne!(parent.get_hashcode(), bare);
+}
+
+/// A message is market data as it is: held whole, it answers every reading
+/// through its facts, lends itself back, and converts back to itself.
+#[test]
+fn a_message_is_held_whole_and_converts_back() {
+    let message = order(1, "O-1");
+    let held = MarketData::from(message.clone());
+    assert_eq!(held.kind(), MarketKind::Message);
+    assert!(held.is_event());
+    assert_eq!(held.marketdatakind(), MarketDataKind::Order);
+    assert_eq!(held.get_uuid(), message.get_uuid());
+    assert_eq!(held.as_message(), Some(&message));
+    assert_eq!(MarketMessage::try_from(held).unwrap(), message);
+}
