+
+/// The round trip: a market message rendered as one FIX frame
+/// ([`FixCodec::render`]) and that frame parsed again restates the message -
+/// its facts, what its source stated, its entries, its metadata and its
+/// children - whether a parse built it or a caller did.
+mod round_trip {
+    use std::sync::Arc;
+
+    use yggdryl::graph::{
+        BookRef, Element, ElementColumn, Event, EventColumn, Market, MarketColumn, MarketMessage,
+        MdUpdateAction, Operation, OperationColumn,
+    };
+    use yggdryl::{
+        DataType, Decimal, Field, FixCodec, MarketDataKind, Scalar, Side, State, StructType,
+        TimeInForce,
+    };
+
+    use super::super::SoleMessage;
+
+    /// Every fact a message states, column by column: its identity where
+    /// `identity`, else every fact but the two its entries digest into.
+    fn facts_of(message: &MarketMessage, identity: bool) -> Vec<(&'static str, Option<Scalar>)> {
+        let mut facts: Vec<(&'static str, Option<Scalar>)> = ElementColumn::ALL
+            .into_iter()
+            .filter(|column| identity || !matches!(column.name(), "uuid" | "hashcode"))
+            .map(|column| (column.name(), column.fact(message)))
+            .collect();
+        facts.extend(
+            EventColumn::ALL
+                .into_iter()
+                .map(|column| (column.name(), column.fact(message))),
+        );
+        facts.extend(
+            MarketColumn::ALL
+                .into_iter()
+                .map(|column| (column.name(), column.fact(message))),
+        );
+        facts.extend(
+            OperationColumn::ALL
+                .into_iter()
+                .map(|column| (column.name(), column.fact(message))),
+        );
+        facts
+    }
+
+    /// Every entry a message holds, each child under its name beside its
+    /// cell, by name: the place the wire lays a field at is the wire's -
+    /// the lifted band in front of the row, the trailer last - and does not
+    /// cross a render.
+    fn entries_of(message: &MarketMessage) -> Vec<(String, Field, Scalar)> {
+        let cells = message.row().as_sequence().unwrap_or_default();
+        let mut entries: Vec<(String, Field, Scalar)> = message
+            .root()
+            .fields()
+            .iter()
+            .zip(cells)
+            .map(|(child, cell)| (child.name().to_owned(), child.clone(), cell.clone()))
+            .collect();
+        entries.sort_by(|left, right| left.0.cmp(&right.0));
+        entries
+    }
+
+    /// `back` restates `message`: the facts, the stated bits, the entries,
+    /// and each child the same way.
+    #[track_caller]
+    fn restates(back: &MarketMessage, message: &MarketMessage) {
+        assert_eq!(facts_of(back, true), facts_of(message, true));
+        assert_eq!(back.stated(), message.stated());
+        assert_eq!(entries_of(back), entries_of(message));
+        assert_eq!(back.children().len(), message.children().len());
+        for (back, child) in back.children().iter().zip(message.children()) {
+            restates(back, child);
+        }
+    }
+
+    /// One message a line is, rendered and parsed again.
+    fn again(codec: &FixCodec, message: MarketMessage) -> MarketMessage {
+        let wire = codec.render(message).expect("a frame");
+        codec
+            .parse_fix_line(&wire)
+            .expect("the frame parses")
+            .into_message()
+    }
+
+    /// The refusal first: a message the registry cannot lay out - an entry
+    /// its field types refuse - is refused naming it, and no frame is
+    /// written.
+    #[test]
+    fn a_message_whose_entry_the_registry_refuses_renders_no_frame() {
+        let codec = super::codec();
+        let root = Arc::new(
+            DataType::from(
+                StructType::from_fields([DataType::utf8().nullable_field("OrderQty")]).unwrap(),
+            )
+            .required_field("entries"),
+        );
+        let message = MarketMessage::new(MarketDataKind::Order)
+            .try_with_entries(root, Scalar::from_sequence([Scalar::from("ten")]))
+            .unwrap();
+        let error = codec.render(message).unwrap_err().to_string();
+        assert!(
+            error.to_ascii_lowercase().contains("orderqty") || error.contains("38"),
+            "{error}"
+        );
+    }
+
+    /// A parsed message restates itself: an order, a quote, a report of no
+    /// fill and a full refresh whose two entries are its children - every
+    /// fact, every entry, each where the wire lays it out.
+    #[test]
+    fn a_parsed_message_rendered_and_parsed_again_restates_itself() {
+        let codec = super::codec();
+        for line in [
+            &b"8=FIX.4.4|35=D|49=B|56=S|34=1|52=20260921-10:00:00|11=C1|55=AAPL|54=1|38=10|40=2|44=101.5|59=0|10=0|"[..],
+            b"8=FIX.4.4|35=S|52=20260921-10:00:00|117=Q1|55=AAPL|15=USD|132=99|134=7|133=101|135=8|10=0|",
+            b"8=FIX.4.4|35=8|52=20260921-10:00:01|37=O1|11=C1|17=E1|150=0|39=0|54=1|55=AAPL|38=10|10=0|",
+            b"8=FIX.4.4|35=W|52=20260921-10:00:02|55=AAPL|268=2|269=0|270=99|271=5|269=1|270=101|271=7|10=0|",
+        ] {
+            let message = codec.sole_line(line).expect("one message").into_message();
+            let back = again(&codec, message.clone());
+            restates(&back, &message);
+            assert_eq!(back.get_metadata(), message.get_metadata());
+            assert_eq!(
+                back.anomalies(),
