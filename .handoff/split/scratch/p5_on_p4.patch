diff --git a/rust/src/graph/anomaly.rs b/rust/src/graph/anomaly.rs
new file mode 100644
index 000000000..468486303
--- /dev/null
+++ b/rust/src/graph/anomaly.rs
@@ -0,0 +1,62 @@
+//! [`Anomaly`]: what a message states that its reading could not take as
+//! it stands.
+//!
+//! A value that will not type is null rather than a failure, an alias
+//! stating another value than the field it lost to is kept aside, a settle
+//! drops a stated identifier that conflicts with a stated one, and a walk
+//! finds a statement citing two live chains: each is a fact about the
+//! message worth more than a null nobody can explain. An anomaly is that
+//! fact, read off the [`MarketMessage`](super::MarketMessage) beside its
+//! facts - never a fact column of a row, never a digest input.
+
+use std::fmt;
+
+use smol_str::SmolStr;
+
+/// One thing a message states that its reading could not take as it stands:
+/// the field it was stated under, and why.
+///
+/// ```
+/// use yggdryl::graph::Anomaly;
+///
+/// let anomaly = Anomaly::new("crosscode", "cites 10:1:A and 10:1:B");
+/// assert_eq!(anomaly.field(), "crosscode");
+/// assert_eq!(anomaly.reason(), "cites 10:1:A and 10:1:B");
+/// assert_eq!(anomaly.to_string(), "crosscode: cites 10:1:A and 10:1:B");
+/// ```
+#[derive(Clone, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct Anomaly {
+    field: SmolStr,
+    reason: SmolStr,
+}
+
+impl Anomaly {
+    /// An anomaly about `field`, for `reason`.
+    #[must_use]
+    pub fn new(field: impl Into<SmolStr>, reason: impl Into<SmolStr>) -> Self {
+        Self {
+            field: field.into(),
+            reason: reason.into(),
+        }
+    }
+
+    /// The field the message stated the value under: its protocol's name
+    /// for it, else the key as it arrived; `crosscode` for a walk's
+    /// conflict.
+    #[must_use]
+    pub fn field(&self) -> &str {
+        &self.field
+    }
+
+    /// Why the reading could not take the value as it stands.
+    #[must_use]
+    pub fn reason(&self) -> &str {
+        &self.reason
+    }
+}
+
+impl fmt::Display for Anomaly {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "{}: {}", self.field, self.reason)
+    }
+}
