--- /dev/null
+++ b/python/tests/graph/test_anomaly.py
@@ -0,0 +1,37 @@
+"""``graph.Anomaly``, what a message's reading could not take: `python/src/graph/anomaly.rs`."""
+
+from __future__ import annotations
+
+import copy
+import pickle
+
+from yggdryl import graph
+
+
+def test_an_anomaly_names_its_field_and_why() -> None:
+    anomaly = graph.Anomaly("crosscode", "cites 10:1:A and 10:1:B")
+    assert anomaly.field == "crosscode"
+    assert anomaly.reason == "cites 10:1:A and 10:1:B"
+    # The core's own spelling.
+    assert str(anomaly) == "crosscode: cites 10:1:A and 10:1:B"
+    assert repr(anomaly) == "Anomaly('crosscode', 'cites 10:1:A and 10:1:B')"
+
+
+def test_anomalies_compare_order_and_hash_by_field_then_reason() -> None:
+    first = graph.Anomaly("account", "z")
+    second = graph.Anomaly("partyid", "a")
+    assert first < second and second > first and first <= graph.Anomaly("account", "z")
+    assert sorted([second, first]) == [first, second]
+    assert graph.Anomaly("account", "z") == first and hash(graph.Anomaly("account", "z")) == hash(first)
+    assert first != graph.Anomaly("account", "y")
+    assert {first, graph.Anomaly("account", "z")} == {first}
+
+
+def test_an_anomaly_copies_and_pickles_as_itself() -> None:
+    anomaly = graph.Anomaly("strikeprice", "abc is no decimal")
+    assert pickle.loads(pickle.dumps(anomaly)) == anomaly
+    assert copy.copy(anomaly) == anomaly and copy.deepcopy(anomaly) == anomaly
+
+
+def test_a_native_message_states_none() -> None:
+    assert graph.MarketMessage(1, "ORDR").anomalies == []
