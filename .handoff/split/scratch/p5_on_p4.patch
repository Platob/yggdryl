@@ -0,0 +1,441 @@
+//! Native Python view of [`CoreMarketMessage`]: the one message every
+//! protocol lands in, and the one `MarketData` holds whole.
+//!
+//! A message is its facts - answered by the same getters every leaf
+//! answers - beside what it states beyond them: its entries under the
+//! protocol's entry root, its children, its book control, what it states of
+//! its instrument and its anomalies. Nothing here reads a protocol: the
+//! constructor states each named fact through its column, the entries go
+//! through the core's own `set_entries`, and every other door redirects to
+//! the core method of its name. Pickle carries the message's own row form
+//! (`MarketMessage::into_scalar`), its roots as documents.
+
+use std::sync::Arc;
+
+use pyo3::exceptions::PyTypeError;
+use pyo3::prelude::*;
+use pyo3::types::{PyBytes, PyDict};
+
+use yggdryl::graph::{Element, Event, Market, MarketKind, MarketMessage as CoreMarketMessage};
+use yggdryl::{Field as CoreField, MarketDataKind, MarketValue, Scalar};
+
+use super::anomaly::PyAnomaly;
+use super::market_data::PyMarketData;
+use super::operation::PyBookRef;
+use super::{ellipsis, state_facts};
+use crate::field::{PyField, core_field_from_value};
+use crate::fix::named_rows;
+use crate::scalar::{PyScalar, from_py};
+use crate::value_error;
+
+/// The class's name, as a refusal names its owner.
+const OWNER: &str = "MarketMessage";
+
+/// What [`PyMarketMessage::__reduce__`] hands pickle: the rebuilder and the
+/// entry root as JSON, the children's root as JSON where it states children,
+/// and the row form as the value stream encodes it.
+type MessagePickle = (Py<PyAny>, (String, Option<String>, Py<PyAny>));
+
+/// The category `kind` names - a `MarketDataKind` member, its code or any
+/// spelling the `marketdatakind` datatype reads - through that datatype's
+/// own value door.
+fn kind_of(kind: &Bound<'_, PyAny>) -> PyResult<MarketDataKind> {
+    let value = MarketDataKind::dtype()
+        .scalar(from_py(kind)?)
+        .map_err(value_error)?;
+    <MarketDataKind as MarketValue>::from_scalar(&value).ok_or_else(|| {
+        PyTypeError::new_err(format!("expected a market data kind, got {}", value.kind()))
+    })
+}
+
+/// The root a message's children stand under: the first child's, where it
+/// states one.
+fn child_root_of(message: &CoreMarketMessage) -> Option<Arc<CoreField>> {
+    message
+        .children()
+        .first()
+        .map(|child| Arc::clone(child.root()))
+}
+
+/// A root a caller handed over, as the shared field the core holds.
+fn root_of(root: &Bound<'_, PyAny>) -> PyResult<Arc<CoreField>> {
+    core_field_from_value(root).map(Arc::new)
+}
+
+/// One market message: the facts it states, typed, beside what it states
+/// beyond them - its entries under its protocol's entry root, the elements
+/// it states as children, its book control, what it states of its
+/// instrument and the anomalies its reading could not take. Immutable:
+/// every verb answers a new value.
+#[pyclass(
+    name = "MarketMessage",
+    module = "yggdryl._native",
+    frozen,
+    skip_from_py_object
+)]
+#[derive(Clone)]
+pub(crate) struct PyMarketMessage {
+    pub(crate) inner: CoreMarketMessage,
+}
+
+impl PyMarketMessage {
+    /// Wrap a value the core built.
+    pub(crate) const fn from_core(inner: CoreMarketMessage) -> Self {
+        Self { inner }
+    }
+}
+
+graph_methods!(PyMarketMessage, "MarketMessage"; [
+    element_getters, event_getters, market_getters, operation_getters, kind_getters
+]; {
+    /// A message of category `kind` at `transunix` nanoseconds since the
+    /// epoch, through the core's own `MarketMessage::new`: every named fact
+    /// in `facts` - keyed by column name, the event, market and operation
+    /// columns and the element's own `crosscode` and `srcuuids` - checked
+    /// by its column's field and stated through its column; `book`'s
+    /// control facts; the entries `row` states under `root` - any `Field`
+    /// spelling a non-null struct, `row` anything the `Scalar` boundary
+    /// reads as its row, a mapping by name, every entry it leaves out its
+    /// field's default - canonicalized once; then each of `children`, in
+    /// order; then finalized. A fact given as `...` is skipped and `None`
+    /// clears; a derived identity, the category, `transunix` again, an
+    /// entry named as a column the message states itself, or a `row`
+    /// without its `root`, is refused by name.
+    #[new]
+    #[pyo3(signature = (
+        transunix, kind, *, root=None, row=None, children=None, book=ellipsis(), **facts
+    ))]
+    #[allow(clippy::too_many_arguments)] // The constructor's own keywords, each one slot.
+    fn new(
+        py: Python<'_>,
+        transunix: i64,
+        kind: &Bound<'_, PyAny>,
+        root: Option<&Bound<'_, PyAny>>,
+        row: Option<&Bound<'_, PyAny>>,
+        children: Option<Vec<PyRef<'_, PyMarketMessage>>>,
+        book: Py<PyAny>,
+        facts: Option<&Bound<'_, PyDict>>,
+    ) -> PyResult<Self> {
+        let mut message = CoreMarketMessage::new(kind_of(kind)?);
+        message.set_transunix(transunix);
+        state_facts(OWNER, &mut message, facts, false)?;
+        let book = book.bind(py);
+        if !book.is(py.Ellipsis()) && !book.is_none() {
+            let book = book.extract::<PyRef<'_, PyBookRef>>().map_err(|_| {
+                PyTypeError::new_err("expected a BookRef for MarketMessage.book")
+            })?;
+            message.set_book(Some(book.inner.clone()));
+        }
+        match (root, row) {
+            (Some(root), row) => {
+                let root = root_of(root)?;
+                let row = match row {
+                    Some(row) => named_rows(&root, from_py(row)?),
+                    None => Scalar::from_struct(Vec::<(String, Scalar)>::new())
+                        .map_err(value_error)?,
+                };
+                message.set_entries(root, row).map_err(value_error)?;
+            }
+            (None, Some(_)) => {
+                return Err(PyTypeError::new_err(
+                    "MarketMessage.row is read under its root: name the root too",
+                ));
+            }
+            (None, None) => {}
+        }
+        for child in children.unwrap_or_default() {
+            message
+                .push_child(child.inner.clone())
+                .map_err(value_error)?;
+        }
+        message.finalize();
+        Ok(Self::from_core(message))
+    }
+
+    /// Which leaf this is, as its `MarketData.kinds` spelling: `"message"`.
+    #[getter]
+    fn kind(&self) -> &'static str {
+        MarketKind::Message.as_str()
+    }
+
+    /// The root the entries stand under: one `Field` a codec shares across
+    /// every message of its dictionary, an empty struct named `entries` for
+    /// a message stating none.
+    #[getter]
+    fn root(&self) -> PyField {
+        PyField::from_inner((**self.inner.root()).clone())
+    }
+
+    /// The entries: the ordered row under `root`, what `MarketMessage(...,
+    /// root=..., row=...)` takes back.
+    #[getter]
+    fn row(&self) -> PyScalar {
+        PyScalar::from_inner(self.inner.row().clone())
+    }
+
+    /// The entries as the row they are under `root`: each cell beside its
+    /// child's name, in the order the root declares.
+    fn record(&self) -> Vec<(String, PyScalar)> {
+        let record = self.inner.record();
+        record
+            .names()
+            .zip(record.iter())
+            .map(|(name, cell)| (name.to_owned(), PyScalar::from_inner(cell.value().clone())))
+            .collect()
+    }
+
+    /// The entry stated under `name` - an exact child name of the root -
+    /// a null `Scalar` where the message states nothing there; `None` where
+    /// the root holds no such child.
+    fn entry(&self, name: &str) -> Option<PyScalar> {
+        self.inner
+            .entry(name)
+            .map(|cell| PyScalar::from_inner(cell.into_value()))
+    }
+
+    /// The elements the message states - a book message's levels - each a
+    /// message of its own, one level deep, in order.
+    #[getter]
+    fn children(&self) -> Vec<Self> {
+        self.inner
+            .children()
+            .iter()
+            .cloned()
+            .map(Self::from_core)
+            .collect()
+    }
+
+    /// What the message states that its reading could not take as it
+    /// stands, in the order noted: never a fact, never a digest input.
+    #[getter]
+    fn anomalies(&self) -> Vec<PyAnomaly> {
+        self.inner
+            .anomalies()
+            .iter()
+            .cloned()
+            .map(PyAnomaly::from_core)
+            .collect()
+    }
+
+    /// What the message states of its instrument that is a registry fact
+    /// and no element fact, each key stated: `countrycode` (the `country`
+    /// code it was issued in) and `underlyingisin` (the `isin` it is
+    /// written on), each a code `Scalar` or `None`, and `eusipacode`, the
+    /// four-digit EUSIPA product category as an `int` or `None`.
+    #[getter]
+    fn instrument<'py>(&self, py: Python<'py>) -> PyResult<Bound<'py, PyDict>> {
+        let statement = self.inner.instrument();
+        let answer = PyDict::new(py);
+        answer.set_item(
+            "countrycode",
+            statement
+                .countrycode
+                .clone()
