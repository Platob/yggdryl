+//! [`MarketMessage`]: the one message every protocol lands in, and the one
+//! [`MarketData`] holds whole.
+//!
+//! A message is its facts - every element, event, market and operation
+//! fact, typed, the one owner of each - beside what it states beyond them:
+//! its entries, one ordered run under its protocol's entry root, which a
+//! reader reaches by exact name ([`MarketMessage::entry`]) or whole
+//! ([`MarketMessage::record`]); the elements it states as children - a book
+//! message's levels, each a message of its own; what its source stated
+//! ([`StatedFacts`]); the book control it states; what it states of its
+//! instrument that is no element fact ([`InstrumentStatement`]); and the
+//! [`Anomaly`] values its reading could not take. Nothing here names a
+//! protocol: a codec fills a message at parse, and every reading past it -
+//! a walk, a merge, the leaves it splits into - reads facts alone.
+
+use std::fmt;
+use std::hash::{Hash, Hasher};
+use std::iter::FusedIterator;
+use std::sync::{Arc, LazyLock};
+
+use smol_str::{SmolStr, format_smolstr};
+
+use super::anomaly::Anomaly;
+use super::book::SnapshotEvent;
+use super::facts::OperationEventFacts;
+use super::market::restating_operation;
+use super::market_data::MarketData;
+use super::operation::{
+    BookRef, ExecutionKind, MdUpdateAction, OperationEvent, OperationKind, OrderKind, QuoteKind,
+};
+use super::{
+    Element, ElementColumn, Event, EventColumn, Market, MarketColumn, Operation, OperationColumn,
+};
+use crate::implementer::warned;
+use crate::xxhash::Xxh3;
+use crate::{
+    Country, DataType, Decimal, Error, Eusipa, Field, FieldRecord, FieldScalar, IdKey, Isin,
+    MarketDataKind, Result, Scalar, State, StructType, Uuid,
+};
+
+/// The name of the root a message stating no entry stands under.
+const ENTRIES: &str = "entries";
+/// The row form's root, the item of its `children` and of its `anomalies`.
+const MESSAGE: &str = "message";
+const CHILD: &str = "child";
+const ANOMALY: &str = "anomaly";
+/// The row form's own columns, after the fact columns.
+const STATED: &str = "stated";
+const ACKNOWLEDGEMENT: &str = "acknowledgement";
+const BOOK: &str = "book";
+const INSTRUMENT: &str = "instrument";
+/// The row form's columns after the entries.
+const CHILDREN: &str = "children";
+const ANOMALIES: &str = "anomalies";
+
+/// The fact columns every message's row form opens with, in `marketdata`
+/// order: the element's, the event's, the market's, the operation's.
+const FACT_COLUMNS: usize = ElementColumn::ALL.len()
+    + EventColumn::ALL.len()
+    + MarketColumn::ALL.len()
+    + OperationColumn::ALL.len();
+
+/// `stated`, `acknowledgement`, `book` and `instrument`.
+const OWN_COLUMNS: usize = 4;
+
+/// The facts a message's source stated, one bit each: what a setter of the
+/// message's [`Market`], [`Event`] and [`Operation`] doors marks as it
+/// states it, what a codec's own reading marks for every fact it reads off
+/// a field the source stated - never one a derivation filled
+/// ([`MarketMessage::set_stated`]) - and what a child states over the
+/// message it belongs to ([`MarketMessage::into_market_data`]).
+///
+/// A bit stands for the fact a setter names: [`Self::FILLS`] the last
+/// quantity, the average price, the cumulative and the leaves quantities,
+/// [`Self::LASTPX`] the last price and the FX parts of a price, and
+/// [`Self::BIDASK`] the six facts of the two legs. [`Self::ALL`] is every
+/// fact; [`Self::TRANSUNIX`] - the instant was set - and the two held
+/// clocks are outside it.
+///
+/// ```
+/// use yggdryl::graph::StatedFacts;
+///
+/// let mut stated = StatedFacts::EMPTY;
+/// stated.insert(StatedFacts::PRICE);
+/// assert!(stated.contains(StatedFacts::PRICE));
+/// assert!(!stated.contains(StatedFacts::PRICE.union(StatedFacts::SIDE)));
+/// assert!(StatedFacts::ALL.contains(stated));
+/// assert_eq!(StatedFacts::from_bits(stated.bits()), Some(stated));
+/// assert_eq!(StatedFacts::from_bits(1 << 40), None);
+/// ```
+#[derive(Clone, Copy, Debug, Default, Eq, Hash, PartialEq)]
+pub struct StatedFacts(u64);
+
+impl StatedFacts {
+    /// Nothing stated.
+    pub const EMPTY: Self = Self(0);
+    /// The security identifiers.
+    pub const SECURITYIDS: Self = Self(1);
+    /// The lifecycle state.
+    pub const STATE: Self = Self(1 << 1);
+    /// The market data category.
+    pub const KIND: Self = Self(1 << 2);
+    /// The market data type.
+    pub const MDTYPE: Self = Self(1 << 3);
+    /// When it expires.
+    pub const EXPIRY: Self = Self(1 << 4);
+    /// When it last executed.
+    pub const EXECUTION: Self = Self(1 << 5);
+    /// How long it stands.
+    pub const TIF: Self = Self(1 << 6);
+    /// The ticker.
+    pub const TICKER: Self = Self(1 << 7);
+    /// The CFI code.
+    pub const CFI: Self = Self(1 << 8);
+    /// The market identifier code.
+    pub const MIC: Self = Self(1 << 9);
+    /// Whether it trades.
+    pub const TRADABLE: Self = Self(1 << 10);
+    /// The unit.
+    pub const UNIT: Self = Self(1 << 11);
+    /// The bid's and the ask's price, quantity and currency.
+    pub const BIDASK: Self = Self(1 << 12);
+    /// The price.
+    pub const PRICE: Self = Self(1 << 13);
+    /// The stop price.
+    pub const STOPPX: Self = Self(1 << 14);
+    /// The quantity.
+    pub const QUANTITY: Self = Self(1 << 15);
+    /// The shown part of the quantity.
+    pub const DISPLAYQTY: Self = Self(1 << 16);
+    /// The hidden part of the quantity.
+    pub const HIDDENQTY: Self = Self(1 << 17);
+    /// What was canceled.
+    pub const CXLQTY: Self = Self(1 << 18);
+    /// The previous step's price.
+    pub const PREVPX: Self = Self(1 << 19);
+    /// The last quantity, the average price, what traded and what is left.
+    pub const FILLS: Self = Self(1 << 20);
+    /// The last price and the FX parts of a price.
+    pub const LASTPX: Self = Self(1 << 21);
+    /// The currency.
+    pub const CURRENCY: Self = Self(1 << 22);
+    /// The side.
+    pub const SIDE: Self = Self(1 << 23);
+    /// What was ordered.
+    pub const ORDQTY: Self = Self(1 << 24);
+    /// The operation's own identifiers.
+    pub const IDENTIFIERS: Self = Self(1 << 25);
+    /// The parties.
+    pub const PARTYIDS: Self = Self(1 << 26);
+    /// The strike price.
+    pub const STRIKEPX: Self = Self(1 << 27);
+    /// Every fact.
+    pub const ALL: Self = Self((1 << 28) - 1);
+    /// The instant was set: a child dated by its own instant rather than
+    /// the message's.
+    pub const TRANSUNIX: Self = Self(1 << 28);
+    /// A non-null execution clock stands as stated, which no reading of
+    /// the entries replaces.
+    pub const HELD_EXECUNIX: Self = Self(1 << 29);
+    /// A non-null wire clock stands as stated, which no reading of the
+    /// entries replaces.
+    pub const HELD_SENDUNIX: Self = Self(1 << 30);
+
+    /// Every bit a value may hold.
+    const KNOWN: u64 = (1 << 31) - 1;
+
+    /// The bits, as a value's row form stores them.
+    #[must_use]
+    pub const fn bits(self) -> u64 {
+        self.0
+    }
+
+    /// The facts `bits` name; `None` where they hold a bit no fact is.
+    #[must_use]
+    pub const fn from_bits(bits: u64) -> Option<Self> {
+        if bits & !Self::KNOWN == 0 {
+            Some(Self(bits))
+        } else {
+            None
+        }
+    }
+
+    /// Whether nothing is stated.
+    #[must_use]
+    pub const fn is_empty(self) -> bool {
+        self.0 == 0
+    }
+
+    /// Whether every fact `other` names is stated.
+    #[must_use]
+    pub const fn contains(self, other: Self) -> bool {
+        self.0 & other.0 == other.0
+    }
+
+    /// Whether any fact `other` names is stated.
+    #[must_use]
+    pub const fn intersects(self, other: Self) -> bool {
+        self.0 & other.0 != 0
+    }
+
+    /// The facts either states.
+    #[must_use]
+    pub const fn union(self, other: Self) -> Self {
+        Self(self.0 | other.0)
+    }
+
+    /// The facts both state.
+    #[must_use]
+    pub const fn intersection(self, other: Self) -> Self {
+        Self(self.0 & other.0)
+    }
+
+    /// The facts this states and `other` does not.
+    #[must_use]
+    pub const fn difference(self, other: Self) -> Self {
+        Self(self.0 & !other.0)
+    }
+
+    /// States every fact `other` names.
+    pub fn insert(&mut self, other: Self) {
+        self.0 |= other.0;
+    }
+
+    /// Takes back every fact `other` names.
+    pub fn remove(&mut self, other: Self) {
+        self.0 &= !other.0;
+    }
+
+    /// States every fact `other` names where `on`, takes them back where not.
+    pub fn set(&mut self, other: Self, on: bool) {
+        if on {
+            self.insert(other);
+        } else {
+            self.remove(other);
+        }
+    }
+}
+
+/// What a message states of its instrument that is a registry fact and no
+/// element fact: its country of issue, the instrument it is written on and
+/// its EUSIPA product category. A codec sets it at parse
+/// ([`MarketMessage::set_instrument`]), an instrument registry learns it
+/// ([`IsinRegistry`](crate::IsinRegistry)), and it lifts into no column of
+/// any leaf.
+///
+/// ```
+/// use yggdryl::graph::InstrumentStatement;
+/// use yggdryl::{Country, Eusipa};
+///
+/// # fn main() -> yggdryl::Result<()> {
+/// let statement = InstrumentStatement {
+///     countrycode: Some(Country::new("CH")?),
+///     eusipacode: Some(Eusipa::new(1300)?),
+///     ..InstrumentStatement::default()
+/// };
+/// assert!(!statement.is_empty());
+/// assert!(InstrumentStatement::default().is_empty());
+/// # Ok(())
+/// # }
+/// ```
+#[derive(Clone, Debug, Default, Eq, Hash, PartialEq)]
+pub struct InstrumentStatement {
+    /// The country the instrument was issued in, where the message states
+    /// one its ISIN does not already say.
+    pub countrycode: Option<Country>,
+    /// The ISIN of the one instrument this message's own is written on.
+    pub underlyingisin: Option<Isin>,
+    /// The EUSIPA product category of a structured product.
+    pub eusipacode: Option<Eusipa>,
+}
+
+impl InstrumentStatement {
+    /// Whether the message states nothing of its instrument.
+    #[must_use]
+    pub fn is_empty(&self) -> bool {
+        self.countrycode.is_none() && self.underlyingisin.is_none() && self.eusipacode.is_none()
+    }
+
+    /// The three members of the row form's `instrument` column.
+    fn fields() -> [Field; 3] {
+        [
+            DataType::Country.nullable_field("countrycode"),
+            DataType::Isin.nullable_field("underlyingisin"),
+            DataType::Int32.nullable_field("eusipacode"),
+        ]
+    }
+
+    /// The statement as its `instrument` cell: null where it states nothing.
+    fn cell(&self) -> Scalar {
+        if self.is_empty() {
+            return Scalar::Null;
+        }
+        Scalar::from_sequence([
+            self.countrycode
+                .clone()
+                .map_or(Scalar::Null, Scalar::Country),
+            self.underlyingisin
+                .clone()
+                .map_or(Scalar::Null, Scalar::Isin),
+            self.eusipacode
+                .map_or(Scalar::Null, |code| Scalar::from(i32::from(code.code()))),
+        ])
+    }
+
+    /// The statement an `instrument` cell holds.
+    fn from_cell(cell: &Scalar) -> Result<Self> {
+        if cell.is_null() {
+            return Ok(Self::default());
+        }
+        let parts = cell
+            .sequence_rows()
+            .filter(|parts| parts.len() == 3)
+            .ok_or_else(|| invalid("$.instrument", "expected its three cells"))?;
+        let countrycode = match &parts[0] {
+            Scalar::Null => None,
+            Scalar::Country(code) => Some(code.clone()),
+            other => Some(Country::new(other.as_str().ok_or_else(|| {
+                invalid("$.instrument.countrycode", "expected a country code")
+            })?)?),
+        };
+        let underlyingisin = match &parts[1] {
+            Scalar::Null => None,
+            Scalar::Isin(code) => Some(code.clone()),
+            other => Some(Isin::new(other.as_str().ok_or_else(|| {
+                invalid("$.instrument.underlyingisin", "expected an ISIN")
+            })?)?),
+        };
+        let eusipacode = match &parts[2] {
+            Scalar::Null => None,
+            other => {
+                let code = other
+                    .as_i64()
+                    .and_then(|code| u16::try_from(code).ok())
+                    .ok_or_else(|| {
+                        invalid(
+                            "$.instrument.eusipacode",
+                            "expected a four-digit EUSIPA code",
+                        )
+                    })?;
+                Some(Eusipa::new(code)?)
+            }
+        };
+        Ok(Self {
+            countrycode,
+            underlyingisin,
+            eusipacode,
+        })
+    }
+}
+
+/// The root a message stating no entry stands under, and its empty run:
+/// built once, shared by every such message.
+fn empty_entries() -> (Arc<Field>, Scalar) {
+    static EMPTY: LazyLock<(Arc<Field>, Scalar)> = LazyLock::new(|| {
+        (
+            Arc::new(Field::new(
+                ENTRIES,
+                DataType::from(StructType::new()),
+                false,
+            )),
+            Scalar::from_sequence(std::iter::empty()),
+        )
+    });
+    (Arc::clone(&EMPTY.0), EMPTY.1.clone())
+}
+
+/// One market message: the facts it states, typed, beside what it states
+/// beyond them.
+///
+/// - **Facts.** Every element, event, market and operation fact, the one
+///   owner of each, answered through [`Element`], [`Event`], [`Market`]
+///   and [`Operation`] like every leaf's; a setter through them states its
+///   fact ([`Self::stated`]). A message filed under `EXEC` reports an
+///   execution ([`Event::is_execution`]); one filed under its order's or
+///   quote's category is a step of that chain.
+/// - **Entries.** What it stated beyond its facts: one ordered run under its
+///   protocol's entry root - one `Arc<Field>` a codec shares across every
+///   message of its dictionary - canonicalized once where it is set and
+///   read by exact name ([`Self::entry`]); a cell read is one buffer read.
+/// - **Children.** The elements it states - a book message's levels - each
+///   a message of its own, one level deep, under one root.
+/// - **The rest.** The book control it states ([`Self::book`]), whether it
+///   acknowledges another element's step ([`Self::is_acknowledgement`]),
+///   what it states of its instrument ([`Self::instrument`]) and the
+///   [`Anomaly`] values its reading could not take ([`Self::anomalies`]).
+///
+/// It walks, merges and restates as itself: following and merging are the
+/// operation's own over its facts, and its identity digests its facts, its
+/// category, its entries, its book control, its instrument statement and
+/// its children - never its anomalies. It splits into the market data
+/// leaves it states ([`Self::into_market_data`]).
+///
+/// ```
+/// use yggdryl::graph::{Element, Event, Market, MarketMessage, StatedFacts};
+/// use yggdryl::{Decimal, MarketDataKind, Side};
+///
+/// # fn main() -> yggdryl::Result<()> {
+/// let mut message = MarketMessage::new(MarketDataKind::Order);
+/// message.set_transunix(1_700_000_000_000_000_000);
+/// message.set_side(Side::Buy, true);
+/// message.set_price(Some(Decimal::parse("101.5")?), true);
+/// message.set_quantity(Some(Decimal::from_int(100)), true);
+/// message.finalize();
+/// assert!(message.stated().contains(StatedFacts::PRICE.union(StatedFacts::SIDE)));
+///
+/// // Its row form restates it whole.
+/// let row = message.into_scalar();
+/// let back = MarketMessage::from_scalar(message.root().clone(), None, &row)?;
+/// assert_eq!(back, message);
+///
+/// // An order message is one order leaf, its facts moved.
+/// let leaf = message.into_market_leaf()?;
+/// assert_eq!(leaf.marketdatakind(), MarketDataKind::Order);
+/// assert_eq!(leaf.get_side(), Side::Buy);
+/// assert_eq!(leaf.get_price(), Some(Decimal::parse("101.5")?));
+/// # Ok(())
+/// # }
+/// ```
+#[derive(Clone)]
+pub struct MarketMessage {
+    /// Every fact, boxed: a message is moved through every stream by value,
+    /// and the facts are the bulk of it.
+    facts: Box<OperationEventFacts>,
+    /// What the source stated, one bit per fact.
+    stated: StatedFacts,
+    /// The entry root, shared.
+    root: Arc<Field>,
+    /// The entries: the canonical run under `root`.
+    row: Scalar,
+    /// The elements the message states, one level deep, under one root.
+    children: Vec<MarketMessage>,
+    /// What its reading could not take, each once.
+    anomalies: Vec<Anomaly>,
+    /// What it states of its instrument.
+    instrument: InstrumentStatement,
+    /// The book control it states, where it states one.
+    book: Option<Box<BookRef>>,
+    /// Whether it acknowledges another element's step.
+    acknowledgement: bool,
+}
+
+impl MarketMessage {
+    /// A message of category `kind` stating nothing else yet: no entry, no
+    /// child, its facts at the epoch. The category is stated
+    /// ([`StatedFacts::KIND`]).
+    #[must_use]
+    pub fn new(kind: MarketDataKind) -> Self {
+        let (root, row) = empty_entries();
+        let mut facts = Box::new(OperationEventFacts::default());
+        facts.set_marketdatakind(kind);
+        Self {
+            facts,
+            stated: StatedFacts::KIND,
+            root,
+            row,
+            children: Vec::new(),
+            anomalies: Vec::new(),
+            instrument: InstrumentStatement::default(),
+            book: None,
+            acknowledgement: false,
+        }
+    }
+
+    /// Files the message under another category, stating it: a parse
+    /// filing a report of no fill under its order's chain does.
+    pub fn set_marketdatakind(&mut self, kind: MarketDataKind) {
+        self.facts.set_marketdatakind(kind);
+        self.stated.insert(StatedFacts::KIND);
+    }
+
+    /// The facts the message's source stated.
+    #[must_use]
+    pub const fn stated(&self) -> StatedFacts {
+        self.stated
+    }
+
+    /// Replaces [`Self::stated`]: what a codec does once it has filled the
+    /// facts its own reading reads, which no setter's word states.
+    pub fn set_stated(&mut self, stated: StatedFacts) {
+        self.stated = stated;
+    }
+
+    /// The root the entries stand under: one `Arc<Field>` a codec shares
+    /// across every message of its dictionary, an empty struct named
+    /// `entries` for a message stating none.
+    #[must_use]
+    pub const fn root(&self) -> &Arc<Field> {
+        &self.root
+    }
+
+    /// The entries: the canonical ordered run under [`Self::root`].
+    #[must_use]
+    pub const fn row(&self) -> &Scalar {
+        &self.row
+    }
+
+    /// The entries as the row they are under [`Self::root`], every cell
+    /// paired with its child.
+    #[must_use]
+    pub fn record(&self) -> FieldRecord<'_> {
+        FieldRecord::from_checked(&self.root, &self.row.sequence_rows().unwrap_or_default())
+    }
+
+    /// The entry stated under `name` - an exact child name of the root, as
+    /// [`Field::index_of`] resolves it - null where the message states
+    /// nothing there; `None` where the root holds no such child.
+    ///
+    /// ```
+    /// use std::sync::Arc;
+    ///
+    /// use yggdryl::graph::MarketMessage;
+    /// use yggdryl::{DataType, MarketDataKind, Scalar, StructType};
+    ///
+    /// # fn main() -> yggdryl::Result<()> {
+    /// let root = Arc::new(
+    ///     DataType::from(StructType::from_fields([DataType::utf8().nullable_field("text")])?)
+    ///         .required_field("entries"),
+    /// );
+    /// let message = MarketMessage::new(MarketDataKind::Order)
+    ///     .try_with_entries(root, Scalar::from_sequence([Scalar::from("hello")]))?;
+    /// let text = message.entry("text").expect("a child of the root");
+    /// assert_eq!(text.as_str(), Some("hello"));
+    /// assert!(message.entry("TEXT").is_none());
+    /// # Ok(())
+    /// # }
+    /// ```
+    #[must_use]
+    pub fn entry(&self, name: &str) -> Option<FieldScalar<'_>> {
+        let at = self.root.index_of(name)?;
+        let value = self.row.sequence_rows()?.get(at)?.clone();
+        Some(FieldScalar::from_checked(&self.root.fields()[at], value))
+    }
+
+    /// Replaces the entries: `row` canonicalized once under `root`, a
+    /// non-null struct none of whose children is named as a column the
+    /// message states itself - a fact, `stated`, `acknowledgement`, `book`,
+    /// `instrument`, `children` or `anomalies` - so no fact has a second
+    /// owner. Failure leaves the message unchanged.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error where `root` is nullable or no struct, names such a
+    /// child, or where `row` is no row it accepts.
+    pub fn set_entries(&mut self, root: Arc<Field>, row: impl Into<Scalar>) -> Result<()> {
+        if root.is_nullable() || !root.is_struct() {
+            return Err(invalid(
+                "$",
+                format_smolstr!("expected a non-null struct root, got {:?}", root.name()),
+            ));
+        }
+        if let Some(child) = root
+            .fields()
+            .iter()
+            .find(|child| is_own_column(child.name()))
+        {
+            return Err(invalid(
+                format_smolstr!("$.{}", child.name()),
+                "an entry cannot be named as a column the message states itself",
+            ));
+        }
+        let row = root.canonicalize_value(row.into())?;
+        self.root = root;
+        self.row = row;
+        Ok(())
+    }
+
+    /// [`Self::set_entries`], consuming.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`Self::set_entries`]'s refusal.
+    pub fn try_with_entries(mut self, root: Arc<Field>, row: impl Into<Scalar>) -> Result<Self> {
+        self.set_entries(root, row)?;
+        Ok(self)
+    }
+
+    /// Replaces the entries with a run a codec laid out canonically under
+    /// `root` itself: stored as given, nothing read again - a codec's own
+    /// record is its parse's.
+    pub(crate) fn set_entries_unchecked(&mut self, root: Arc<Field>, row: Scalar) {
+        debug_assert!(root.is_struct() && !root.is_nullable());
+        self.root = root;
+        self.row = row;
+    }
+
+    /// Replaces one entry: `value` read through the child `name` names
+    /// exactly ([`Field::scalar`]). Failure leaves the message unchanged.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error where the root holds no child of that name, or
+    /// where the child refuses the value.
+    pub fn set_entry(&mut self, name: &str, value: impl Into<Scalar>) -> Result<()> {
+        let at = self.root.index_of(name).ok_or_else(|| {
+            invalid(
+                format_smolstr!("$.{name}"),
+                format_smolstr!("the root {:?} holds no such entry", self.root.name()),
+            )
+        })?;
+        let value = self.root.fields()[at].scalar(value)?;
+        let mut cells = self.row.sequence_rows().unwrap_or_default().into_owned();
+        cells[at] = value;
+        self.row = Scalar::from_sequence(cells);
+        Ok(())
+    }
+
+    /// The elements the message states, each a message of its own.
+    #[must_use]
+    pub fn children(&self) -> &[MarketMessage] {
+        &self.children
+    }
+
+    /// The elements the message states, to restate in place: a child stays
+    /// one level deep and under its root whatever is written through it.
+    pub fn children_mut(&mut self) -> &mut [MarketMessage] {
+        &mut self.children
+    }
+
+    /// States one more element: `child`, after the ones before it.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error where `child` states children of its own - a
+    /// message's elements are one level deep - or where its entries stand
+    /// under another root than the children before it.
+    pub fn push_child(&mut self, child: MarketMessage) -> Result<()> {
+        if !child.children.is_empty() {
+            return Err(invalid(
+                "$.children",
+                "a child states children of its own: a message's elements are one level deep",
+            ));
+        }
+        if let Some(first) = self.children.first()
+            && !(Arc::ptr_eq(&first.root, &child.root) || first.root == child.root)
+        {
+            return Err(invalid(
+                "$.children",
+                format_smolstr!(
+                    "a child's entries stand under root {:?}, the children before it under {:?}",
+                    child.root.name(),
+                    first.root.name()
+                ),
+            ));
+        }
+        self.children.push(child);
+        Ok(())
+    }
+
+    /// States no element: the children let go of, the message's own facts
+    /// and entries kept - a codec returning them to the group they were
+    /// read from.
+    pub(crate) fn clear_children(&mut self) {
+        self.children.clear();
+    }
+
+    /// What the message states that its reading could not take as it
+    /// stands, in the order noted: never a fact column, never a digest
+    /// input. Two statements of one message merge them as a union.
+    #[must_use]
+    pub fn anomalies(&self) -> &[Anomaly] {
+        &self.anomalies
+    }
+
+    /// Keeps `anomaly` beside the message, once.
+    pub fn note_anomaly(&mut self, anomaly: Anomaly) {
+        if !self.anomalies.contains(&anomaly) {
+            self.anomalies.push(anomaly);
+        }
+    }
+
+    /// Replaces [`Self::anomalies`]: what a codec does when its reading of
+    /// the message is redone.
+    pub fn set_anomalies(&mut self, anomalies: Vec<Anomaly>) {
+        self.anomalies = anomalies;
+    }
+
+    /// The anomalies, to restate in place: a codec's reading keeps its own
+    /// order of them.
+    pub(crate) fn anomalies_mut(&mut self) -> &mut Vec<Anomaly> {
+        &mut self.anomalies
+    }
+
+    /// What the order's quantities imply of one another, settled once
+    /// every one of them is stated.
+    pub(crate) fn settle_orders(&mut self) {
+        self.facts.settle_orders();
+    }
+
+    /// Takes the anomalies of another statement of this message, each once.
+    fn fold_anomalies(&mut self, other: &Self) {
+        for anomaly in &other.anomalies {
+            if !self.anomalies.contains(anomaly) {
+                self.anomalies.push(anomaly.clone());
+            }
+        }
+    }
+
+    /// What the message states of its instrument.
+    #[must_use]
+    pub const fn instrument(&self) -> &InstrumentStatement {
+        &self.instrument
+    }
+
+    /// Replaces [`Self::instrument`].
+    pub fn set_instrument(&mut self, instrument: InstrumentStatement) {
+        self.instrument = instrument;
+    }
+
+    /// The book control the message states: on a book message, its scope
+    /// and - a full refresh - the snapshot action; on a child, its entry's
+    /// action, scope, position, price and size.
+    #[must_use]
+    pub fn book(&self) -> Option<&BookRef> {
+        self.book.as_deref()
+    }
+
+    /// Replaces [`Self::book`]; a control stating nothing is `None`.
+    pub fn set_book(&mut self, book: Option<BookRef>) {
+        self.book = book.filter(BookRef::is_stated).map(Box::new);
+    }
+
+    /// Whether the message acknowledges another element's step rather than
+    /// states one of its chain's own - an execution's acknowledgement or
+    /// its rejection, filed beside the order it answers: it walks in that
+    /// chain and answers no market data leaf.
+    #[must_use]
+    pub const fn is_acknowledgement(&self) -> bool {
+        self.acknowledgement
+    }
+
+    /// Replaces [`Self::is_acknowledgement`].
+    pub fn set_acknowledgement(&mut self, acknowledgement: bool) {
+        self.acknowledgement = acknowledgement;
+    }
+
+    /// The deterministic hash of the message: its [`Hash`] - the code its
+    /// facts settled to, its root's name and arity, its entries, children,
+    /// anomalies, instrument statement, book control and acknowledgement -
+    /// fed to the crate's stable XXH3-64 sink.
+    #[must_use]
+    pub fn stable_hash(&self) -> u64 {
+        crate::implementer::stable_hash_of(self)
+    }
+}
+
+// ------------------------------------------------------------------------
+// The leaves a message states
+// ------------------------------------------------------------------------
+
+impl MarketMessage {
+    /// Whether the message states market data: children, or - itself - an
+    /// order, a quote, an execution or a full book refresh, never an
+    /// acknowledgement. What [`Self::into_market_data`] answers a leaf for.
+    #[must_use]
+    pub fn is_market_data(&self) -> bool {
+        if !self.children.is_empty() {
+            return true;
+        }
+        if self.acknowledgement {
+            return false;
+        }
+        match self.marketdatakind() {
+            MarketDataKind::Order | MarketDataKind::Quotation | MarketDataKind::Execution => true,
+            MarketDataKind::Book => self
+                .book
+                .as_ref()
+                .is_some_and(|book| book.action == Some(MdUpdateAction::Snapshot)),
+            _ => false,
+        }
+    }
+
+    /// Moves the message into the market data leaves it states, reading
+    /// its facts alone.
+    ///
+    /// - **Children.** One leaf per child filed as an order, a quote or an
+    ///   execution, in nondecreasing effective time - the snapshot instant
+    ///   a walk stated, else the event's own - stably keeping the children's
+    ///   order: each starts from the message's facts and takes every fact
+    ///   the child states ([`Self::stated`]), its own instant, clocks, cross
+    ///   code and sources where it states them, its identifiers by type,
+    ///   its parties, security identifiers, rates and metadata leading the
+    ///   message's, and the child's book control. The last child moves the
+    ///   message's facts; every other clones them. A child of any other
+    ///   category is passed over with a warning.
+    /// - **No children.** An order, a quote or an execution is one leaf of
+    ///   its category, the facts moved and nothing allocated, carrying the
+    ///   message's book control; a book message stating the snapshot action
+    ///   is one scoped snapshot control, and one stating any other is no
+    ///   leaf - its entries are its children. An acknowledgement, a book
+    ///   message stating no book control and a message of any other
+    ///   category answer none with a warning, a trade and a batch in
+    ///   silence: their leaves are the messages their parse splits off.
+    ///
+    /// An execution is one fill, complete in itself: its leaf reads `FILLED`
+    /// whatever its message's state, unless that is `CANCELED`.
+    ///
+    /// ```
+    /// use yggdryl::graph::{BookRef, Event, Market, MarketMessage, MdUpdateAction};
+    /// use yggdryl::{Decimal, MarketDataKind, Side};
+    ///
+    /// # fn main() -> yggdryl::Result<()> {
+    /// let control = BookRef {
+    ///     action: Some(MdUpdateAction::Snapshot),
+    ///     scope: Some("Symbol=ACME".into()),
+    ///     ..BookRef::default()
+    /// };
+    /// let mut book = MarketMessage::new(MarketDataKind::Book);
+    /// book.set_transunix(1_000);
+    /// book.set_ticker(Some("ACME".into()), true);
+    /// book.set_book(Some(control.clone()));
+    /// for (side, price) in [(Side::Buy, 99), (Side::Sell, 101)] {
+    ///     let mut level = MarketMessage::new(MarketDataKind::Quotation);
+    ///     level.set_side(side, true);
+    ///     level.set_price(Some(Decimal::from_int(price)), true);
+    ///     level.set_book(Some(control.clone()));
+    ///     book.push_child(level)?;
+    /// }
+    /// let leaves = book.into_market_data();
+    /// assert_eq!(leaves.len(), 2);
+    /// // What a level states nothing of is the message's.
+    /// assert!(leaves.iter().all(|leaf| leaf.get_ticker() == Some("ACME")));
+    /// assert_eq!(leaves[1].get_side(), Side::Sell);
+    /// # Ok(())
+    /// # }
+    /// ```
+    #[must_use]
+    pub fn into_market_data(self) -> Vec<MarketData> {
+        self.into_leaves().into_vec()
+    }
+
+    /// Moves the message into the one market data leaf it is: an order, a
+    /// quote, an execution, a full refresh's snapshot control, or a message
+    /// stating one child that stands. A direct leaf moves the facts and
+    /// allocates nothing.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error at `$.children` for a message stating children or a
+    /// book control, at `$.marketdatakind` for any other, where it is not
+    /// exactly one leaf.
+    pub fn into_market_leaf(self) -> Result<MarketData> {
+        let path = if self.children.is_empty() && self.book.is_none() {
+            "$.marketdatakind"
+        } else {
+            "$.children"
+        };
+        let mut leaves = self.into_leaves();
+        if leaves.len() != 1 {
+            return Err(invalid(
+                path,
+                format_smolstr!(
+                    "expected exactly one market data element, got {}",
+                    leaves.len()
+                ),
+            ));
+        }
+        Ok(leaves.next().expect("exactly one leaf"))
+    }
+
+    /// The leaves the message states, as [`Self::into_market_data`] reads
+    /// them: the one owner of the split, which the `marketdata` writer and
+    /// the book fold read without collecting a direct leaf.
+    pub(crate) fn into_leaves(self) -> Leaves {
+        let Self {
+            facts,
+            children,
+            book,
+            acknowledgement,
+            ..
+        } = self;
+        if !children.is_empty() {
+            return Leaves::Many(children_leaves(*facts, children).into_iter());
+        }
+        let kind = facts.marketdatakind();
+        if acknowledgement {
+            warned!(
+                "message excluded from market data: an acknowledgement states no step of its chain",
+                kind.as_str(),
+                "a message of category {} acknowledging another element's step answers no leaf",
+                kind.as_str()
+            );
+            return Leaves::One(None);
+        }
+        match kind {
+            MarketDataKind::Order | MarketDataKind::Quotation | MarketDataKind::Execution => {
+                Leaves::One(Some(leaf(kind, *facts, book.map(|book| *book))))
+            }
+            MarketDataKind::Book => match book {
+                Some(control) if control.action == Some(MdUpdateAction::Snapshot) => {
+                    Leaves::One(Some(snapshot(*facts, *control)))
+                }
+                // An update's entries are its children: stating none, it
+                // changes nothing.
+                Some(_) => Leaves::One(None),
+                None => {
+                    warned!(
+                        "message excluded from market data: a book message states no book control",
+                        kind.as_str(),
+                        "a book message stating no scope answers no leaf"
+                    );
+                    Leaves::One(None)
+                }
+            },
+            MarketDataKind::Trade => Leaves::One(None),
+            kind if kind.is_batch() => Leaves::One(None),
+            kind => {
+                warned!(
+                    "message excluded from market data: it is no order, quote, execution or book message",
+                    kind.as_str(),
+                    "a message of category {} answers no leaf",
+                    kind.as_str()
+                );
+                Leaves::One(None)
+            }
+        }
+    }
+}
+
+/// The leaves of a message stating children: each child's over the
+/// message's facts, sorted stably by effective time.
+fn children_leaves(parent: OperationEventFacts, children: Vec<MarketMessage>) -> Vec<MarketData> {
+    let count = children.len();
+    let mut leaves = Vec::with_capacity(count);
+    let mut base = Some(parent);
+    for (index, child) in children.into_iter().enumerate() {
+        let kind = child.marketdatakind();
+        if !matches!(
+            kind,
+            MarketDataKind::Order | MarketDataKind::Quotation | MarketDataKind::Execution
+        ) {
+            warned!(
+                "message child excluded from market data: it is no order, quote or execution",
+                kind.as_str(),
+                "a child of category {} answers no leaf",
+                kind.as_str()
+            );
+            continue;
+        }
+        let mut facts = if index + 1 == count {
+            base.take()
+        } else {
+            base.clone()
+        }
+        .expect("the message's facts stand until the last child takes them");
+        carry(&mut facts, &child);
+        leaves.push(leaf(kind, facts, child.book.map(|book| *book)));
+    }
+    leaves.sort_by_key(effective_unix);
+    leaves
+}
+
+/// States on `leaf` - the message's facts - every fact `child` states:
+/// the facts its [`StatedFacts`] name, its instant where it set one, its
+/// creation and wire clocks, its cross code and sources where it states
+/// them; its identifiers replace the message's of their types, and its
+/// security identifiers, parties, rates and metadata lead the message's.
+/// The instants come first, then the price and the quantity before the
+/// side that files them under its leg, as a reader stating each in turn
+/// does.
+fn carry(leaf: &mut OperationEventFacts, child: &MarketMessage) {
+    let own = &*child.facts;
+    let says = |facts: StatedFacts| child.stated.contains(facts);
+    if says(StatedFacts::TRANSUNIX) {
+        leaf.set_transunix(own.get_transunix());
+    }
+    if let Some(unix) = own.get_creaunix() {
+        leaf.set_creaunix(Some(unix));
+    }
+    if let Some(unix) = own.get_sendunix() {
+        leaf.set_sendunix(Some(unix));
+    }
+    if says(StatedFacts::EXPIRY) {
+        leaf.set_exprunix(own.get_exprunix());
+    }
+    if says(StatedFacts::EXECUTION) {
+        leaf.set_execunix(own.get_execunix(), true);
+    }
+    if says(StatedFacts::PRICE) {
+        leaf.set_price(own.get_price(), true);
+    }
+    if says(StatedFacts::QUANTITY) {
+        leaf.set_quantity(own.get_quantity(), true);
+    }
+    if says(StatedFacts::LASTPX) {
+        leaf.set_lastpx(own.get_lastpx(), true);
+        leaf.set_spotrate(own.get_spotrate(), true);
+        leaf.set_forwardpoints(own.get_forwardpoints(), true);
+    }
+    if says(StatedFacts::SIDE) {
+        leaf.set_side(own.get_side(), true);
+    }
+    if says(StatedFacts::BIDASK) {
+        leaf.set_bidpx(own.get_bidpx(), true);
+        leaf.set_bidqty(own.get_bidqty(), true);
+        leaf.set_bidccy(own.get_bidccy().cloned(), true);
+        leaf.set_askpx(own.get_askpx(), true);
+        leaf.set_askqty(own.get_askqty(), true);
+        leaf.set_askccy(own.get_askccy().cloned(), true);
+    }
+    if says(StatedFacts::CURRENCY) {
+        leaf.set_currency(own.get_currency().clone(), true);
+    }
+    if !own.get_origccy().is_none() {
+        leaf.set_origccy(own.get_origccy().clone(), true);
+    }
+    if says(StatedFacts::UNIT) {
+        leaf.set_unit(own.get_unit().clone(), true);
+    }
+    if says(StatedFacts::MDTYPE) {
+        leaf.set_marketdatatype(own.get_marketdatatype(), true);
+    }
+    if says(StatedFacts::STOPPX) {
+        leaf.set_stoppx(own.get_stoppx(), true);
+    }
+    if says(StatedFacts::STRIKEPX) {
+        leaf.set_strikepx(own.get_strikepx(), true);
+    }
+    if says(StatedFacts::DISPLAYQTY) {
+        leaf.set_displayqty(own.get_displayqty(), true);
+    }
+    if says(StatedFacts::HIDDENQTY) {
+        leaf.set_hiddenqty(own.get_hiddenqty(), true);
+    }
+    if says(StatedFacts::CXLQTY) {
+        leaf.set_cxlqty(own.get_cxlqty(), true);
+    }
+    if says(StatedFacts::PREVPX) {
+        leaf.set_prevpx(own.get_prevpx(), true);
+    }
+    if let Some(qty) = own.get_prevqty() {
+        leaf.set_prevqty(Some(qty), true);
+    }
+    if says(StatedFacts::FILLS) {
+        leaf.set_lastqty(own.get_lastqty(), true);
+        leaf.set_avgpx(own.get_avgpx(), true);
+        leaf.set_cumqty(own.get_cumqty(), true);
+        leaf.set_leavesqty(own.get_leavesqty(), true);
+    }
+    if says(StatedFacts::CFI) {
+        leaf.set_cficode(own.get_cficode().cloned(), true);
+    }
+    if says(StatedFacts::MIC) {
+        leaf.set_miccode(own.get_miccode().cloned(), true);
+    }
+    if says(StatedFacts::TICKER) {
+        leaf.set_ticker(own.get_ticker().map(SmolStr::new), true);
+    }
+    if says(StatedFacts::STATE) {
+        leaf.set_state(*own.get_state());
+    }
+    if !own.get_crosscode().is_empty() {
+        leaf.set_crosscode(own.get_crosscode().to_owned());
+    }
+    if !own.get_srcuuids().is_empty() {
+        leaf.set_srcuuids(own.get_srcuuids().to_vec());
+    }
+    if says(StatedFacts::SECURITYIDS) {
+        let mut ids = own.get_securityids().clone();
+        ids.merge(leaf.get_securityids(), false);
+        let _ = leaf.set_securityids(ids, true);
+    }
+    if says(StatedFacts::IDENTIFIERS) {
+        // The child's value of a type replaces the message's: removing a
+        // base key removes every key of its type.
+        for id in own.get_identifiers().iter() {
+            let _ = leaf.remove_identifier(&IdKey::base(id.kind().clone()));
+        }
+        for id in own.get_identifiers().iter() {
+            let _ = leaf.insert_identifier(id.clone());
+        }
+    }
+    if says(StatedFacts::PARTYIDS) {
+        let mut parties = own.get_partyids().clone();
+        parties.merge(leaf.get_partyids(), false);
+        let _ = leaf.set_partyids(parties, true);
+    }
+    if says(StatedFacts::ORDQTY) {
+        leaf.set_ordqty(own.get_ordqty(), true);
+    }
+    if says(StatedFacts::TIF) {
+        leaf.set_timeinforce(own.get_timeinforce().cloned(), true);
+    }
+    if says(StatedFacts::TRADABLE) {
+        leaf.set_tradable(own.get_tradable(), true);
+    }
+    if !own.get_fxrates().is_empty() {
+        let mut rates = own.get_fxrates().clone();
+        for (target, rate) in leaf.get_fxrates() {
+            rates.entry(target.clone()).or_insert(*rate);
+        }
+        leaf.set_fxrates(rates, true);
+    }
+    if !own.get_metadata().is_empty() {
+        let mut metadata = own.get_metadata().clone();
+        for (key, value) in leaf.get_metadata() {
+            metadata.entry(key.clone()).or_insert_with(|| value.clone());
+        }
+        leaf.set_metadata(Some(metadata), true);
+    }
+}
+
+/// The finalized operation leaf of `kind` - an order, a quote, else an
+/// execution, which reads `FILLED` unless it was canceled - over `facts`,
+/// with the book control it states.
+fn leaf(kind: MarketDataKind, mut facts: OperationEventFacts, book: Option<BookRef>) -> MarketData {
+    fn operation<K: OperationKind>(
+        facts: OperationEventFacts,
+        book: Option<BookRef>,
+    ) -> OperationEvent<K> {
+        let mut operation = OperationEvent::<K>::from_facts(facts);
+        operation.set_book(book);
+        operation.finalize();
+        operation
+    }
+    match kind {
+        MarketDataKind::Order => MarketData::from(operation::<OrderKind>(facts, book)),
+        MarketDataKind::Quotation => MarketData::from(operation::<QuoteKind>(facts, book)),
+        _ => {
+            if *facts.get_state() != State::Canceled {
+                facts.set_state(State::Filled);
+            }
+            MarketData::from(operation::<ExecutionKind>(facts, book))
+        }
+    }
+}
+
+/// The scoped snapshot control a full refresh stating no entry is: its
+/// scope cleared, under the cross code `{scope}|BookSnapshot=empty`, `NEW`,
+/// stating no operation of its own.
+fn snapshot(mut facts: OperationEventFacts, control: BookRef) -> MarketData {
+    let mut code = control.scope.as_deref().unwrap_or_default().to_owned();
+    if !code.is_empty() {
+        code.push('|');
+    }
+    code.push_str("BookSnapshot=empty");
+    facts.set_crosscode(code);
+    facts.set_state(State::New);
+    MarketData::from(SnapshotEvent::from_facts(facts.into_event(), control.scope))
+}
+
+/// The instant a leaf stands at: the snapshot instant a walk stated, else
+/// its own; an undated leaf at the epoch.
+fn effective_unix(leaf: &MarketData) -> i64 {
+    leaf.as_event().map_or(0, |event| {
+        event
+            .get_snapunix()
+            .unwrap_or_else(|| event.get_transunix())
+    })
+}
+
+/// The leaves one message states: a direct leaf held inline, so a message
+/// that is one order, quote or execution pays no allocation for the
+/// iterator's shape.
+#[allow(clippy::large_enum_variant)]
+pub(crate) enum Leaves {
+    One(Option<MarketData>),
+    Many(std::vec::IntoIter<MarketData>),
+}
+
+impl Leaves {
+    /// The leaves collected: a `Many` hands its allocation back.
+    fn into_vec(self) -> Vec<MarketData> {
+        match self {
+            Self::One(leaf) => leaf.into_iter().collect(),
+            Self::Many(leaves) => leaves.collect(),
+        }
+    }
+}
+
+impl Iterator for Leaves {
+    type Item = MarketData;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        match self {
+            Self::One(leaf) => leaf.take(),
+            Self::Many(leaves) => leaves.next(),
+        }
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        match self {
+            Self::One(leaf) => {
+                let len = usize::from(leaf.is_some());
+                (len, Some(len))
+            }
+            Self::Many(leaves) => leaves.size_hint(),
+        }
+    }
+}
+
+impl ExactSizeIterator for Leaves {}
+impl FusedIterator for Leaves {}
+
+/// A lazy projection of messages sorted by time into the market data
+/// leaves they state, each as [`MarketMessage::into_market_data`] states
+/// them: a direct message occupies no intermediate vector, and one stating
+/// children retains only its own leaves. Each leaf takes the
+/// [place](Event::get_seqnum) its message holds - the parse's, or a walk's
+/// - so a chain's steps at one instant keep their order whatever order a
+/// table read them back in, and the leaves of one message share it.
+///
+/// A message its intake refused for what it states is passed over with a
+/// warning, and a leaf dated before one already yielded is yielded with a
+/// warning, a book excluding it. Only the source's own failure
+/// ([`Error::is_source_failure`]) ends the projection: it is yielded after
+/// every leaf before it, and the iterator is fused.
+///
+/// ```
+/// use yggdryl::graph::{Event, MarketMessage, MessageIterator};
+/// use yggdryl::MarketDataKind;
+///
+/// let message = |unix: i64| {
+///     let mut message = MarketMessage::new(MarketDataKind::Order);
+///     message.set_transunix(unix);
+///     message
+/// };
+/// let leaves: Vec<_> = MessageIterator::new([message(1), message(2)].into_iter())
+///     .collect::<yggdryl::Result<_>>()
+///     .expect("no source fails");
+/// assert_eq!(leaves.len(), 2);
+/// ```
+pub struct MessageIterator<I>
+where
+    I: Iterator,
+    I::Item: Into<Result<MarketMessage>>,
+{
+    source: I,
+    current: Option<Leaves>,
+    last_unix: Option<i64>,
+    done: bool,
+}
+
+impl<I> MessageIterator<I>
+where
+    I: Iterator,
+    I::Item: Into<Result<MarketMessage>>,
+{
+    /// Opens a projection over messages already sorted by time.
+    #[must_use]
+    pub fn new(source: I) -> Self {
+        Self {
+            source,
+            current: None,
+            last_unix: None,
+            done: false,
+        }
+    }
+}
+
+impl<I> Iterator for MessageIterator<I>
+where
+    I: Iterator,
+    I::Item: Into<Result<MarketMessage>>,
+{
+    type Item = Result<MarketData>;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.done {
+            return None;
+        }
+        loop {
+            if let Some(leaf) = self.current.as_mut().and_then(Iterator::next) {
+                let unix = effective_unix(&leaf);
+                match self.last_unix {
+                    Some(previous) if unix < previous => warned!(
+                        "market data leaf yielded out of order: a book excludes it",
+                        leaf.marketdatakind().as_str(),
+                        "{} is dated {unix}, before the {previous} a leaf before it was",
+                        leaf.get_crosscode()
+                    ),
+                    _ => self.last_unix = Some(unix),
+                }
+                return Some(Ok(leaf));
+            }
+            self.current = None;
+            let Some(message) = self.source.next() else {
+                self.done = true;
+                return None;
+            };
+            let message: Result<MarketMessage> = message.into();
+            match message {
+                Ok(message) => self.current = Some(message.into_leaves()),
+                Err(failure) if failure.is_source_failure() => {
+                    self.done = true;
+                    return Some(Err(failure));
+                }
+                Err(refusal) => warned!(
+                    "message excluded from market data: its intake refused what it states",
+                    "intake",
+                    "{refusal}"
+                ),
+            }
+        }
+    }
+}
+
+impl<I> FusedIterator for MessageIterator<I>
+where
+    I: Iterator,
+    I::Item: Into<Result<MarketMessage>>,
+{
+}
+
+impl From<MarketMessage> for Result<MarketMessage> {
+    /// A message as the infallible item of a fallible stream.
+    fn from(message: MarketMessage) -> Self {
+        Ok(message)
+    }
+}
+
+// ------------------------------------------------------------------------
+// The row form
+// ------------------------------------------------------------------------
+
+/// Whether `name` spells a column the message's row form states itself,
+/// which no entry may take: a fact, or one of its own.
+fn is_own_column(name: &str) -> bool {
+    ElementColumn::of_name(name).is_some()
+        || EventColumn::of_name(name).is_some()
+        || MarketColumn::of_name(name).is_some()
+        || OperationColumn::of_name(name).is_some()
+        || [
+            STATED,
+            ACKNOWLEDGEMENT,
+            BOOK,
+            INSTRUMENT,
+            CHILDREN,
+            ANOMALIES,
+        ]
+        .into_iter()
+        .any(|own| crate::implementer::folds_equal(own, name))
+}
+
+/// The five members of the row form's `book` column.
+fn book_fields() -> [Field; 5] {
+    [
+        DataType::utf8().nullable_field("action"),
+        DataType::utf8().nullable_field("scope"),
+        DataType::UInt32.nullable_field("position"),
+        MarketColumn::Price.datatype().nullable_field("entrypx"),
+        MarketColumn::Quantity
+            .datatype()
+            .nullable_field("entrysize"),
+    ]
+}
+
+/// A book control as its `book` cell: null where there is none.
+fn book_cell(book: Option<&BookRef>) -> Scalar {
+    let Some(book) = book else {
+        return Scalar::Null;
+    };
+    Scalar::from_sequence([
+        book.action
+            .map_or(Scalar::Null, |action| Scalar::from(action.as_str())),
+        book.scope.clone().map_or(Scalar::Null, Scalar::from),
+        book.position.map_or(Scalar::Null, Scalar::from),
+        book.entry_px.map_or(Scalar::Null, Scalar::from),
+        book.entry_size.map_or(Scalar::Null, Scalar::from),
+    ])
+}
+
+/// The book control a `book` cell holds.
+fn book_of(cell: &Scalar) -> Result<Option<BookRef>> {
+    if cell.is_null() {
+        return Ok(None);
+    }
+    let parts = cell
+        .sequence_rows()
+        .filter(|parts| parts.len() == 5)
+        .ok_or_else(|| invalid("$.book", "expected its five cells"))?;
+    let action = match parts[0].as_str() {
+        None => None,
+        Some(text) => Some(MdUpdateAction::read(text).ok_or_else(|| {
+            invalid(
+                "$.book.action",
+                format_smolstr!("{text:?} is no update action"),
+            )
+        })?),
+    };
+    Ok(Some(BookRef {
+        action,
+        scope: parts[1].as_str().map(SmolStr::new),
+        position: parts[2].as_u64().and_then(|held| u32::try_from(held).ok()),
+        entry_px: Decimal::from_scalar(&parts[3]),
+        entry_size: Decimal::from_scalar(&parts[4]),
+    }))
+}
+
+/// The columns of one message's row form under `root`: the fact columns,
+/// the message's own, the entries, `children` where given, `anomalies`.
+fn row_fields(root: &Field, children: Option<Field>) -> Result<Vec<Field>> {
+    let mut fields = Vec::with_capacity(FACT_COLUMNS + OWN_COLUMNS + root.field_len() + 2);
+    fields.extend(ElementColumn::fields()?);
+    fields.extend(EventColumn::fields()?);
+    fields.extend(MarketColumn::fields()?);
+    fields.extend(OperationColumn::fields()?);
+    fields.push(DataType::UInt64.required_field(STATED));
+    fields.push(DataType::Boolean.required_field(ACKNOWLEDGEMENT));
+    fields.push(Field::new(
+        BOOK,
+        DataType::from(StructType::from_fields(book_fields())?),
+        true,
+    ));
+    fields.push(Field::new(
+        INSTRUMENT,
+        DataType::from(StructType::from_fields(InstrumentStatement::fields())?),
+        true,
+    ));
+    fields.extend(root.fields().iter().cloned());
+    fields.extend(children);
+    let anomaly = Field::new(
+        ANOMALY,
+        DataType::from(StructType::from_fields([
+            DataType::utf8().required_field("field"),
+            DataType::utf8().required_field("reason"),
+        ])?),
+        false,
+    );
+    fields.push(Field::new(ANOMALIES, DataType::serie(anomaly), true));
+    Ok(fields)
+}
+
+impl MarketMessage {
+    /// The message's own row form under the entry root `root`, its
+    /// children's entries under `child_root` - the empty root where `None`.
+    /// It is no protocol's row - a FIX message's fixed row is its codec's -
+    /// but the one shape pickle and the value stream carry a message by.
+    ///
+    /// The columns: the six element, nine event, thirty-six market and five
+    /// operation fact columns in `marketdata` order; `stated` (`uint64`,
+    /// [`StatedFacts::bits`]), `acknowledgement` (`boolean`), `book`
+    /// (`struct<action, scope, position, entrypx, entrysize>`, nullable) and
+    /// `instrument` (`struct<countrycode, underlyingisin, eusipacode>`,
+    /// nullable); the root's children; `children`, a nullable serie of the
+    /// same form under `child_root` less its own `children`; and
+    /// `anomalies`, a nullable `serie<struct<field: utf8, reason: utf8>>`.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error where a column cannot be built, or where a root
+    /// names a child as a column the message states itself.
+    pub fn field(root: &Field, child_root: Option<&Field>) -> Result<Field> {
+        let empty = empty_entries().0;
+        let child_root = child_root.unwrap_or(&*empty);
+        let child = Field::new(
+            CHILD,
+            DataType::from(StructType::from_fields(row_fields(child_root, None)?)?),
+            false,
+        );
+        let children = Field::new(CHILDREN, DataType::serie(child), true);
+        Ok(Field::new(
+            MESSAGE,
+            DataType::from(StructType::from_fields(row_fields(root, Some(children))?)?),
+            false,
+        ))
+    }
+
+    /// The message as one row of [`Self::field`] under its own root and its
+    /// children's: every cell the raw value its column types, a fact it
+    /// states none of null.
+    #[must_use]
+    pub fn into_scalar(&self) -> Scalar {
+        Scalar::from_sequence(self.cells(true))
+    }
+
+    /// The cells of the row form, with the `children` column where asked.
+    fn cells(&self, children: bool) -> Vec<Scalar> {
+        let entries = self.row.sequence_rows().unwrap_or_default();
+        let mut cells = Vec::with_capacity(FACT_COLUMNS + OWN_COLUMNS + entries.len() + 2);
+        cells.extend(
+            ElementColumn::ALL
+                .into_iter()
+                .map(|column| column.fact(self).unwrap_or(Scalar::Null)),
+        );
+        cells.extend(
+            EventColumn::ALL
+                .into_iter()
+                .map(|column| column.fact(self).unwrap_or(Scalar::Null)),
+        );
+        cells.extend(
+            MarketColumn::ALL
+                .into_iter()
+                .map(|column| column.fact(self).unwrap_or(Scalar::Null)),
+        );
+        cells.extend(
+            OperationColumn::ALL
+                .into_iter()
+                .map(|column| column.fact(self).unwrap_or(Scalar::Null)),
+        );
+        cells.push(Scalar::from(self.stated.bits()));
+        cells.push(Scalar::from(self.acknowledgement));
+        cells.push(book_cell(self.book.as_deref()));
+        cells.push(self.instrument.cell());
+        cells.extend(entries.iter().cloned());
+        if children {
+            cells.push(if self.children.is_empty() {
+                Scalar::Null
+            } else {
+                Scalar::from_sequence(
+                    self.children
+                        .iter()
+                        .map(|child| Scalar::from_sequence(child.cells(false))),
+                )
+            });
+        }
+        cells.push(if self.anomalies.is_empty() {
+            Scalar::Null
+        } else {
+            Scalar::from_sequence(self.anomalies.iter().map(|anomaly| {
+                Scalar::from_sequence([
+                    Scalar::from(anomaly.field()),
+                    Scalar::from(anomaly.reason()),
+                ])
+            }))
+        });
+        cells
+    }
+
+    /// The message one row of [`Self::field`] states: the facts recorded
+    /// exactly - identity and digests included, nothing settled again - the
+    /// entries canonicalized under `root`, each child's under `child_root`
+    /// (the empty root where `None`).
+    ///
+    /// # Errors
+    ///
+    /// Returns an error where the row is no run of the form's arity, where
+    /// `stated` holds a bit no fact is, where a book control, an instrument
+    /// statement or an anomaly does not read, or where the entries or a
+    /// child are refused as [`Self::set_entries`] and [`Self::push_child`]
+    /// refuse them.
+    pub fn from_scalar(
+        root: Arc<Field>,
+        child_root: Option<Arc<Field>>,
+        row: &Scalar,
+    ) -> Result<Self> {
+        let cells = row.sequence_rows().ok_or_else(|| {
+            invalid(
+                "$",
+                format_smolstr!(
+                    "expected the ordered cells of a message, got {}",
+                    row.kind()
+                ),
+            )
+        })?;
+        let child_root = child_root.unwrap_or_else(|| empty_entries().0);
+        Self::from_cells(root, Some(&child_root), &cells)
+    }
+
+    /// [`Self::from_scalar`] over the cells of one row: a message's where
+    /// `child_root` is given, a child's - which states no `children`
+    /// column - where it is not.
+    fn from_cells(
+        root: Arc<Field>,
+        child_root: Option<&Arc<Field>>,
+        cells: &[Scalar],
+    ) -> Result<Self> {
+        let expected =
+            FACT_COLUMNS + OWN_COLUMNS + root.field_len() + usize::from(child_root.is_some()) + 1;
+        if cells.len() != expected {
+            return Err(invalid(
+                "$",
+                format_smolstr!(
+                    "expected {expected} cells of a message under root {:?}, got {}",
+                    root.name(),
+                    cells.len()
+                ),
+            ));
+        }
+        let (element, rest) = cells.split_at(ElementColumn::ALL.len());
+        let (event, rest) = rest.split_at(EventColumn::ALL.len());
+        let (market, rest) = rest.split_at(MarketColumn::ALL.len());
+        let (operation, rest) = rest.split_at(OperationColumn::ALL.len());
+        let (own, rest) = rest.split_at(OWN_COLUMNS);
+        let (entries, rest) = rest.split_at(root.field_len());
+
+        let kind = MarketColumn::ALL
+            .into_iter()
+            .zip(market)
+            .find(|(column, _)| matches!(column, MarketColumn::MarketDataKind))
+            .and_then(|(_, cell)| <MarketDataKind as crate::MarketValue>::from_scalar(cell))
+            .unwrap_or(MarketDataKind::Unknown);
+        let mut message = Self::new(kind);
+        // Recorded on the facts themselves: what a row states is restated,
+        // and its own `stated` cell says what the source stated.
+        let facts = &mut *message.facts;
+        for (column, cell) in ElementColumn::ALL.into_iter().zip(element) {
+            column.record(facts, cell);
+        }
+        for (column, cell) in EventColumn::ALL.into_iter().zip(event) {
+            column.record(facts, cell);
+        }
+        for (column, cell) in MarketColumn::ALL.into_iter().zip(market) {
+            column.record(facts, cell);
+        }
+        for (column, cell) in OperationColumn::ALL.into_iter().zip(operation) {
+            column.record(facts, cell);
+        }
+
+        let bits = own[0].as_u64().unwrap_or(0);
+        message.stated = StatedFacts::from_bits(bits).ok_or_else(|| {
+            invalid(
+                format_smolstr!("$.{STATED}"),
+                format_smolstr!("{bits:#x} holds a bit no fact is"),
+            )
+        })?;
+        message.acknowledgement = own[1].as_bool().unwrap_or(false);
+        message.set_book(book_of(&own[2])?);
+        message.instrument = InstrumentStatement::from_cell(&own[3])?;
+        message.set_entries(root, Scalar::from_sequence(entries.iter().cloned()))?;
+
+        let mut rest = rest;
+        if let Some(child_root) = child_root {
+            let (children, after) = rest.split_at(1);
+            rest = after;
+            if !children[0].is_null() {
+                let items = children[0].sequence_rows().ok_or_else(|| {
+                    invalid(
+                        format_smolstr!("$.{CHILDREN}"),
+                        "expected a serie of children",
+                    )
+                })?;
+                for item in items.iter() {
+                    let child = item.sequence_rows().ok_or_else(|| {
+                        invalid(
+                            format_smolstr!("$.{CHILDREN}"),
+                            "expected the ordered cells of a child",
+                        )
+                    })?;
+                    message.push_child(Self::from_cells(Arc::clone(child_root), None, &child)?)?;
+                }
+            }
+        }
+        if !rest[0].is_null() {
+            let items = rest[0].sequence_rows().ok_or_else(|| {
+                invalid(
+                    format_smolstr!("$.{ANOMALIES}"),
+                    "expected a serie of anomalies",
+                )
+            })?;
+            for item in items.iter() {
+                let parts = item.sequence_rows().filter(|parts| parts.len() == 2);
+                let (Some(field), Some(reason)) = (
+                    parts.as_ref().and_then(|parts| parts[0].as_str()),
+                    parts.as_ref().and_then(|parts| parts[1].as_str()),
+                ) else {
+                    return Err(invalid(
+                        format_smolstr!("$.{ANOMALIES}"),
+                        "expected an anomaly's field and reason",
+                    ));
+                };
+                message.note_anomaly(Anomaly::new(field, reason));
+            }
