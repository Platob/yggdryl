+/// A message stating children is one leaf per child filed as an order, a
+/// quote or an execution, in nondecreasing time and stably: each starts
+/// from the message's facts and takes every fact the child states, so what
+/// a level states nothing of is the message's.
+#[test]
+fn a_message_stating_children_is_one_leaf_per_child_over_its_own_facts() {
+    let mut message = book(10);
+    message.push_child(level(30, Side::Sell, 101)).unwrap();
+    message.push_child(level(10, Side::Buy, 99)).unwrap();
+    message.push_child(level(10, Side::Buy, 98)).unwrap();
+    let mut trade = MarketMessage::new(MarketDataKind::Trade);
+    trade.set_transunix(20);
+    message.push_child(trade).unwrap();
+    assert!(message.is_market_data());
+
+    let leaves = message.into_market_data();
+    assert_eq!(leaves.len(), 3, "a trade child is passed over");
+    let read: Vec<(i64, Side, Option<Decimal>)> = leaves
+        .iter()
+        .map(|leaf| {
+            (
+                leaf.as_quote_event().unwrap().get_transunix(),
+                leaf.get_side(),
+                leaf.get_price(),
+            )
+        })
+        .collect();
+    assert_eq!(
+        read,
+        [
+            (10, Side::Buy, Some(Decimal::from_int(99))),
+            (10, Side::Buy, Some(Decimal::from_int(98))),
+            (30, Side::Sell, Some(Decimal::from_int(101))),
+        ],
+        "sorted by time, stably"
+    );
+    for leaf in &leaves {
+        assert_eq!(leaf.kind(), MarketKind::QuoteEvent);
+        assert_eq!(leaf.get_ticker(), Some("ACME"), "the message's");
+        assert_eq!(leaf.get_currency().as_str(), "USD", "the message's");
+        assert_eq!(
+            leaf.book().and_then(|control| control.action),
+            Some(MdUpdateAction::New),
+            "the child's own book control"
+        );
+    }
+}
