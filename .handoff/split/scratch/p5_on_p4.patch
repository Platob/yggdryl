+
+/// One step of the lifecycle walk over FIX messages, which a caller reaches
+/// only through the walk.
+#[cfg(feature = "internals")]
+mod internal {
+    use yggdryl::graph::{Event, Market, Operation};
+    use yggdryl::internals::fix_enrich::with_previous;
+    use yggdryl::{IdType, Scalar};
+
+    /// A session event's statements merge whole whichever follows which:
+    /// the statement sent later is the reference and the merged event keeps
+    /// the earliest `sendunix` either statement knows; sent at one instant
+    /// the later `transunix` leads, a stated wire clock leads an unstated
+    /// one whatever its instant, and an exact tie keeps the statement merged
+    /// into.
+    #[test]
+    fn one_step_merges_a_session_event_on_the_base_sent_last() {
+        let codec = super::session_codec();
+        let captured = |context: &[u8], body: &[u8], sendunix: i64, execunix: i64| {
+            super::session_observation(&codec, context, body, sendunix, execunix)
+        };
+        let older = captured(
+            b"CONTEXT-A",
+            b"8=FIX.4.4|35=D|52=20260102-10:15:30|55=AAPL|isincode=US0378331005|miccode=XNYS|10=0|",
+            100,
+            90,
+        );
+        let newer = captured(
+            b"CONTEXT-A",
+            b"8=FIX.4.4|35=D|52=20260102-10:15:30|55=MSFT|10=0|",
+            200,
+            110,
+        );
+        let directly_merged =
+            with_previous(newer.clone(), &older).expect("one session event forces a full merge");
+        assert!(directly_merged.message().get_prevuuid().is_none());
+        assert_eq!(directly_merged.get_by_tag(55), Some(Scalar::from("MSFT")));
+        assert_eq!(
+            directly_merged
+                .message()
+                .get_securityids()
+                .get(&IdType::Isin),
+            Some("US0378331005")
+        );
+        assert_eq!(directly_merged.message().get_sendunix(), Some(100));
+        assert_eq!(directly_merged.message().get_execunix(), Some(90));
+        // Either way round: the reference is the statement sent later, not
+        // the statement merged into.
+        let reversed =
+            with_previous(older.clone(), &newer).expect("one session event forces a full merge");
+        assert_eq!(reversed.get_by_tag(55), Some(Scalar::from("MSFT")));
+        assert_eq!(reversed.message().get_sendunix(), Some(100));
+
+        let early = captured(
+            b"CONTEXT-T",
+            b"8=FIX.4.4|35=D|52=20260102-10:15:30|55=AAPL|10=0|",
+            100,
+            90,
+        );
+        let late = captured(
+            b"CONTEXT-T",
+            b"8=FIX.4.4|35=D|52=20260102-10:15:31|55=MSFT|10=0|",
+            100,
+            95,
+        );
+        for (into, from) in [(&early, &late), (&late, &early)] {
+            let merged = with_previous(into.clone(), from).expect("one event");
+            assert_eq!(merged.get_by_tag(55), Some(Scalar::from("MSFT")));
+            assert_eq!(merged.message().get_sendunix(), Some(100));
+        }
+        let mut unrecorded = late.clone();
+        unrecorded.message_mut().set_sendunix(None);
+        for (into, from) in [(&early, &unrecorded), (&unrecorded, &early)] {
+            let merged = with_previous(into.clone(), from).expect("one event");
+            assert_eq!(merged.get_by_tag(55), Some(Scalar::from("AAPL")));
+            assert_eq!(merged.message().get_sendunix(), Some(100));
+        }
+        let twin = captured(
+            b"CONTEXT-T",
+            b"8=FIX.4.4|35=D|52=20260102-10:15:30|55=GOOG|10=0|",
+            100,
+            90,
+        );
+        assert_eq!(
+            twin.message().get_transunix(),
+            early.message().get_transunix()
+        );
+        for (into, from) in [(&early, &twin), (&twin, &early)] {
+            let merged = with_previous(into.clone(), from).expect("one event");
+            assert_eq!(merged.get_by_tag(55), into.get_by_tag(55));
+        }
+    }
+}
