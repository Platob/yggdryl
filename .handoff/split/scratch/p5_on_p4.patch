+            .map(Self::from_core)
+            .map_err(value_error)
+    }
+
+    /// The deterministic hash of the message: the core's own XXH3-64 over
+    /// its settled code, its root's name and arity, its entries, children,
+    /// anomalies, instrument statement, book control and acknowledgement.
+    fn stable_hash(&self) -> u64 {
+        self.inner.stable_hash()
+    }
+
+    /// Rebuild a message pickle carried: its entry root and its children's
+    /// as JSON, and its row form as the value stream.
+    #[staticmethod]
+    #[pyo3(signature = (root, child_root, row))]
+    fn _from_pickle(root: &str, child_root: Option<&str>, row: &[u8]) -> PyResult<Self> {
+        let root = CoreField::from_json(root).map_err(value_error)?;
+        let child_root = child_root
+            .map(CoreField::from_json)
+            .transpose()
+            .map_err(value_error)?;
+        let row = Scalar::decode_value_bytes(row).map_err(value_error)?;
+        CoreMarketMessage::from_scalar(Arc::new(root), child_root.map(Arc::new), &row)
+            .map(Self::from_core)
+            .map_err(value_error)
+    }
+
+    /// Carry the row form and its roots: the entry root and, where it
+    /// states children, theirs as JSON, the row as the value stream - so the
+    /// message pickle rebuilds is equal to this one.
+    fn __reduce__(&self, py: Python<'_>) -> PyResult<MessagePickle> {
+        let callable = py.get_type::<Self>().getattr("_from_pickle")?.unbind();
+        let root = (**self.inner.root())
+            .clone()
+            .into_json()
+            .map_err(value_error)?;
+        let child_root = child_root_of(&self.inner)
+            .map(|root| (*root).clone().into_json())
+            .transpose()
+            .map_err(value_error)?;
+        let row = PyBytes::new(py, &self.inner.into_scalar().into_value_bytes())
+            .into_any()
+            .unbind();
+        Ok((callable, (root, child_root, row)))
+    }
+
+    fn __eq__(&self, py: Python<'_>, other: &Bound<'_, PyAny>) -> Py<PyAny> {
+        let Ok(other) = other.extract::<PyRef<'_, Self>>() else {
+            return py.NotImplemented();
+        };
+        pyo3::types::PyBool::new(py, self.inner == other.inner)
+            .to_owned()
+            .into_any()
+            .unbind()
+    }
+
+    /// Hashes by the core's own `stable_hash`, which equal messages share.
+    fn __hash__(&self) -> isize {
+        crate::python_hash(self.inner.stable_hash())
+    }
+
+    fn __copy__(&self) -> Self {
+        self.clone()
+    }
+
+    fn __deepcopy__(&self, _memo: &Bound<'_, PyAny>) -> Self {
+        self.clone()
+    }
+
+    fn __repr__(&self) -> String {
+        format!(
+            "MarketMessage({}, transunix={}, marketdatakind={}, crosscode={:?}, entries={}, children={})",
+            Element::get_uuid(&self.inner),
+            Event::get_transunix(&self.inner),
+            Market::marketdatakind(&self.inner),
+            Element::get_crosscode(&self.inner),
+            self.inner.root().fields().len(),
+            self.inner.children().len(),
+        )
+    }
+});
