+/// A book message's entries are its children, each a market message of its
+/// own: what a `W` with more entries costs to move out of its handle grows
+/// by the same count per entry - the child's facts box, its record under
+/// the group's one shared root - and its leaves cost what its children
+/// state, nothing more.
+#[test]
+fn a_book_messages_children_cost_the_same_per_entry() {
+    let codec = FixCodec::new(Arc::new(committed_registry().clone())).with_threads(1);
+    let line = |entries: usize| {
+        let mut line = format!("8=FIX.4.4|35=W|52=20260921-10:00:00|55=AAPL|268={entries}|");
+        for entry in 0..entries {
+            line.push_str(&format!("269={}|270={}|271=5|", entry % 2, 100 + entry));
+        }
+        line.push_str("10=0|");
+        line.into_bytes()
+    };
+    let moved = |entries: usize| {
+        let message = codec
+            .parse_fix_line(&line(entries))
+            .expect("a book message");
+        let (allocations, message) = counted(|| message.into_message());
+        assert_eq!(message.children().len(), entries);
+        let (split, leaves) = counted(|| message.into_market_data());
+        assert_eq!(leaves.len(), entries, "one leaf per child");
+        (allocations, split)
+    };
+    let measured = [moved(1), moved(2), moved(4), moved(8)];
+    eprintln!("a W's children, moved out and split, at 1, 2, 4 and 8 entries: {measured:?}");
+    let per_child = measured[1].0 - measured[0].0;
+    assert_eq!(
+        measured[2].0 - measured[1].0,
+        2 * per_child,
+        "linear in the entries"
+    );
+    assert_eq!(
+        measured[3].0 - measured[2].0,
+        4 * per_child,
+        "linear in the entries"
+    );
+    let per_leaf = measured[1].1 - measured[0].1;
+    assert_eq!(
+        measured[3].1 - measured[2].1,
+        4 * per_leaf,
+        "linear in the leaves"
+    );
+}
