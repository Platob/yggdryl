+/// The FIX handle lets go of its market message by moving it: an order or
+/// a quote every field of which a typed column reads moves its facts, its
+/// record and its anomalies out of `FixMsg::into_message` without one
+/// allocation, and the market message moves into `MarketData` the same way.
+#[test]
+fn a_fix_message_moves_into_its_market_message_without_allocating() {
+    let codec = FixCodec::new(Arc::new(fix_registry(0)));
+    for wire in [b"35=D|55=AAPL|".as_slice(), b"35=S|55=AAPL|"] {
+        let message = codec.parse_line(wire).unwrap().next().unwrap().unwrap();
+        let (allocations, moved) = counted(|| message.into_message());
+        assert_eq!(moved.get_ticker(), Some("AAPL"));
+        assert_eq!(allocations, 0, "the message moves out of its handle");
+        let (allocations, held) = counted(|| MarketData::from(moved));
+        assert_eq!(
+            held.marketdatakind(),
+            held.as_message().unwrap().marketdatakind()
+        );
+        assert_eq!(allocations, 0, "and into the value that holds it whole");
+    }
+}
+
+/// A market message no codec built is the one leaf of its category by
+/// moving its facts: `into_market_leaf` of an order or a quote allocates
+/// nothing, whatever entries it states beside its facts.
+#[test]
+fn a_market_message_moves_into_its_one_leaf_without_allocating() {
+    use yggdryl::graph::MarketMessage;
+
+    let root = Arc::new(
+        StructType::from_fields([DataType::utf8().nullable_field("venue")])
+            .map(DataType::from)
+            .expect("one entry")
+            .required_field("entries"),
+    );
+    for kind in [
+        yggdryl::MarketDataKind::Order,
+        yggdryl::MarketDataKind::Quotation,
+    ] {
+        let mut message = MarketMessage::new(kind)
+            .try_with_entries(
+                Arc::clone(&root),
+                Scalar::from_sequence([Scalar::from("XAMS")]),
+            )
+            .expect("an entry the root takes");
+        message.set_transunix(1_700_000_000_000_000_000);
+        message.set_crosscode("M-1".to_owned());
+        message.set_ticker(Some(SmolStr::new("AAPL")), true);
+        message.finalize();
+        let (allocations, leaf) = counted(|| message.into_market_leaf().unwrap());
+        assert_eq!(leaf.get_ticker(), Some("AAPL"));
+        assert_eq!(allocations, 0, "a direct leaf moves the message's facts");
+    }
+}
+
+/// The way back adopts the codec's own record as it is: `FixMsg::from_message`
+/// over a message a parse moved out parses no text and rebuilds its indexes
+/// alone - the tag positions over the record's children, the header and the
+/// capture caches - so it costs the same whatever the record holds, and
+/// less than reading the line it came from.
+#[test]
+fn a_market_message_adopted_back_rebuilds_its_indexes_alone() {
+    let registry = Arc::new(fix_registry(64));
+    let codec = FixCodec::new(Arc::clone(&registry));
+    let adopted = |line: &[u8]| {
+        let message = codec
+            .parse_fix_line(line)
+            .expect("a readable line")
+            .into_message();
+        let (allocations, back) =
+            counted(|| FixMsg::from_message(Arc::clone(&registry), message).unwrap());
+        assert_eq!(
+            back.message().marketdatakind(),
+            yggdryl::MarketDataKind::Order
+        );
+        allocations
+    };
+    let parsed = |line: &[u8]| counted(|| codec.parse_fix_line(line).expect("a readable line")).0;
+    let (narrow, wide) = (fix_pairs_line(4), fix_pairs_line(64));
+    let at = [adopted(&narrow[..]), adopted(&wide[..])];
+    eprintln!(
+        "from_message over the codec's own record: {} allocations at 4 pairs, {} at 64",
+        at[0], at[1]
+    );
+    assert_eq!(at[0], at[1], "the indexes, whatever the record holds");
+    assert!(
+        at[0] < parsed(&narrow[..]),
+        "fewer than reading the line: {} against {}",
+        at[0],
+        parsed(&narrow[..])
+    );
+}
